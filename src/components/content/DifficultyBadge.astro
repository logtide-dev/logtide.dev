---
interface Props {
  difficulty: 'easy' | 'medium' | 'advanced';
}

const { difficulty } = Astro.props;

// Pill tones follow the app's SeverityBadge.
const config = {
  easy: { label: 'Easy', badge: 'border-success/30 bg-success/15 text-success-text', dot: 'bg-success' },
  medium: { label: 'Medium', badge: 'border-warning/30 bg-warning/15 text-warning-text', dot: 'bg-warning' },
  advanced: { label: 'Advanced', badge: 'border-destructive/30 bg-destructive/15 text-destructive-text', dot: 'bg-destructive' },
};

const { label, badge, dot } = config[difficulty];
---

<span class={`inline-flex items-center gap-1.5 rounded-full border px-2 py-px text-[11.5px] font-medium ${badge}`}>
  <span class={`h-1.5 w-1.5 rounded-full ${dot}`} aria-hidden="true"></span>
  {label}
</span>
