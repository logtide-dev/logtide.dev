---
import { getCollection } from 'astro:content';
import DifficultyBadge from './DifficultyBadge.astro';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  type: 'use-cases' | 'integrations';
  currentSlug: string;
  currentCategory?: string;
  limit?: number;
}

const { type, currentSlug, currentCategory, limit = 3 } = Astro.props;

const collection = await getCollection(type, ({ data }) => !data.draft);

// Filter out current entry and prioritize same category
const otherEntries = collection
  .filter((entry) => entry.id !== currentSlug)
  .sort((a, b) => {
    // Prioritize same category
    const aMatch = currentCategory && a.data.category === currentCategory ? 1 : 0;
    const bMatch = currentCategory && b.data.category === currentCategory ? 1 : 0;
    if (aMatch !== bMatch) return bMatch - aMatch;
    // Then sort alphabetically
    return a.data.title.localeCompare(b.data.title);
  })
  .slice(0, limit);

const sectionTitle = type === 'use-cases' ? 'More Use Cases' : 'More Integrations';
const sectionUrl = type === 'use-cases' ? '/use-cases/' : '/integrations/';
const urlPrefix = type === 'use-cases' ? '/use-cases' : '/integrations';
---

{otherEntries.length > 0 && (
  <aside class="more-from-section mt-14 border-t border-foreground/[0.08] pt-8">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2 class="!mt-0 !border-0 !pt-0 text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-bold leading-[1.1] tracking-[-0.025em]">{sectionTitle}</h2>
      <a href={sectionUrl} class="text-sm font-medium text-primary-readable hover:underline">View all →</a>
    </div>

    <div class="grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid md:grid-cols-3">
      {otherEntries.map((entry) => (
        <a href={`${urlPrefix}/${entry.id}/`} class="group block bg-background p-6 transition-colors hover:bg-card">
          <div class="flex flex-wrap items-center gap-2">
            <CategoryBadge
              category={entry.data.category}
              type={type === 'use-cases' ? 'use-case' : 'integration'}
            />
            <DifficultyBadge difficulty={entry.data.difficulty} />
          </div>
          <h3 class="!mb-0 !mt-3 !text-base font-semibold group-hover:text-primary-readable">{entry.data.title}</h3>
          <p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">{entry.data.description}</p>
        </a>
      ))}
    </div>
  </aside>
)}
