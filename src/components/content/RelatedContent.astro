---
import { getCollection } from 'astro:content';
import DifficultyBadge from './DifficultyBadge.astro';

interface Props {
  integrations?: string[];
  useCases?: string[];
  comparisons?: string[];
  title?: string;
}

const { integrations = [], useCases = [], comparisons = [], title = 'Related Guides' } = Astro.props;

// Fetch related integration entries with validation
const allIntegrations = await getCollection('integrations');
const relatedIntegrations = integrations
  .map((slug) => {
    const entry = allIntegrations.find((e) => e.id === slug);
    if (!entry && import.meta.env.DEV) {
      console.warn(`[RelatedContent] Integration not found: "${slug}"`);
    }
    return entry;
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry !== undefined);

// Fetch related use case entries with validation
const allUseCases = await getCollection('use-cases');
const relatedUseCases = useCases
  .map((slug) => {
    const entry = allUseCases.find((e) => e.id === slug);
    if (!entry && import.meta.env.DEV) {
      console.warn(`[RelatedContent] Use case not found: "${slug}"`);
    }
    return entry;
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry !== undefined);

// Fetch related comparison entries with validation
const allComparisons = await getCollection('comparisons');
const relatedComparisons = comparisons
  .map((slug) => {
    const entry = allComparisons.find((e) => e.id === slug);
    if (!entry && import.meta.env.DEV) {
      console.warn(`[RelatedContent] Comparison not found: "${slug}"`);
    }
    return entry;
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry !== undefined);

const hasRelatedContent =
  relatedIntegrations.length > 0 || relatedUseCases.length > 0 || relatedComparisons.length > 0;
---

{hasRelatedContent && (
  <aside class="related-content mt-14 border-t border-foreground/[0.08] pt-8">
    <h2 class="!mb-6 !mt-0 !border-0 !pt-0 text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-bold leading-[1.1] tracking-[-0.025em]">{title}</h2>

    <div class="grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid md:grid-cols-2">
      {relatedIntegrations.map((entry) => (
        <a href={`/integrations/${entry.id}/`} class="group block bg-background p-6 transition-colors hover:bg-card">
          <div class="flex items-center justify-between gap-3">
            <p class="font-mono text-xs text-muted-foreground">integration</p>
            <DifficultyBadge difficulty={entry.data.difficulty} />
          </div>
          <h3 class="!mb-0 !mt-3 !text-base font-semibold group-hover:text-primary-readable">{entry.data.title}</h3>
          <p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">{entry.data.description}</p>
        </a>
      ))}

      {relatedUseCases.map((entry) => (
        <a href={`/use-cases/${entry.id}/`} class="group block bg-background p-6 transition-colors hover:bg-card">
          <div class="flex items-center justify-between gap-3">
            <p class="font-mono text-xs text-muted-foreground">use case</p>
            <DifficultyBadge difficulty={entry.data.difficulty} />
          </div>
          <h3 class="!mb-0 !mt-3 !text-base font-semibold group-hover:text-primary-readable">{entry.data.title}</h3>
          <p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">{entry.data.description}</p>
        </a>
      ))}

      {relatedComparisons.map((entry) => (
        <a href={`/vs/${entry.id}/`} class="group block bg-background p-6 transition-colors hover:bg-card">
          <p class="font-mono text-xs text-muted-foreground">compare</p>
          <h3 class="!mb-0 !mt-3 !text-base font-semibold group-hover:text-primary-readable">{entry.data.title}</h3>
          <p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">{entry.data.description}</p>
        </a>
      ))}
    </div>
  </aside>
)}
