---
import { Icon } from 'astro-icon/components';

interface Props {
  faqs?: Array<{ question: string; answer: string }>;
  title?: string;
}

const { faqs = [], title = 'Frequently Asked Questions' } = Astro.props;
---

{faqs.length > 0 && (
  <section class="mt-14 border-t border-foreground/[0.08] pt-8" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="!mb-6 !mt-0 !border-0 !pt-0 text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-bold leading-[1.1] tracking-[-0.025em]">{title}</h2>
    <div class="overflow-hidden rounded-2xl border border-foreground/[0.08]">
      {faqs.map((faq) => (
        <details class="group border-t border-foreground/[0.08] bg-background px-5 py-4 first:border-t-0 open:bg-card">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-foreground">
            <span>{faq.question}</span>
            <Icon
              name="lucide:chevron-down"
              class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
            />
          </summary>
          <p class="mt-3 leading-7 text-muted-foreground">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
