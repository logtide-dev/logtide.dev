---
import { Icon } from 'astro-icon/components';

interface Props {
  faqs?: Array<{ question: string; answer: string }>;
  title?: string;
}

const { faqs = [], title = 'Frequently Asked Questions' } = Astro.props;
---

{faqs.length > 0 && (
  <section class="mt-16 pt-8 border-t border-border" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-2xl font-semibold mb-6">{title}</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group rounded-lg border border-border bg-card px-5 py-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-medium text-foreground list-none">
            <span>{faq.question}</span>
            <Icon
              name="lucide:chevron-down"
              class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
            />
          </summary>
          <p class="mt-3 leading-7 text-muted-foreground">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
