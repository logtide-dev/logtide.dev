---
interface Props {
  category: string;
  type?: 'integration' | 'use-case';
}

const { category, type = 'integration' } = Astro.props;

const integrationLabels: Record<string, string> = {
  'web-server': 'Web Server',
  'database': 'Database',
  'framework': 'Framework',
  'container': 'Container',
  'language': 'Language',
  'infrastructure': 'Infrastructure',
};

const useCaseLabels: Record<string, string> = {
  'compliance': 'Compliance',
  'performance': 'Performance',
  'security': 'Security',
  'cost': 'Cost Optimization',
  'operations': 'Operations',
};

const labels = type === 'integration' ? integrationLabels : useCaseLabels;
const label = labels[category] || category;
---

<span class="inline-flex items-center gap-1.5 rounded-full border border-primary-readable/35 bg-nav-active px-2 py-px text-[11.5px] font-medium text-nav-active-foreground">
  <span class="h-1.5 w-1.5 rounded-full bg-primary-readable" aria-hidden="true"></span>
  {label}
</span>
