---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/docs/', label: 'Docs' },
  { href: '/integrations/', label: 'Integrations' },
  { href: '/use-cases/', label: 'Use Cases' },
  { href: '/vs/', label: 'Comparisons' },
  { href: '/blog/', label: 'Blog' },
  { href: '/changelog/', label: 'Changelog' },
  { href: 'https://github.com/logtide-dev/logtide', label: 'GitHub', external: true },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-card/50 backdrop-blur-sm">
  <div class="header-container flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <img src="/logo/white.svg" alt="LogTide" class="hidden h-8 w-auto dark:block" width="120" height="32" />
      <img src="/logo/dark.svg" alt="LogTide" class="block h-8 w-auto dark:hidden" width="120" height="32" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="flex items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          aria-label={link.external ? `${link.label} (opens in new tab)` : undefined}
        >
          {link.external && (
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          )}
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href="https://app.logtide.dev/login"
        class="hidden text-sm text-muted-foreground transition-colors hover:text-foreground sm:block"
      >
        Login
      </a>
      <a
        href="https://app.logtide.dev/register"
        class="hidden items-center gap-1 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-600 sm:inline-flex"
      >
        Get Started
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="hamburger-icon h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="close-icon hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-border bg-card/95 backdrop-blur-sm md:hidden"
    aria-label="Mobile navigation"
  >
    <div class="header-container flex flex-col gap-1 py-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="flex items-center gap-2 rounded-lg px-4 py-3 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.external && (
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          )}
          {link.label}
        </a>
      ))}
      <div class="mt-2 flex flex-col gap-2 border-t border-border pt-4">
        <a
          href="https://app.logtide.dev/login"
          class="rounded-lg px-4 py-3 text-center text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          Login
        </a>
        <a
          href="https://app.logtide.dev/register"
          class="mx-4 rounded-lg bg-primary py-3 text-center text-sm font-medium text-white transition-colors hover:bg-primary-600"
        >
          Get Started
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const hamburger = btn?.querySelector('.hamburger-icon');
    const close = btn?.querySelector('.close-icon');

    if (!btn || !menu || !hamburger || !close) return;

    btn.addEventListener('click', () => {
      const isOpen = menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !isOpen);
      hamburger.classList.toggle('hidden', isOpen);
      close.classList.toggle('hidden', !isOpen);
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>

