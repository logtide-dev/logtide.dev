---
import ThemeToggle from './ThemeToggle.astro';
import GitHubIcon from './ui/GitHubIcon.astro';

const navLinks = [
  { href: '/docs/', label: 'Docs' },
  { href: '/integrations/', label: 'Integrations' },
  { href: '/use-cases/', label: 'Use Cases' },
  { href: '/vs/', label: 'Comparisons' },
  { href: '/blog/', label: 'Blog' },
  { href: '/changelog/', label: 'Changelog' },
  { href: 'https://github.com/logtide-dev/logtide', label: 'GitHub', external: true },
];

const path = Astro.url.pathname;
const isActive = (href: string) => !href.startsWith('http') && path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-md">
  <div class="header-container flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center gap-2 rounded-lg" aria-label="LogTide home">
      <img src="/logo/white.svg" alt="LogTide" class="hidden h-8 w-auto dark:block" width="120" height="32" />
      <img src="/logo/dark.svg" alt="LogTide" class="block h-8 w-auto dark:hidden" width="120" height="32" />
    </a>

    <!-- Desktop nav. Shown from xl so seven labels never wrap to a second row. -->
    <nav class="hidden items-center gap-6 xl:flex" aria-label="Main">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'flex items-center gap-1.5 whitespace-nowrap text-sm transition-colors hover:text-foreground',
            isActive(link.href) ? 'font-medium text-foreground' : 'text-muted-foreground',
          ]}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          aria-current={isActive(link.href) ? 'page' : undefined}
          aria-label={link.external ? `${link.label} (opens in new tab)` : undefined}
        >
          {link.external && <GitHubIcon />}
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <ThemeToggle />
      <a
        href="https://app.logtide.dev/login"
        class="hidden rounded-lg text-sm text-muted-foreground transition-colors hover:text-foreground sm:block"
      >
        Login
      </a>
      <a
        href="https://app.logtide.dev/register"
        class="hidden items-center gap-1.5 whitespace-nowrap rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-600 sm:inline-flex"
      >
        Start for free
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <button
        id="mobile-menu-btn"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground xl:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="hamburger-icon h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="close-icon hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-border bg-background/95 backdrop-blur-md xl:hidden"
    aria-label="Mobile navigation"
  >
    <div class="header-container flex flex-col gap-1 py-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'flex items-center gap-2 rounded-lg px-4 py-3 text-sm transition-colors hover:bg-muted hover:text-foreground',
            isActive(link.href) ? 'bg-muted font-medium text-foreground' : 'text-muted-foreground',
          ]}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.external && <GitHubIcon />}
          {link.label}
        </a>
      ))}
      <div class="mt-2 flex flex-col gap-2 border-t border-border pt-4">
        <a
          href="https://app.logtide.dev/login"
          class="rounded-lg px-4 py-3 text-center text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          Login
        </a>
        <a
          href="https://app.logtide.dev/register"
          class="mx-4 rounded-lg bg-primary py-3 text-center text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-600"
        >
          Start for free
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const hamburger = btn?.querySelector('.hamburger-icon');
    const close = btn?.querySelector('.close-icon');

    if (!btn || !menu || !hamburger || !close) return;

    btn.addEventListener('click', () => {
      const isOpen = menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !isOpen);
      hamburger.classList.toggle('hidden', isOpen);
      close.classList.toggle('hidden', !isOpen);
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      btn.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
