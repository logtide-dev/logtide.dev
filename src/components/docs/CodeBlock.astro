---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: string;
  title?: string;
}

const { code, lang = 'text', title } = Astro.props;
---

<div class="code-block-wrapper group relative my-4 rounded-lg border border-border bg-card overflow-hidden">
  <div class="flex items-center justify-between border-b border-border bg-muted/50 px-4 py-2.5">
    <div class="flex items-center gap-3">
        <!-- Mac-like window dots matching the script in Docs.astro -->
        <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-red-500/20 border border-red-500/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/20 border border-yellow-500/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-500/20 border border-green-500/50"></div>
        </div>
        <span class="text-xs font-mono text-muted-foreground uppercase">{title || lang}</span>
    </div>
    
    <button
      class="copy-btn opacity-60 hover:opacity-100 transition-opacity p-1"
      aria-label="Copy code"
      data-code={code}
    >
      <svg class="copy-icon h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
      <svg class="check-icon h-4 w-4 text-green-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
    </button>
  </div>

  <div class="code-content overflow-x-auto bg-secondary">
    <Code code={code} lang={lang as any} themes={{ light: 'github-light', dark: 'one-dark-pro' }} />
  </div>
</div>

<script>
  // Handle copy button clicks for manually used CodeBlock components
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      if (!code) return;

      await navigator.clipboard.writeText(code);
      
      const copyIcon = btn.querySelector('.copy-icon');
      const checkIcon = btn.querySelector('.check-icon');
      
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 2000);
    });
  });
</script>

<style>
  /* Override Shiki's default pre margin/padding/bg to fit our wrapper */
  .code-content :global(pre) {
    margin: 0 !important;
    padding: 1rem !important;
    border-radius: 0 !important;
    background-color: transparent !important; /* Use wrapper's bg */
    border: none !important;
  }
</style>