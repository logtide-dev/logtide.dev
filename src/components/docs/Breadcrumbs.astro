---
const pathname = Astro.url.pathname;

function getBreadcrumbs(path: string) {
  const segments = path.split("/").filter(Boolean);
  if (segments[0] === 'docs') segments.shift();

  const crumbs = [{ label: "Docs", href: "/docs" }];

  let currentPath = "/docs";
  for (let i = 0; i < segments.length; i++) {
    const segment = segments[i];
    currentPath += "/" + segment;

    const label = segment
      .split("-")
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");

    if (i === segments.length - 1) {
      crumbs.push({ label, href: '' });
    } else {
      crumbs.push({ label, href: currentPath });
    }
  }
  return crumbs;
}

const breadcrumbs = getBreadcrumbs(pathname);
---

<nav class="flex items-center gap-2 text-sm text-muted-foreground mb-6">
  {breadcrumbs.map((crumb, i) => (
    <>
      {i > 0 && (
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      )}

      {crumb.href ? (
        <a
          href={crumb.href}
          class="hover:text-foreground transition-colors"
        >
          {crumb.label}
        </a>
      ) : (
        <span class="text-foreground font-medium">{crumb.label}</span>
      )}
    </>
  ))}
</nav>
