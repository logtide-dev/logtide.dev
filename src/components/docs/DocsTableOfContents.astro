---
interface Props {
  headings?: { id: string; text: string; level: number }[];
}

const { headings = [] } = Astro.props;
---

{headings.length > 0 && (
  <nav class="docs-toc">
    <div class="toc-content">
      <h4 class="toc-header">ON THIS PAGE</h4>

      <ul class="toc-list">
        {headings.map((heading) => (
          <li class:list={['toc-item', { 'toc-item-h3': heading.level === 3 }]}>
            <a
              href={`#${heading.id}`}
              class="toc-link"
              data-heading-id={heading.id}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script>
  // Active heading tracking. An IntersectionObserver fires only when a heading
  // crosses the reading line, instead of running on every scroll frame.
  function initToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    if (!links.length) return;

    const headings = links
      .map((link) => document.getElementById(link.dataset.headingId ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    function setActive(id: string) {
      links.forEach((link) => link.classList.toggle('active', link.dataset.headingId === id));
    }

    function pickActive() {
      let current = headings[0]?.id ?? '';
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= 120) current = h.id;
        else break;
      }
      setActive(current);
    }

    const observer = new IntersectionObserver(pickActive, {
      rootMargin: '-110px 0px -60% 0px',
      threshold: [0, 1],
    });
    headings.forEach((h) => observer.observe(h));
    pickActive();

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const id = link.dataset.headingId;
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', `#${id}`);
        setActive(id!);
      });
    });
  }

  initToc();
  document.addEventListener('astro:after-swap', initToc);
</script>

<style>
  .docs-toc {
    width: 240px;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    overflow-x: hidden;
    background: hsl(var(--background));
    border-left: 1px solid hsl(var(--border));
  }

  .toc-content {
    padding: 1.5rem 1rem;
  }

  .toc-header {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: hsl(var(--muted-foreground));
    margin-bottom: 1rem;
    padding-left: 0.5rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc-item {
    position: relative;
  }

  .toc-item-h3 {
    padding-left: 0.75rem;
  }

  .toc-link {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.375rem 0.5rem;
    padding-left: 0.75rem;
    font-size: 0.813rem;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: all 0.2s;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
  }

  .toc-link:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--muted) / 0.5);
  }

  .toc-link.active {
    color: hsl(var(--foreground));
    font-weight: 500;
    border-left-color: hsl(var(--primary));
    background: transparent;
  }

  /* Scrollbar styling */
  .docs-toc::-webkit-scrollbar {
    width: 6px;
  }

  .docs-toc::-webkit-scrollbar-track {
    background: transparent;
  }

  .docs-toc::-webkit-scrollbar-thumb {
    background: hsl(var(--muted-foreground) / 0.2);
    border-radius: 3px;
  }

  .docs-toc::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--muted-foreground) / 0.3);
  }

  @media (max-width: 1280px) {
    .docs-toc {
      display: none;
    }
  }
</style>
