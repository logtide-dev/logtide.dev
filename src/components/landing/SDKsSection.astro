---
import { Icon } from 'astro-icon/components';

const sdks = [
  { name: 'Node.js', href: '/docs/sdks/nodejs/', icon: '/icons/sdks/nodejs-original.svg', install: '@logtide/core' },
  { name: 'Browser', href: '/docs/sdks/browser/', icon: '/icons/sdks/javascript-original.svg', install: '@logtide/browser' },
  { name: 'Python', href: '/docs/sdks/python/', icon: '/icons/sdks/python-original.svg', install: 'pip install' },
  { name: 'Go', href: '/docs/sdks/go/', icon: '/icons/sdks/go-original-wordmark.svg', install: 'go get' },
  { name: 'PHP', href: '/docs/sdks/php/', icon: '/icons/sdks/php-original.svg', install: 'composer' },
  { name: 'Kotlin', href: '/docs/sdks/kotlin/', icon: '/icons/sdks/kotlin-original.svg', install: 'gradle' },
  { name: 'Ruby', href: '/docs/sdks/ruby/', icon: '/icons/sdks/ruby-original.svg', install: 'gem install' },
  { name: 'OpenTelemetry', href: '/docs/opentelemetry/', icon: null, install: 'OTLP native' },
];
---

<section class="border-t border-border px-6 py-24" aria-labelledby="sdks-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl" data-reveal>
      <h2 id="sdks-heading" class="text-section font-bold">Works with your stack</h2>
      <p class="mt-4 text-lg text-muted-foreground">
        Native SDKs with retry logic and circuit breakers. Or use OpenTelemetry.
      </p>
    </div>

    <!-- Eight items, eight cells: a 4-column grid with no orphan tile. Hairlines
         come from the container border so adjacent cells share one line. -->
    <div
      class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-4"
      data-reveal
    >
      {sdks.map((sdk) => (
        <a
          href={sdk.href}
          class="group flex flex-col items-start gap-3 bg-card p-6 transition-colors hover:bg-muted"
        >
          {sdk.icon ? (
            <img src={sdk.icon} alt="" class="h-9 w-9" loading="lazy" width="36" height="36" />
          ) : (
            <Icon name="lucide:radio-tower" class="h-9 w-9 text-primary-readable" aria-hidden="true" />
          )}
          <span class="font-medium transition-colors group-hover:text-primary-readable">{sdk.name}</span>
          <span class="font-mono text-xs text-muted-foreground">{sdk.install}</span>
        </a>
      ))}
    </div>
  </div>
</section>
