---
// Twelve cells so the 2/3/4-column grids never leave an orphan tile. Every
// tile links to a real docs page.
const stack = [
  { name: 'Node.js', href: '/docs/sdks/nodejs/', hint: '@logtide/core' },
  { name: 'Browser', href: '/docs/sdks/browser/', hint: '@logtide/browser' },
  { name: 'Python', href: '/docs/sdks/python/', hint: 'pip install' },
  { name: 'Go', href: '/docs/sdks/go/', hint: 'go get' },
  { name: 'Ruby', href: '/docs/sdks/ruby/', hint: 'gem install' },
  { name: 'PHP', href: '/docs/sdks/php/', hint: 'composer' },
  { name: 'Java / Kotlin', href: '/docs/sdks/kotlin/', hint: 'gradle' },
  { name: '.NET', href: '/docs/sdks/csharp/', hint: 'dotnet add' },
  { name: 'OpenTelemetry', href: '/docs/opentelemetry/', hint: 'OTLP native' },
  { name: 'Vector', href: '/docs/vector/', hint: 'sink config' },
  { name: 'Syslog', href: '/docs/syslog/', hint: 'rsyslog' },
  { name: 'HTTP API', href: '/docs/no-sdk-setup/', hint: 'plain cURL' },
];
---

<section class="mx-auto max-w-[77.5rem] px-4 pt-24 sm:px-6 md:pt-40 lg:px-10" aria-labelledby="sdks-heading">
  <div class="flex flex-wrap items-center gap-x-16 gap-y-10">
    <div class="min-w-0 flex-[1_1_20rem]" data-reveal>
      <p class="font-mono text-xs text-primary-readable">works with your stack</p>
      <h2 id="sdks-heading" class="mt-3.5 text-[clamp(2.125rem,1.5rem+2vw,3.25rem)] font-bold">
        Connect anything in one copy-paste.
      </h2>
      <p class="mt-4 max-w-[44ch] text-muted-foreground">
        Onboarding builds ready-to-copy setup from your real API address, then waits for the first
        log, trace or error to arrive.
      </p>
    </div>

    <div
      class="spotlight elevate grid min-w-0 flex-[1.6_1_32rem] grid-cols-2 gap-px overflow-hidden rounded-[14px] border border-foreground/[0.08] bg-foreground/[0.08] sm:grid-cols-3 lg:grid-cols-4"
      data-reveal
      style="--reveal-delay: 90ms"
    >
      {stack.map((item, i) => (
        <a
          href={item.href}
          class="group relative flex flex-col gap-1.5 bg-card px-5 py-6 transition-colors hover:bg-muted/60 dark:bg-background dark:hover:bg-card"
        >
          <span class="fade-up font-medium transition-colors group-hover:text-primary-readable" style={`--i: ${i * 3}`}>{item.name}</span>
          <span class="fade-up font-mono text-xs text-muted-foreground" style={`--i: ${i * 3 + 2}`}>{item.hint}</span>
          <span
            class="absolute right-4 top-6 -translate-x-1 text-primary-readable opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
            aria-hidden="true"
          >→</span>
        </a>
      ))}
    </div>
  </div>
</section>
