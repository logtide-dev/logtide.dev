---
import GitHubIcon from '../ui/GitHubIcon.astro';
---

<section class="border-t border-border px-6 py-24" aria-labelledby="cta-heading">
  <div class="mx-auto max-w-6xl">
    <div class="rounded-xl border border-border bg-card px-8 py-16 text-center md:px-16 md:py-20" data-reveal>
      <h2 id="cta-heading" class="mx-auto max-w-3xl text-section font-bold">Ready to own your logs?</h2>
      <p class="mx-auto mt-5 max-w-prose text-lg text-muted-foreground">
        Start with the free cloud or deploy on your own infrastructure. No vendor lock-in. Export anytime.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="https://app.logtide.dev/register"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-primary px-7 py-3.5 text-base font-medium text-primary-foreground transition-all hover:bg-primary-600 active:translate-y-px"
        >
          Start for free
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="https://github.com/logtide-dev/logtide"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-border bg-background px-7 py-3.5 text-base font-medium text-foreground transition-all hover:bg-muted active:translate-y-px"
          aria-label="Star LogTide on GitHub (opens in new tab)"
        >
          <GitHubIcon class="h-5 w-5" />
          Star on GitHub
        </a>
      </div>
    </div>
  </div>
</section>
