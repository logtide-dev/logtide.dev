---
import GitHubIcon from '../ui/GitHubIcon.astro';
---

<section class="relative mt-28 border-t border-foreground/[0.08] md:mt-48" aria-labelledby="cta-heading">
  <!-- The clip keeps the drifting glow inside the section; the gradient is
       centred above the bottom edge so it fades out before the footer. -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-60 dark:opacity-100" aria-hidden="true">
    <div class="glow-drift absolute inset-0 bg-[radial-gradient(50%_60%_at_50%_75%,hsl(var(--primary)/0.22),transparent_70%)]"></div>
  </div>
  <div class="relative mx-auto flex max-w-[77.5rem] flex-col items-center gap-7 px-4 py-24 text-center sm:px-6 md:py-40 lg:px-10" data-reveal>
    <h2 id="cta-heading" class="text-[clamp(3.5rem,2rem+6vw,8.5rem)] font-bold leading-[0.9] tracking-[-0.035em]">
      Own your logs.
    </h2>
    <p class="max-w-[48ch] text-lg text-muted-foreground">
      Start on the free EU cloud plan or deploy on your own infrastructure. Export anytime.
    </p>
    <div class="flex flex-wrap justify-center gap-2.5">
      <a
        href="https://app.logtide.dev/register"
        class="btn-primary inline-flex h-[50px] items-center rounded-[10px] bg-primary px-6 font-medium text-primary-foreground"
      >
        Start free on EU cloud
      </a>
      <a
        href="https://github.com/logtide-dev/logtide"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost inline-flex h-[50px] items-center gap-2 rounded-[10px] border border-foreground/15 px-5 font-medium"
        aria-label="Star LogTide on GitHub (opens in new tab)"
      >
        <GitHubIcon class="h-5 w-5" />
        Star on GitHub
      </a>
    </div>
  </div>
</section>
