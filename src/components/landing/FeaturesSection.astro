---
// Bento of five capabilities in one shared-border grid. Wide and narrow cells
// alternate (flex-basis 620px vs 380px) so rows are uneven on desktop and
// everything stacks on a phone. Each cell has a small interaction (script at
// the bottom); the server markup is the final state, so it reads without JS.

const queries = [
  { q: 'service:api -level:debug', d: 'field filter + exclusion' },
  { q: 'level:(error OR critical)', d: 'OR inside a field' },
  { q: '"payment declined" env:prod', d: 'exact phrase' },
  { q: 'user.id:* path:*admin*', d: 'nested keys, wildcards' },
  { q: '185.220.101.4', d: 'pasted IPs stay plain text' },
];

const spans = [
  { name: 'POST /checkout', left: 0, width: 100, ms: 412, cls: 'bg-primary' },
  { name: 'auth.verify', left: 2, width: 14, ms: 58, cls: 'bg-info' },
  { name: 'cart.load', left: 16, width: 22, ms: 91, cls: 'bg-info' },
  { name: 'payment.charge', left: 40, width: 56, ms: 231, cls: 'bg-destructive' },
  { name: 'db.query', left: 44, width: 48, ms: 198, cls: 'bg-destructive/60' },
];

const monitors = [
  { type: 'HTTP', name: 'api.solture.it/health', meta: '200 · 142ms', ok: true },
  { type: 'SSL', name: 'solture.it certificate', meta: '41 days left', ok: true },
  { type: 'DNS', name: 'MX solture.it', meta: 'mismatch', ok: false },
];

const uptime = Array.from({ length: 90 }, (_, i) => {
  const daysAgo = 89 - i;
  const when = daysAgo === 0 ? 'today' : daysAgo === 1 ? 'yesterday' : `${daysAgo} days ago`;
  if (i === 61) return { cls: 'bg-destructive', note: `${when} · outage, 14 min` };
  if (i === 23 || i === 77) return { cls: 'bg-warning', note: `${when} · degraded` };
  return { cls: 'bg-success/75', note: `${when} · operational` };
});

// Values match the STORAGE_ENGINE variable in docs/storage-engines.
const engines = [
  { name: 'TimescaleDB', value: 'timescale', note: 'Postgres you already run' },
  { name: 'ClickHouse', value: 'clickhouse', note: 'Columnar, for high volume' },
  { name: 'MongoDB', value: 'mongodb', note: 'If it is already your store' },
];

const label = 'font-mono text-xs text-primary-readable';
const title = 'mt-2.5 text-[22px] font-semibold leading-snug tracking-[-0.015em]';
const panel = 'rounded-[10px] border border-border bg-muted/60 dark:bg-card';
---

<!-- In the light theme the section is a full-bleed tinted band; in the dark
     theme it keeps the plain spacing (dark:py-0). -->
<section class="band mt-24 md:mt-40" aria-labelledby="features-heading">
<div class="mx-auto max-w-[77.5rem] px-4 py-20 sm:px-6 md:py-28 lg:px-10 dark:py-0">
  <div class="flex flex-wrap items-end justify-between gap-x-16 gap-y-5" data-reveal>
    <h2 id="features-heading" class="max-w-[17ch] flex-[1_1_32rem] text-section font-bold">
      Find it, trace it, catch it next time.
    </h2>
    <p class="max-w-[40ch] flex-[1_1_18rem] text-muted-foreground">
      Logs, traces, detections and uptime in one app, without stitching four tools together.
    </p>
  </div>

  <!-- Revealed as one block: fading single cells would expose the grey gap
       colour behind them. -->
  <div id="features-bento" class="spotlight elevate mt-12 flex flex-wrap gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] bg-foreground/[0.08]" data-reveal style="--reveal-delay: 90ms">
    <article class="flex min-w-0 flex-[999_1_620px] flex-col gap-7 bg-card p-7 md:p-9 dark:bg-background">
      <div>
        <p class={label}>01 · search</p>
        <h3 class={title}>
          One query language, every engine.
          <span class="font-normal text-muted-foreground">Words, exact phrases, exclusions, OR and field filters, the same on TimescaleDB, ClickHouse and MongoDB. Live tail takes the full query.</span>
        </h3>
      </div>
      <div class="mt-auto flex flex-col gap-2.5" data-query-demo>
        <div class="flex h-10 items-center gap-2 overflow-hidden whitespace-nowrap rounded-[10px] border border-input bg-popover px-3.5 font-mono text-[13px]">
          <svg class="h-3.5 w-3.5 shrink-0 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <span data-query-text>{queries[1].q}</span>
          <span class="hero-caret h-[15px] w-[7px] shrink-0 bg-primary-readable/80" aria-hidden="true"></span>
        </div>
        <div class={`overflow-hidden font-mono text-[13px] ${panel}`} role="group" aria-label="Example queries">
          {queries.map((row, i) => (
            <button
              type="button"
              class="flex w-full flex-wrap gap-x-4 gap-y-1 border-b border-foreground/5 px-4 py-2.5 text-left transition-colors last:border-b-0 hover:bg-foreground/[0.03] aria-pressed:bg-nav-active aria-pressed:text-nav-active-foreground"
              aria-pressed={i === 1 ? 'true' : 'false'}
              data-query={row.q}
            >
              <code class="min-w-0 flex-[1_1_16rem]">{row.q}</code>
              <span class="font-sans text-[13px] text-muted-foreground">{row.d}</span>
            </button>
          ))}
        </div>
        <p class="truncate font-mono text-xs text-muted-foreground">
          GET /api/v1/logs?q=<span class="text-foreground/85" data-query-url>{encodeURIComponent(queries[1].q)}</span>
        </p>
      </div>
      <a href="/docs/query-syntax/" class="text-sm font-medium text-primary-readable hover:underline">Query syntax reference →</a>
    </article>

    <article class="flex min-w-0 flex-[1_1_380px] flex-col gap-7 bg-card p-7 md:p-9 dark:bg-background" data-sigma-demo>
      <div>
        <p class={label}>02 · detect</p>
        <h3 class={title}>
          Sigma rules, tested on your data.
          <span class="font-normal text-muted-foreground">Preview a rule on the last 24 hours before enabling it. Exceptions silence the known-good.</span>
        </h3>
      </div>
      <div class="mt-auto flex flex-col gap-2.5">
        <pre class={`m-0 whitespace-pre-wrap break-words px-4 py-3.5 font-mono text-[12px] leading-[1.7] ${panel}`}><span class="text-primary-readable">title:</span> Brute-force login
<span class="text-primary-readable">detection:</span>
  <span class="text-primary-readable">selection:</span>
    event: auth.failed
  <span class="text-primary-readable">condition:</span> selection | count() by ip &gt; 20
<span class="text-primary-readable">level:</span> high</pre>
        <div class="relative overflow-hidden rounded-[10px] border border-border">
          <div class="flex flex-wrap items-center gap-2.5 px-3.5 py-2.5 text-[13px]">
            <button
              type="button"
              class="inline-flex h-7 items-center gap-1.5 rounded-md bg-nav-active px-2.5 text-xs font-medium text-nav-active-foreground transition-opacity disabled:opacity-60"
              data-sigma-run
            >
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z" /></svg>
              Preview · last 24h
            </button>
            <span class="ml-auto inline-flex items-center gap-1.5 rounded-full border border-destructive/30 bg-destructive/15 px-2 py-px text-[11.5px] font-medium text-destructive-text">
              <span class="h-1.5 w-1.5 rounded-full bg-destructive" aria-hidden="true"></span>High
            </span>
            <span class="font-medium tabular-nums" aria-live="polite"><span data-sigma-count>23</span> matches</span>
          </div>
          <span class="absolute bottom-0 left-0 h-0.5 w-full origin-left scale-x-0 bg-primary-readable" data-sigma-progress aria-hidden="true"></span>
        </div>
        <div class="rounded-[10px] border border-dashed border-input px-3.5 py-2.5 text-[13px] text-muted-foreground">
          Exception: ip = 10.0.4.12 · expires in 7 days
        </div>
      </div>
    </article>

    <article class="flex min-w-0 flex-[1_1_380px] flex-col gap-7 bg-card p-7 md:p-9 dark:bg-background">
      <div>
        <p class={label}>03 · trace</p>
        <h3 class={title}>
          OpenTelemetry, natively.
          <span class="font-normal text-muted-foreground">Jump from a log line to the request that produced it, span by span.</span>
        </h3>
      </div>
      <div class="mt-auto flex flex-col gap-2 font-mono text-xs">
        {spans.map((span, i) => (
          <div class="group flex items-center gap-3">
            <span class="w-28 shrink-0 truncate text-foreground/85">{span.name}</span>
            <span class="relative h-4 flex-1 rounded-[3px] bg-foreground/[0.04]">
              <span
                class={`grow-x absolute inset-y-0 rounded-[3px] transition-[filter] group-hover:brightness-125 ${span.cls}`}
                style={`left: ${span.left}%; width: ${span.width}%; --i: ${i * 8}`}
              ></span>
            </span>
            <span class="w-12 shrink-0 text-right text-muted-foreground tabular-nums">{span.ms}ms</span>
          </div>
        ))}
      </div>
    </article>

    <article class="flex min-w-0 flex-[999_1_620px] flex-wrap gap-x-10 gap-y-7 bg-card p-7 md:p-9 dark:bg-background">
      <div class="flex-[1_1_17rem]">
        <p class={label}>04 · uptime</p>
        <h3 class={title}>
          Monitors and a public status page.
          <span class="font-normal text-muted-foreground">HTTP, SSL certificate and DNS checks. A monitor going down opens an incident, and subscribers get an email.</span>
        </h3>
        <a href="/docs/status-page/" class="mt-5 inline-block text-sm font-medium text-primary-readable hover:underline">Status page guide →</a>
      </div>
      <div class="flex min-w-0 flex-[1.2_1_20rem] flex-col gap-2.5" data-uptime-demo>
        <div class={`overflow-hidden ${panel}`}>
          {monitors.map((m) => (
            <div class="flex items-center gap-3 border-b border-foreground/5 px-3.5 py-2.5 text-[13px] last:border-b-0">
              <span class:list={['relative h-[7px] w-[7px] shrink-0 rounded-full', m.ok ? 'ping bg-success' : 'bg-warning']} aria-hidden="true"></span>
              <span class="w-9 font-mono text-[11px] text-muted-foreground">{m.type}</span>
              <span class="min-w-0 flex-1 truncate">{m.name}</span>
              <span class="whitespace-nowrap font-mono text-xs text-muted-foreground">{m.meta}</span>
            </div>
          ))}
        </div>
        <div class="rounded-[10px] border border-border px-3.5 py-3">
          <div class="flex justify-between gap-3 text-xs text-muted-foreground">
            <span>status.solture.it · API</span>
            <span class="text-right" data-uptime-caption aria-live="polite">last 90 days</span>
          </div>
          <div class="mt-2 flex h-6 gap-[2px]">
            {uptime.map((day, i) => (
              <span
                class={`pop-in flex-1 origin-bottom rounded-[2px] transition-opacity hover:opacity-70 ${day.cls}`}
                style={`--i: ${i}`}
                data-note={day.note}
                title={day.note}
              ></span>
            ))}
          </div>
        </div>
      </div>
    </article>

    <article class="flex min-w-0 flex-[1_1_100%] flex-wrap items-center gap-x-10 gap-y-6 bg-card p-7 md:p-9 dark:bg-background" data-engine-demo>
      <div class="flex-[1_1_18rem]">
        <p class={label}>05 · store</p>
        <h3 class={title}>
          Three storage engines, same results.
          <span class="font-normal text-muted-foreground">Histograms, facets, traces and sessions behave the same on all three, pinned by a shared conformance suite.</span>
        </h3>
      </div>
      <div class="flex flex-[2_1_32rem] flex-col gap-3">
        <div class="grid gap-2.5 sm:grid-cols-3" role="radiogroup" aria-label="Storage engine">
          {engines.map((e, i) => (
            <button
              type="button"
              role="radio"
              aria-checked={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-engine={e.value}
              class="rounded-xl border border-foreground/15 px-4 py-4 text-left transition-colors hover:border-foreground/30 aria-checked:border-primary-readable/45 aria-checked:bg-primary/[0.08]"
            >
              <span class="block font-semibold">{e.name}</span>
              <span class="text-sm text-muted-foreground">{e.note}</span>
            </button>
          ))}
        </div>
        <p class="font-mono text-[13px] text-muted-foreground">
          <span class="text-muted-foreground/70"># .env</span>
          <span class="ml-3 text-foreground/85">STORAGE_ENGINE=<span class="text-primary-readable" data-engine-value>{engines[0].value}</span></span>
        </p>
      </div>
    </article>
  </div>
</div>
</section>

<style>
  @keyframes caret-blink {
    50% { opacity: 0; }
  }

  .hero-caret {
    animation: caret-blink 1.1s steps(1) infinite;
  }

  [data-sigma-progress].is-running {
    transform: scaleX(1);
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-caret { animation: none; }
  }
</style>

<script>
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function whenVisible(el: Element, run: () => void) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        run();
      },
      { threshold: 0.4 },
    );
    observer.observe(el);
  }

  function setupQueryDemo(root: HTMLElement) {
    const text = root.querySelector<HTMLElement>('[data-query-text]');
    const url = root.querySelector<HTMLElement>('[data-query-url]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-query]')];
    if (!text || !url || !buttons.length) return;

    let typing: number | undefined;
    let auto: number | undefined;
    let index = buttons.findIndex((b) => b.getAttribute('aria-pressed') === 'true');

    function select(i: number) {
      index = i;
      const query = buttons[i].dataset.query ?? '';
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
      url!.textContent = encodeURIComponent(query);
      window.clearTimeout(typing);
      if (reduceMotion()) {
        text!.textContent = query;
        return;
      }
      let n = 0;
      const step = () => {
        text!.textContent = query.slice(0, ++n);
        if (n < query.length) typing = window.setTimeout(step, 24 + Math.random() * 30);
      };
      step();
    }

    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        window.clearInterval(auto); // the visitor took over
        select(i);
      }),
    );

    if (!reduceMotion()) {
      whenVisible(root, () => {
        auto = window.setInterval(() => {
          if (!document.hidden) select((index + 1) % buttons.length);
        }, 3600);
      });
    }
  }

  function setupSigmaDemo(root: HTMLElement) {
    const run = root.querySelector<HTMLButtonElement>('[data-sigma-run]');
    const count = root.querySelector<HTMLElement>('[data-sigma-count]');
    const progress = root.querySelector<HTMLElement>('[data-sigma-progress]');
    if (!run || !count || !progress) return;
    const target = Number(count.textContent) || 0;

    function preview() {
      if (reduceMotion()) return;
      run!.disabled = true;
      progress!.classList.remove('is-running');
      void progress!.offsetWidth; // restart the transition
      progress!.classList.add('is-running');
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / 1200);
        count!.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(tick);
        else {
          run!.disabled = false;
          window.setTimeout(() => progress!.classList.remove('is-running'), 600);
        }
      };
      requestAnimationFrame(tick);
    }

    run.addEventListener('click', preview);
    whenVisible(root, preview);
  }

  function setupUptimeDemo(root: HTMLElement) {
    const caption = root.querySelector<HTMLElement>('[data-uptime-caption]');
    if (!caption) return;
    const idle = caption.textContent;
    root.addEventListener('pointerover', (event) => {
      const note = (event.target as HTMLElement).dataset?.note;
      if (note) caption.textContent = note;
    });
    root.addEventListener('pointerleave', () => (caption.textContent = idle));
  }

  function setupEngineDemo(root: HTMLElement) {
    const value = root.querySelector<HTMLElement>('[data-engine-value]');
    const radios = [...root.querySelectorAll<HTMLButtonElement>('[data-engine]')];
    if (!value) return;
    const select = (radio: HTMLButtonElement) => {
      radios.forEach((r) => {
        r.setAttribute('aria-checked', String(r === radio));
        r.tabIndex = r === radio ? 0 : -1;
      });
      value.textContent = radio.dataset.engine ?? '';
    };
    radios.forEach((radio, i) => {
      radio.addEventListener('click', () => select(radio));
      // Arrow keys move the selection, as in a native radio group.
      radio.addEventListener('keydown', (event) => {
        const dir = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
        if (!dir) return;
        event.preventDefault();
        const next = radios[(i + dir + radios.length) % radios.length];
        select(next);
        next.focus();
      });
    });
  }

  function setupFeatures() {
    const bento = document.getElementById('features-bento');
    if (!bento || bento.dataset.bound) return;
    bento.dataset.bound = 'true';
    bento.querySelectorAll<HTMLElement>('[data-query-demo]').forEach(setupQueryDemo);
    bento.querySelectorAll<HTMLElement>('[data-sigma-demo]').forEach(setupSigmaDemo);
    bento.querySelectorAll<HTMLElement>('[data-uptime-demo]').forEach(setupUptimeDemo);
    bento.querySelectorAll<HTMLElement>('[data-engine-demo]').forEach(setupEngineDemo);
  }

  setupFeatures();
  document.addEventListener('astro:after-swap', setupFeatures);
</script>
