---
import { Icon } from 'astro-icon/components';

const features = [
  {
    icon: 'lucide:lock',
    title: 'GDPR Compliant',
    description: 'Keep logs on your servers or use our EU-based cloud. Full data ownership and privacy control.',
  },
  {
    icon: 'lucide:gauge',
    title: 'Lightweight',
    description: 'Built on Fastify with TimescaleDB or ClickHouse. Lower memory footprint compared to Java-based stacks like ELK.',
  },
  {
    icon: 'lucide:shield-check',
    title: 'Security Built-in',
    description: 'Sigma rules engine for threat detection. Turn your logs into a SIEM without extra tools.',
  },
  {
    icon: 'lucide:git-branch',
    title: 'OpenTelemetry Native',
    description: 'OTLP ingestion for logs, traces, and metrics. Distributed tracing with service dependency graphs.',
  },
];
---

<section class="border-t border-border px-6 py-24" aria-labelledby="why-logtide-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl" data-reveal>
      <h2 id="why-logtide-heading" class="text-section font-bold">Log management on your terms</h2>
      <p class="mt-4 text-lg text-muted-foreground">
        For developers and European SMBs who need data ownership without ElasticSearch complexity.
      </p>
    </div>

    <!-- Hairlines instead of card boxes: these four are peers, so nothing here
         needs elevating above the rest. -->
    <div class="mt-16 grid gap-x-16 sm:grid-cols-2">
      {features.map((feature, i) => (
        <article
          class="border-t border-border py-8 sm:py-10"
          data-reveal
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <Icon name={feature.icon} class="h-6 w-6 text-primary-readable" aria-hidden="true" />
          <h3 class="mt-5 text-xl font-semibold">{feature.title}</h3>
          <p class="mt-2 max-w-prose text-muted-foreground">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
