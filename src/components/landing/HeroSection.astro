---
const iconPaths = {
  activity: 'M22 12h-4l-3 9L9 3l-3 9H2',
  alertTriangle: 'M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01',
  server: 'M2 9h20 M2 15h20 M6 9v6 M10 9v6 M14 9v6 M18 9v6 M2 5a2 2 0 012-2h16a2 2 0 012 2v14a2 2 0 01-2 2H4a2 2 0 01-2-2V5z',
  trendingUp: 'M23 6l-9.5 9.5-5-5L1 18',
};

const mockStats = [
  { label: 'Total Logs Today', value: '1.2M', trend: '+12%', positive: true, icon: 'activity' },
  { label: 'Error Rate', value: '0.3%', trend: '-5%', positive: true, icon: 'alertTriangle' },
  { label: 'Active Services', value: '24', trend: '+2', positive: true, icon: 'server' },
  { label: 'Throughput', value: '850/s', trend: '+8%', positive: true, icon: 'trendingUp' },
];

const mockLogs = [
  { time: '14:23:45', service: 'api-gateway', level: 'info', message: 'Request processed successfully' },
  { time: '14:23:44', service: 'auth-service', level: 'warn', message: 'Rate limit approaching threshold' },
  { time: '14:23:42', service: 'payment-svc', level: 'error', message: 'Connection timeout to payment provider' },
  { time: '14:23:41', service: 'api-gateway', level: 'info', message: 'Health check passed' },
  { time: '14:23:40', service: 'user-service', level: 'debug', message: 'Cache hit for user profile' },
];

function getLevelColor(level: string): string {
  switch (level) {
    case 'error': return 'bg-red-500/20 text-red-400';
    case 'warn': return 'bg-yellow-500/20 text-yellow-400';
    case 'info': return 'bg-blue-500/20 text-blue-400';
    case 'debug': return 'bg-zinc-500/20 text-zinc-400';
    default: return 'bg-zinc-500/20 text-zinc-400';
  }
}

const chartHeights = [40, 55, 45, 60, 50, 70, 65, 80, 75, 90, 85, 95, 88, 92, 78, 82, 70, 65, 75, 80, 85, 90, 88, 95];
---

<section class="relative overflow-hidden px-6 py-16 md:py-24" aria-labelledby="hero-heading">
  <!-- Background gradients - purple -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl">
    <div class="mb-12 text-center">
      <!-- Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
        </span>
        Free during Alpha
      </div>

      <!-- Headline -->
      <h1 id="hero-heading" class="mb-6 text-4xl font-bold tracking-tight md:text-6xl">
        Privacy-first Log Management.
        <span class="text-primary">Open Source.</span>
      </h1>

      <!-- Subheadline -->
      <p class="mx-auto mb-8 max-w-2xl text-xl text-muted-foreground">
        The open source alternative to Datadog and Splunk.
        GDPR compliant, self-hosted or EU cloud. No ElasticSearch complexity.
      </p>

      <!-- CTAs -->
      <div class="mb-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="https://app.logward.dev/register"
          class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-lg font-medium text-white transition-colors hover:bg-primary-600"
        >
          Try Cloud Free
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="/docs/getting-started"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-card/50 px-6 py-3 text-lg font-medium text-foreground transition-colors hover:bg-muted"
        >
          Self-Host with Docker
        </a>
      </div>
    </div>

    <!-- Dashboard Preview -->
    <figure class="relative mx-auto max-w-5xl" role="img" aria-label="LogWard dashboard preview showing log statistics, volume chart, and recent logs table">
      <div class="absolute -inset-4 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-50 blur-2xl" aria-hidden="true"></div>

      <div class="relative overflow-hidden rounded-xl border border-border bg-card shadow-2xl" aria-hidden="true">
        <!-- Window controls -->
        <div class="flex items-center gap-2 border-b border-border bg-card/50 px-4 py-3">
          <div class="flex gap-1.5">
            <div class="h-3 w-3 rounded-full bg-red-500/80"></div>
            <div class="h-3 w-3 rounded-full bg-yellow-500/80"></div>
            <div class="h-3 w-3 rounded-full bg-green-500/80"></div>
          </div>
          <div class="flex flex-1 justify-center">
            <div class="rounded-md bg-background/50 px-4 py-1 font-mono text-xs text-muted-foreground">
              logward.dev/dashboard
            </div>
          </div>
          <div class="w-16"></div>
        </div>

        <!-- Dashboard content -->
        <div class="bg-background p-4 md:p-6">
          <!-- Stats grid -->
          <div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
            {mockStats.map((stat) => (
              <div class="rounded-lg border border-border bg-card p-3 md:p-4">
                <div class="mb-1 flex items-center gap-2 text-muted-foreground">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[stat.icon as keyof typeof iconPaths]} />
                  </svg>
                  <span class="truncate text-xs">{stat.label}</span>
                </div>
                <div class="flex items-baseline gap-2">
                  <span class="text-xl font-bold md:text-2xl">{stat.value}</span>
                  <span class={`text-xs ${stat.positive ? 'text-green-500' : 'text-red-500'}`}>
                    {stat.trend}
                  </span>
                </div>
              </div>
            ))}
          </div>

          <!-- Chart -->
          <div class="mb-6 rounded-lg border border-border bg-card p-4">
            <div class="mb-4 flex items-center justify-between">
              <span class="text-sm font-medium">Log Volume (24h)</span>
              <div class="flex gap-2">
                <span class="rounded bg-primary/10 px-2 py-0.5 text-xs text-primary">Live</span>
              </div>
            </div>
            <div class="flex h-24 items-end gap-1" role="img" aria-label="Bar chart showing log volume over 24 hours">
              {chartHeights.map((height, i) => (
                <div
                  class={`flex-1 rounded-t transition-all duration-300 ${i >= 22 ? 'bg-primary' : 'bg-primary/30'}`}
                  style={`height: ${height}%`}
                ></div>
              ))}
            </div>
            <div class="mt-2 flex justify-between text-xs text-muted-foreground">
              <span>00:00</span>
              <span>12:00</span>
              <span>Now</span>
            </div>
          </div>

          <!-- Logs table -->
          <div class="overflow-hidden rounded-lg border border-border bg-card">
            <div class="flex items-center justify-between border-b border-border px-4 py-3">
              <span class="text-sm font-medium">Recent Logs</span>
              <span class="text-xs text-muted-foreground">Last 5 entries</span>
            </div>
            <div class="divide-y divide-border">
              {mockLogs.map((log) => (
                <div class="flex items-center gap-3 px-4 py-2 text-sm transition-colors hover:bg-muted/30">
                  <span class="w-16 shrink-0 font-mono text-xs text-muted-foreground">{log.time}</span>
                  <span class="max-w-20 truncate rounded bg-secondary px-2 py-0.5 text-xs font-medium">{log.service}</span>
                  <span class={`w-14 shrink-0 rounded px-2 py-0.5 text-center text-xs font-medium uppercase ${getLevelColor(log.level)}`}>
                    {log.level}
                  </span>
                  <span class="flex-1 truncate text-muted-foreground">{log.message}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>
