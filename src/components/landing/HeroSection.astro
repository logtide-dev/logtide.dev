---
const iconPaths = {
  activity: 'M22 12h-4l-3 9L9 3l-3 9H2',
  alertTriangle: 'M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01',
  server: 'M2 9h20 M2 15h20 M6 9v6 M10 9v6 M14 9v6 M18 9v6 M2 5a2 2 0 012-2h16a2 2 0 012 2v14a2 2 0 01-2 2H4a2 2 0 01-2-2V5z',
  trendingUp: 'M23 6l-9.5 9.5-5-5L1 18',
};

const mockStats = [
  { key: 'total', label: 'Total Logs Today', value: '1.2M', trend: '+12%', positive: true, icon: 'activity' },
  { key: 'errors', label: 'Error Rate', value: '0.3%', trend: '-5%', positive: true, icon: 'alertTriangle' },
  { key: 'services', label: 'Active Services', value: '24', trend: '+2', positive: true, icon: 'server' },
  { key: 'throughput', label: 'Throughput', value: '850/s', trend: '+8%', positive: true, icon: 'trendingUp' },
];

const mockLogs = [
  { time: '14:23:45', service: 'api-gateway', level: 'info', message: 'Request processed successfully' },
  { time: '14:23:44', service: 'auth-service', level: 'warn', message: 'Rate limit approaching threshold' },
  { time: '14:23:42', service: 'payment-svc', level: 'error', message: 'Connection timeout to payment provider' },
  { time: '14:23:41', service: 'api-gateway', level: 'info', message: 'Health check passed' },
  { time: '14:23:40', service: 'user-service', level: 'debug', message: 'Cache hit for user profile' },
];

function getLevelColor(level: string): string {
  switch (level) {
    case 'error': return 'bg-red-500/10 text-red-600 dark:bg-red-500/20 dark:text-red-400';
    case 'warn': return 'bg-yellow-500/10 text-yellow-700 dark:bg-yellow-500/20 dark:text-yellow-400';
    case 'info': return 'bg-blue-500/10 text-blue-600 dark:bg-blue-500/20 dark:text-blue-400';
    case 'debug': return 'bg-zinc-500/10 text-zinc-600 dark:bg-zinc-500/20 dark:text-zinc-400';
    default: return 'bg-zinc-500/10 text-zinc-600 dark:bg-zinc-500/20 dark:text-zinc-400';
  }
}

const chartHeights = [40, 55, 45, 60, 50, 70, 65, 80, 75, 90, 85, 95, 88, 92, 78, 82, 70, 65, 75, 80, 85, 90, 88, 95];
---

<section class="relative overflow-hidden px-6 py-16 md:py-24" aria-labelledby="hero-heading">
  <!-- Background gradients - purple -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl">
    <div class="mb-12 text-center">
      <!-- Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 font-mono text-xs font-medium uppercase tracking-wider text-primary">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
        </span>
        Free during Beta
      </div>

      <!-- Headline -->
      <h1 id="hero-heading" class="mb-6 text-4xl font-bold tracking-tight md:text-6xl">
        Privacy-first log management.
        <span class="text-primary">Open source.</span>
      </h1>

      <!-- Subheadline -->
      <p class="mx-auto mb-8 max-w-2xl text-xl text-muted-foreground">
        The open source alternative to Datadog and Splunk.
        GDPR compliant, self-hosted or EU cloud. No ElasticSearch complexity.
      </p>

      <!-- CTAs -->
      <div class="mb-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="https://app.logtide.dev/register"
          class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-lg font-medium text-white transition-colors hover:bg-primary-600"
        >
          Start for free
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="/docs/getting-started/"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-card/50 px-6 py-3 text-lg font-medium text-foreground transition-colors hover:bg-muted"
        >
          Self-Host with Docker
        </a>
      </div>
    </div>

    <!-- Dashboard Preview -->
    <figure class="relative mx-auto max-w-5xl" role="img" aria-label="LogTide dashboard preview showing log statistics, volume chart, and recent logs table">
      <div class="absolute -inset-4 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-50 blur-2xl" aria-hidden="true"></div>

      <div class="relative overflow-hidden rounded-xl border border-border bg-card shadow-2xl" aria-hidden="true">
        <!-- Window controls -->
        <div class="flex items-center gap-2 border-b border-border bg-card/50 px-4 py-3">
          <div class="flex gap-1.5">
            <div class="h-3 w-3 rounded-full bg-red-500/80"></div>
            <div class="h-3 w-3 rounded-full bg-yellow-500/80"></div>
            <div class="h-3 w-3 rounded-full bg-green-500/80"></div>
          </div>
          <div class="flex flex-1 justify-center">
            <div class="rounded-md bg-background/50 px-4 py-1 font-mono text-xs text-muted-foreground">
              logtide.dev/dashboard
            </div>
          </div>
          <div class="w-16"></div>
        </div>

        <!-- Dashboard content -->
        <div class="bg-background p-4 md:p-6">
          <!-- Stats grid -->
          <div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
            {mockStats.map((stat) => (
              <div class="rounded-lg border border-border bg-card p-3 md:p-4">
                <div class="mb-1 flex items-center gap-2 text-muted-foreground">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[stat.icon as keyof typeof iconPaths]} />
                  </svg>
                  <span class="truncate text-xs">{stat.label}</span>
                </div>
                <div class="flex items-baseline gap-2">
                  <span class="font-mono text-xl font-bold md:text-2xl" data-stat={stat.key}>{stat.value}</span>
                  <span class={`font-mono text-xs ${stat.positive ? 'text-green-600 dark:text-green-500' : 'text-red-600 dark:text-red-500'}`}>
                    {stat.trend}
                  </span>
                </div>
              </div>
            ))}
          </div>

          <!-- Chart -->
          <div class="mb-6 rounded-lg border border-border bg-card p-4">
            <div class="mb-4 flex items-center justify-between">
              <span class="text-sm font-medium">Log Volume (24h)</span>
              <div class="flex gap-2">
                <span class="rounded bg-primary/10 px-2 py-0.5 text-xs text-primary">Live</span>
              </div>
            </div>
            <div class="flex h-24 items-end gap-1" id="hero-chart" role="img" aria-label="Bar chart showing log volume over 24 hours">
              {chartHeights.map((height, i) => (
                <div
                  class={`flex-1 rounded-t transition-all duration-300 ${i >= 22 ? 'bg-primary' : 'bg-primary/30'}`}
                  style={`height: ${height}%`}
                ></div>
              ))}
            </div>
            <div class="mt-2 flex justify-between text-xs text-muted-foreground">
              <span>00:00</span>
              <span>12:00</span>
              <span>Now</span>
            </div>
          </div>

          <!-- Logs table -->
          <div class="overflow-hidden rounded-lg border border-border bg-card">
            <div class="flex items-center justify-between border-b border-border px-4 py-3">
              <span class="text-sm font-medium">Recent Logs</span>
              <span class="text-xs text-muted-foreground">Last 5 entries</span>
            </div>
            <div class="divide-y divide-border" id="hero-log-stream">
              {mockLogs.map((log) => (
                <div class="flex items-center gap-3 px-4 py-2 transition-colors hover:bg-muted/30">
                  <span class="w-16 shrink-0 font-mono text-xs text-muted-foreground">{log.time}</span>
                  <span class="max-w-20 truncate rounded bg-secondary px-2 py-0.5 font-mono text-xs font-medium">{log.service}</span>
                  <span class={`w-14 shrink-0 rounded px-2 py-0.5 text-center font-mono text-xs font-medium uppercase ${getLevelColor(log.level)}`}>
                    {log.level}
                  </span>
                  <span class="flex-1 truncate font-mono text-xs text-muted-foreground">{log.message}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<style is:global>
  @keyframes hero-log-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-log-enter {
    animation: hero-log-in 350ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-log-enter {
      animation: none;
    }
  }
</style>

<script>
  // Streams fake log lines into the hero dashboard so the "real-time" claim
  // is shown, not told. Skipped entirely under prefers-reduced-motion.
  // Level classes mirror getLevelColor() in the frontmatter above.
  const LEVEL_CLASSES: Record<string, string> = {
    error: 'bg-red-500/10 text-red-600 dark:bg-red-500/20 dark:text-red-400',
    warn: 'bg-yellow-500/10 text-yellow-700 dark:bg-yellow-500/20 dark:text-yellow-400',
    info: 'bg-blue-500/10 text-blue-600 dark:bg-blue-500/20 dark:text-blue-400',
    debug: 'bg-zinc-500/10 text-zinc-600 dark:bg-zinc-500/20 dark:text-zinc-400',
  };

  const LOG_POOL = [
    { service: 'api-gateway', level: 'info', message: 'Request processed successfully' },
    { service: 'auth-service', level: 'info', message: 'Token refreshed for session' },
    { service: 'payment-svc', level: 'warn', message: 'Retrying provider webhook (attempt 2)' },
    { service: 'user-service', level: 'debug', message: 'Cache hit for user profile' },
    { service: 'api-gateway', level: 'info', message: 'Health check passed' },
    { service: 'ingest-worker', level: 'info', message: 'Batch of 512 logs flushed' },
    { service: 'auth-service', level: 'warn', message: 'Rate limit approaching threshold' },
    { service: 'search-svc', level: 'info', message: 'Query completed in 38ms' },
    { service: 'payment-svc', level: 'error', message: 'Connection timeout to payment provider' },
    { service: 'alerting', level: 'info', message: 'Sigma rule evaluated: no match' },
    { service: 'user-service', level: 'info', message: 'Profile updated' },
    { service: 'ingest-worker', level: 'debug', message: 'Backpressure normal, buffer at 12%' },
  ];

  function formatTime(date: Date): string {
    return date.toTimeString().slice(0, 8);
  }

  function buildRow(entry: (typeof LOG_POOL)[number]): HTMLDivElement {
    const row = document.createElement('div');
    row.className = 'hero-log-enter flex items-center gap-3 px-4 py-2 transition-colors hover:bg-muted/30';

    const time = document.createElement('span');
    time.className = 'w-16 shrink-0 font-mono text-xs text-muted-foreground';
    time.textContent = formatTime(new Date());

    const service = document.createElement('span');
    service.className = 'max-w-20 truncate rounded bg-secondary px-2 py-0.5 font-mono text-xs font-medium';
    service.textContent = entry.service;

    const level = document.createElement('span');
    level.className = `w-14 shrink-0 rounded px-2 py-0.5 text-center font-mono text-xs font-medium uppercase ${LEVEL_CLASSES[entry.level]}`;
    level.textContent = entry.level;

    const message = document.createElement('span');
    message.className = 'flex-1 truncate font-mono text-xs text-muted-foreground';
    message.textContent = entry.message;

    row.append(time, service, level, message);
    return row;
  }

  function startHeroStream() {
    const list = document.getElementById('hero-log-stream');
    if (!list || list.dataset.streaming === 'true') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    list.dataset.streaming = 'true';

    const chart = document.getElementById('hero-chart');
    const throughput = document.querySelector<HTMLElement>('[data-stat="throughput"]');
    let poolIndex = Math.floor(Math.random() * LOG_POOL.length);

    setInterval(() => {
      if (document.hidden) return;

      list.prepend(buildRow(LOG_POOL[poolIndex]));
      poolIndex = (poolIndex + 1) % LOG_POOL.length;
      while (list.children.length > 5) list.lastElementChild?.remove();

      const lastBar = chart?.lastElementChild as HTMLElement | null;
      if (lastBar) lastBar.style.height = `${70 + Math.round(Math.random() * 28)}%`;

      if (throughput) throughput.textContent = `${830 + Math.round(Math.random() * 45)}/s`;
    }, 2500);
  }

  startHeroStream();
  document.addEventListener('astro:after-swap', startHeroStream);
</script>
