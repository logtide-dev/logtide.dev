---
const seedLogs = [
  { time: '14:23:45', service: 'api-gateway', level: 'info', message: 'Request processed successfully' },
  { time: '14:23:44', service: 'auth-service', level: 'warn', message: 'Rate limit approaching threshold' },
  { time: '14:23:42', service: 'payment-svc', level: 'error', message: 'Connection timeout to payment provider' },
  { time: '14:23:41', service: 'api-gateway', level: 'info', message: 'Health check passed' },
  { time: '14:23:40', service: 'user-service', level: 'debug', message: 'Cache hit for user profile' },
  { time: '14:23:38', service: 'ingest-worker', level: 'info', message: 'Batch of 512 logs flushed' },
];

function levelClass(level: string): string {
  switch (level) {
    case 'error': return 'bg-red-500/10 text-red-700 dark:bg-red-500/15 dark:text-red-300';
    case 'warn': return 'bg-amber-500/10 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300';
    case 'info': return 'bg-sky-500/10 text-sky-700 dark:bg-sky-500/15 dark:text-sky-300';
    default: return 'bg-muted text-muted-foreground';
  }
}
---

<section class="px-6 pb-20 pt-16 md:pb-28 md:pt-24" aria-labelledby="hero-heading">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7" data-reveal>
      <p class="mb-6 inline-flex items-center rounded-full border border-border bg-card px-3 py-1 font-mono text-xs font-medium uppercase tracking-[0.14em] text-primary-readable">
        Free during Beta
      </p>

      <h1 id="hero-heading" class="text-display font-bold">
        Privacy-first log management.
        <span class="text-primary-readable">Open source.</span>
      </h1>

      <p class="mt-6 max-w-prose text-lg text-muted-foreground md:text-xl">
        The open source alternative to Datadog and Splunk. GDPR compliant, self-hosted or EU cloud.
        No ElasticSearch complexity.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="https://app.logtide.dev/register"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-primary px-6 py-3 text-base font-medium text-primary-foreground transition-all hover:bg-primary-600 active:translate-y-px"
        >
          Start for free
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="/docs/getting-started/"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-border bg-card px-6 py-3 text-base font-medium text-foreground transition-all hover:bg-muted active:translate-y-px"
        >
          Self-host with Docker
        </a>
      </div>
    </div>

    <!-- Live ingest panel. A working in-page component, not a screenshot: the
         rows below are streamed by the script at the bottom of this file. -->
    <div class="lg:col-span-5" data-reveal style="--reveal-delay: 120ms">
      <figure class="overflow-hidden rounded-xl border border-border bg-card shadow-panel-lg">
        <figcaption class="flex items-center justify-between gap-4 border-b border-border px-4 py-3">
          <span class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">Live ingest</span>
          <span class="font-mono text-xs text-muted-foreground">
            <span data-throughput class="text-foreground">846</span> events/s
          </span>
        </figcaption>

        <div id="hero-log-stream" class="divide-y divide-border">
          {seedLogs.map((log) => (
            <div class="flex items-center gap-3 px-4 py-2.5">
              <span class="w-14 shrink-0 font-mono text-xs text-muted-foreground">{log.time}</span>
              <span class="hidden w-24 shrink-0 truncate font-mono text-xs text-foreground sm:block">{log.service}</span>
              <span class={`w-14 shrink-0 rounded-sm px-1.5 py-0.5 text-center font-mono text-[10px] font-medium uppercase ${levelClass(log.level)}`}>
                {log.level}
              </span>
              <span class="flex-1 truncate font-mono text-xs text-muted-foreground">{log.message}</span>
            </div>
          ))}
        </div>

        <p class="border-t border-border px-4 py-2.5 font-mono text-[11px] text-muted-foreground">
          Sample stream. Your own logs look like this within a minute of the first SDK call.
        </p>
      </figure>
    </div>
  </div>
</section>

<style>
  @keyframes hero-log-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  :global(.hero-log-enter) {
    animation: hero-log-in 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hero-log-enter) { animation: none; }
  }
</style>

<script>
  // Streams sample log lines so the real-time claim is shown, not told.
  // Skipped entirely under prefers-reduced-motion.
  const LEVEL_CLASSES: Record<string, string> = {
    error: 'bg-red-500/10 text-red-700 dark:bg-red-500/15 dark:text-red-300',
    warn: 'bg-amber-500/10 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300',
    info: 'bg-sky-500/10 text-sky-700 dark:bg-sky-500/15 dark:text-sky-300',
    debug: 'bg-muted text-muted-foreground',
  };

  const LOG_POOL = [
    { service: 'api-gateway', level: 'info', message: 'Request processed successfully' },
    { service: 'auth-service', level: 'info', message: 'Token refreshed for session' },
    { service: 'payment-svc', level: 'warn', message: 'Retrying provider webhook (attempt 2)' },
    { service: 'user-service', level: 'debug', message: 'Cache hit for user profile' },
    { service: 'api-gateway', level: 'info', message: 'Health check passed' },
    { service: 'ingest-worker', level: 'info', message: 'Batch of 512 logs flushed' },
    { service: 'auth-service', level: 'warn', message: 'Rate limit approaching threshold' },
    { service: 'search-svc', level: 'info', message: 'Query completed in 38ms' },
    { service: 'payment-svc', level: 'error', message: 'Connection timeout to payment provider' },
    { service: 'alerting', level: 'info', message: 'Sigma rule evaluated: no match' },
    { service: 'user-service', level: 'info', message: 'Profile updated' },
    { service: 'ingest-worker', level: 'debug', message: 'Backpressure normal, buffer at 12%' },
  ];

  function buildRow(entry: (typeof LOG_POOL)[number]): HTMLDivElement {
    const row = document.createElement('div');
    row.className = 'hero-log-enter flex items-center gap-3 px-4 py-2.5';

    const time = document.createElement('span');
    time.className = 'w-14 shrink-0 font-mono text-xs text-muted-foreground';
    time.textContent = new Date().toTimeString().slice(0, 8);

    const service = document.createElement('span');
    service.className = 'hidden w-24 shrink-0 truncate font-mono text-xs text-foreground sm:block';
    service.textContent = entry.service;

    const level = document.createElement('span');
    level.className = `w-14 shrink-0 rounded-sm px-1.5 py-0.5 text-center font-mono text-[10px] font-medium uppercase ${LEVEL_CLASSES[entry.level]}`;
    level.textContent = entry.level;

    const message = document.createElement('span');
    message.className = 'flex-1 truncate font-mono text-xs text-muted-foreground';
    message.textContent = entry.message;

    row.append(time, service, level, message);
    return row;
  }

  function startHeroStream() {
    const list = document.getElementById('hero-log-stream');
    if (!list || list.dataset.streaming === 'true') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    list.dataset.streaming = 'true';

    const throughput = document.querySelector<HTMLElement>('[data-throughput]');
    let poolIndex = Math.floor(Math.random() * LOG_POOL.length);

    setInterval(() => {
      if (document.hidden) return;

      list.prepend(buildRow(LOG_POOL[poolIndex]));
      poolIndex = (poolIndex + 1) % LOG_POOL.length;
      while (list.children.length > 6) list.lastElementChild?.remove();

      if (throughput) throughput.textContent = String(830 + Math.round(Math.random() * 45));
    }, 2500);
  }

  startHeroStream();
  document.addEventListener('astro:after-swap', startHeroStream);
</script>
