---
import CodeBlock from '../docs/CodeBlock.astro';

const code = `// Install: npm install @logtide/core
import { hub } from '@logtide/core'

hub.init({
  dsn: process.env.LOGTIDE_DSN,
  service: 'my-api',
  environment: 'production',
})

hub.captureLog('info', 'User signed up', {
  userId: 'usr_123',
  plan: 'pro',
})`;

const steps = [
  {
    title: 'Deploy in 5 minutes',
    description: 'Self-host with Docker Compose or sign up for the free cloud. No complex infrastructure required.',
  },
  {
    title: 'Get your API key',
    description: 'Create an organization and project. Generate a scoped API key for your application.',
  },
  {
    title: 'Send your logs',
    description: 'Use our SDKs (Node.js, Python, PHP, Kotlin), OpenTelemetry, or the HTTP API directly.',
  },
  {
    title: 'Search & Alert',
    description: 'Full-text search, real-time streaming, and alerts via Email, Slack, or Discord webhooks.',
  },
];
---

<section class="border-t border-border bg-muted/40 px-6 py-24" aria-labelledby="quickstart-heading">
  <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <h2 id="quickstart-heading" class="text-section font-bold">Get started in minutes</h2>
      <p class="mt-4 text-lg text-muted-foreground">
        From zero to production-ready log management.
      </p>

      <ol class="m-0 mt-10 list-none space-y-7 p-0">
        {steps.map((step, i) => (
          <li class="flex items-start gap-4">
            <span class="mt-0.5 shrink-0 font-mono text-sm text-primary-readable" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-semibold">{step.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <figure class="lg:col-span-7" aria-label="Code example showing how to use the LogTide SDK" data-reveal style="--reveal-delay: 120ms">
      <div class="overflow-hidden rounded-xl shadow-panel-lg">
        <CodeBlock code={code} lang="typescript" title="app.ts" />
      </div>
    </figure>
  </div>
</section>
