---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const integrations = await getCollection('integrations', ({ data }) => !data.draft);
const useCases = await getCollection('use-cases', ({ data }) => !data.draft);
const comparisons = await getCollection('comparisons', ({ data }) => !data.draft);

const featuredIntegrations = integrations.slice(0, 3);
const featuredUseCases = useCases.slice(0, 3);

// Feature the highest-intent comparisons (curated, with a fallback to the first available)
const featuredComparisonSlugs = ['datadog', 'splunk', 'elk-stack'];
const featuredComparisons = featuredComparisonSlugs
  .map((slug) => comparisons.find((c) => c.id === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined)
  .concat(comparisons.filter((c) => !featuredComparisonSlugs.includes(c.id)))
  .slice(0, 3);

const secondaryLists = [
  { title: 'Integrations', href: '/integrations/', items: featuredIntegrations.map((i) => ({ label: i.data.title, href: `/integrations/${i.id}/` })) },
  { title: 'Use Cases', href: '/use-cases/', items: featuredUseCases.map((i) => ({ label: i.data.title, href: `/use-cases/${i.id}/` })) },
];
---

<section class="border-t border-border bg-muted/40 px-6 py-24" aria-labelledby="explore-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl" data-reveal>
      <h2 id="explore-heading" class="text-section font-bold">Integrations, use cases and comparisons</h2>
      <p class="mt-4 text-lg text-muted-foreground">
        See how LogTide fits your stack, and how it compares to the tool you use today.
      </p>
    </div>

    <!-- Weighted, not equal: comparisons carry the most buying intent, so they
         get the wide panel and the other two stack beside it. -->
    <div class="mt-14 grid gap-6 lg:grid-cols-12">
      <div class="rounded-xl border border-border bg-card p-7 lg:col-span-7" data-reveal>
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="text-xl font-semibold">Comparisons</h3>
          <a href="/vs/" class="inline-flex items-center gap-1 text-sm text-primary-readable hover:underline">
            View all
            <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>

        <ul class="m-0 mt-6 list-none divide-y divide-border p-0">
          {featuredComparisons.map((item) => (
            <li>
              <a href={`/vs/${item.id}/`} class="group flex items-center gap-4 py-4">
                <div class="min-w-0 flex-1">
                  <span class="block font-medium transition-colors group-hover:text-primary-readable">
                    LogTide vs {item.data.competitor}
                  </span>
                  <span class="mt-0.5 block truncate text-sm text-muted-foreground">{item.data.description}</span>
                </div>
                <Icon
                  name="lucide:arrow-right"
                  class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))}
        </ul>

        <a href="/docs/migration/" class="mt-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground">
          Migrating from another tool? See the migration guides
          <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>

      <div class="grid gap-6 lg:col-span-5">
        {secondaryLists.map((list, i) => (
          <div class="rounded-xl border border-border bg-card p-7" data-reveal style={`--reveal-delay: ${(i + 1) * 90}ms`}>
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-lg font-semibold">{list.title}</h3>
              <a href={list.href} class="text-sm text-primary-readable hover:underline">View all</a>
            </div>
            <ul class="m-0 mt-4 list-none space-y-2.5 p-0">
              {list.items.map((item) => (
                <li>
                  <a href={item.href} class="block truncate text-sm text-muted-foreground transition-colors hover:text-foreground">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
