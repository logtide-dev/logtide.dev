---
const productLinks = [
  { href: '/docs/getting-started/', label: 'Getting Started' },
  { href: '/docs/api/', label: 'API Reference' },
  { href: '/docs/sdks/', label: 'SDKs' },
  { href: '/docs/architecture/', label: 'Architecture' },
  { href: '/docs/deployment/', label: 'Deployment' },
];

const resourceLinks = [
  { href: '/integrations/', label: 'Integrations' },
  { href: '/use-cases/', label: 'Use Cases' },
  { href: '/vs/', label: 'Comparisons' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/docs/migration/', label: 'Migration Guides' },
  { href: '/docs/', label: 'Documentation' },
  { href: '/contact/', label: 'Contact' },
  { href: 'https://app.logtide.dev/status/logtide/overview', label: 'Status', external: true },
];

const openSourceLinks = [
  { href: 'https://github.com/logtide-dev/logtide', label: 'GitHub', external: true },
  { href: 'https://github.com/logtide-dev/logtide/blob/main/LICENSE', label: 'AGPLv3 License', external: true },
  { href: 'https://github.com/logtide-dev/logtide/issues', label: 'Report Issue', external: true },
  { href: '/docs/contributing/', label: 'Contributing' },
];

const legalLinks = [
  { href: '/legal/privacy/', label: 'Privacy Policy' },
  { href: '/legal/terms/', label: 'Terms of Service' },
  { href: '/legal/cookies/', label: 'Cookie Policy' },
  { href: '/legal/acceptable-use/', label: 'Acceptable Use' },
];
---

<footer class="border-t border-border bg-card/30 py-12">
  <div class="footer-container">
    <div class="mb-8 grid gap-8 md:grid-cols-6">
      <div class="md:col-span-2">
        <img src="/logo/white.svg" alt="LogTide" class="mb-4 hidden h-8 w-auto dark:block" width="120" height="32" />
        <img src="/logo/dark.svg" alt="LogTide" class="mb-4 block h-8 w-auto dark:hidden" width="120" height="32" />
        <p class="max-w-xs text-sm text-muted-foreground">
          Privacy-first log management. Open source, GDPR compliant, built in Europe.
        </p>
        <ul class="mt-3 space-y-1">
          <li class="text-sm text-muted-foreground">Support: <a href="mailto:support@logtide.dev" class="transition-colors hover:text-foreground">support@logtide.dev</a></li>
          <li class="text-sm text-muted-foreground">Security: <a href="mailto:security@logtide.dev" class="transition-colors hover:text-foreground">security@logtide.dev</a></li>
          <li class="text-sm text-muted-foreground">Sales: <a href="mailto:hello@logtide.dev" class="transition-colors hover:text-foreground">hello@logtide.dev</a></li>
        </ul>
      </div>

      <nav aria-label="Product links">
        <h4 class="mb-4 font-semibold text-foreground">Product</h4>
        <ul class="space-y-2">
          {productLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Resource links">
        <h4 class="mb-4 font-semibold text-foreground">Resources</h4>
        <ul class="space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                target={'external' in link ? '_blank' : undefined}
                rel={'external' in link ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Open source links">
        <h4 class="mb-4 font-semibold text-foreground">Open Source</h4>
        <ul class="space-y-2">
          {openSourceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                target={'external' in link ? '_blank' : undefined}
                rel={'external' in link ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Legal links">
        <h4 class="mb-4 font-semibold text-foreground">Legal</h4>
        <ul class="space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-border pt-8 md:flex-row">
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} Solture S.R.L. — LogTide. Built with care in Europe.
      </p>
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a
          id="logtide-status-badge"
          href="https://app.logtide.dev/status/logtide/overview"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 transition-colors hover:text-foreground"
        >
          <span
            id="logtide-status-dot"
            class="h-2 w-2 rounded-full bg-green-500"
            style="background-color: #16a34a;"
            aria-hidden="true"
          ></span>
          <span id="logtide-status-label" role="status">All systems operational</span>
        </a>
      </div>

      <script>
        (async () => {
          const label = document.getElementById('logtide-status-label');
          const dot = document.getElementById('logtide-status-dot');
          if (!label || !dot) return;
          try {
            const res = await fetch('https://api.logtide.dev/api/v1/status/logtide/overview/badge.json', {
              headers: { Accept: 'application/json' },
            });
            if (!res.ok) return;
            const data = await res.json();
            if (typeof data.label === 'string' && data.label.length > 0) {
              label.textContent = data.label.charAt(0).toUpperCase() + data.label.slice(1);
            }
            if (typeof data.color === 'string' && data.color.length > 0) {
              dot.style.backgroundColor = data.color;
            }
          } catch {
            /* keep fallback */
          }
        })();
      </script>
    </div>
  </div>
</footer>
