---
import Badge from '../ui/Badge.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  type: 'feature' | 'fix' | 'breaking' | 'improvement' | 'security';
  showIcon?: boolean;
  class?: string;
}

const { type, showIcon = true, class: className = '' } = Astro.props;

const config = {
  feature: {
    label: 'Feature',
    colorClass: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20',
    icon: 'lucide:sparkles',
  },
  fix: {
    label: 'Fix',
    colorClass: 'bg-green-500/10 text-green-600 dark:text-green-400 border-green-500/20',
    icon: 'lucide:wrench',
  },
  breaking: {
    label: 'Breaking',
    colorClass: 'bg-red-500/10 text-red-600 dark:text-red-400 border-red-500/20',
    icon: 'lucide:triangle-alert',
  },
  improvement: {
    label: 'Improvement',
    colorClass: 'bg-sky-500/10 text-sky-600 dark:text-sky-400 border-sky-500/20',
    icon: 'lucide:arrow-up-circle',
  },
  security: {
    label: 'Security',
    colorClass: 'bg-orange-500/10 text-orange-600 dark:text-orange-400 border-orange-500/20',
    icon: 'lucide:shield-check',
  },
};

const { label, colorClass, icon } = config[type];
---

<Badge variant="outline" class={`${colorClass} ${className}`}>
  {showIcon && <Icon name={icon} class="w-3 h-3 mr-1" />}
  {label}
</Badge>
