---
interface Props {
  type: 'feature' | 'fix' | 'breaking' | 'improvement' | 'security';
}

const { type } = Astro.props;

// Same tones as the changelog index.
const config = {
  feature: { label: 'Feature', badge: 'border-primary-readable/35 bg-nav-active text-nav-active-foreground', dot: 'bg-primary-readable' },
  improvement: { label: 'Improvement', badge: 'border-info/30 bg-info/15 text-info-text', dot: 'bg-info' },
  fix: { label: 'Fix', badge: 'border-warning/30 bg-warning/15 text-warning-text', dot: 'bg-warning' },
  security: { label: 'Security', badge: 'border-destructive/30 bg-destructive/15 text-destructive-text', dot: 'bg-destructive' },
  breaking: { label: 'Breaking', badge: 'border-critical/30 bg-critical/15 text-critical-text', dot: 'bg-critical' },
};

const { label, badge, dot } = config[type];
---

<span class={`inline-flex items-center gap-1.5 rounded-full border px-2 py-px text-[11.5px] font-medium ${badge}`}>
  <span class={`h-1.5 w-1.5 rounded-full ${dot}`} aria-hidden="true"></span>
  {label}
</span>
