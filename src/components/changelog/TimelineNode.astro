---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import TypeBadge from './TypeBadge.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  entry: CollectionEntry<'changelog'>;
  isLast?: boolean;
}

const { entry, isLast = false } = Astro.props;
const { version, title, description, date, targetDate, status, type, highlights, githubPr } = entry.data;

const dotConfig = {
  released: { bg: 'bg-green-500', ring: 'ring-green-500/20' },
  'in-progress': { bg: 'bg-yellow-500', ring: 'ring-yellow-500/20' },
  planned: { bg: 'bg-blue-400', ring: 'ring-blue-500/20' },
};

const railConfig = {
  released: 'border-border',
  'in-progress': 'border-yellow-500/30 border-dashed',
  planned: 'border-blue-400/20 border-dotted',
};

const cardHoverConfig = {
  released: 'hover:border-green-500/20 hover:shadow-lg',
  'in-progress': 'hover:border-yellow-500/20 hover:shadow-lg',
  planned: 'hover:border-blue-400/20 hover:shadow-lg',
};

const { bg, ring } = dotConfig[status];
const railClass = railConfig[status];
const cardHoverClass = cardHoverConfig[status];

const formattedDate = date
  ? date.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })
  : targetDate ?? null;

const hasBody = Astro.slots.has('default');
---

<div class="timeline-node group relative grid grid-cols-[1.75rem_1fr] sm:grid-cols-[2.5rem_1fr] gap-x-4">
  <!-- Left column: dot + rail -->
  <div class="flex flex-col items-center">
    <div class:list={[
      "relative z-10 mt-1.5 flex h-4 w-4 sm:h-5 sm:w-5 flex-shrink-0 items-center justify-center rounded-full ring-4",
      bg,
      ring,
    ]}>
      <span class="h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-white/80"></span>
    </div>
    {!isLast && (
      <div class:list={[
        "mt-2 flex-1 w-0 border-l-2 min-h-[2rem]",
        railClass
      ]}></div>
    )}
  </div>

  <!-- Right column: card -->
  <div class="pb-8">
    <article class:list={[
      "rounded-xl border border-border bg-card text-card-foreground shadow-sm",
      "transition-all duration-200",
      cardHoverClass,
    ]}>
      <!-- Card header -->
      <div class="flex flex-wrap items-start justify-between gap-3 p-4 sm:p-5 pb-3">
        <div class="flex flex-wrap items-center gap-2">
          {version && (
            <span class="font-mono text-sm font-bold text-primary">{version}</span>
          )}
          <StatusBadge status={status} />
          <TypeBadge type={type} />
        </div>
        {formattedDate && (
          date
            ? <time
                class="flex items-center gap-1.5 text-xs text-muted-foreground"
                datetime={date.toISOString()}
              >
                <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
                {formattedDate}
              </time>
            : <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
                {formattedDate}
              </span>
        )}
      </div>

      <!-- Card body -->
      <div class="px-4 sm:px-5 pb-2">
        <h3 class="text-base font-semibold text-foreground leading-snug mb-1">{title}</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">{description}</p>
      </div>

      <!-- Highlights -->
      {highlights.length > 0 && (
        <div class="px-4 sm:px-5 pb-4 pt-2">
          <ul class="grid gap-1.5 sm:grid-cols-2">
            {highlights.map((h) => (
              <li class="flex items-center gap-2 text-xs text-muted-foreground">
                <Icon name="lucide:check" class="w-3.5 h-3.5 flex-shrink-0 text-green-500" />
                {h}
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Rendered markdown body -->
      {hasBody && (
        <div class="changelog-prose border-t border-border/50 px-4 sm:px-5 py-4">
          <slot />
        </div>
      )}

      <!-- GitHub PR link -->
      {githubPr && (
        <div class="border-t border-border/50 px-4 sm:px-5 py-3">
          <a
            href={githubPr}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors"
          >
            <Icon name="simple-icons:github" class="w-3.5 h-3.5" />
            View pull request
            <Icon name="lucide:external-link" class="w-3 h-3" />
          </a>
        </div>
      )}
    </article>
  </div>
</div>
