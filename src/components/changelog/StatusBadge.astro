---
interface Props {
  status: 'released' | 'in-progress' | 'planned';
}

const { status } = Astro.props;

// Pill tones follow the app's SeverityBadge.
const config = {
  released: { label: 'Released', badge: 'border-success/30 bg-success/15 text-success-text', dot: 'bg-success' },
  'in-progress': { label: 'In Progress', badge: 'border-warning/30 bg-warning/15 text-warning-text', dot: 'bg-warning' },
  planned: { label: 'Planned', badge: 'border-info/30 bg-info/15 text-info-text', dot: 'bg-info' },
};

const { label, badge, dot } = config[status];
---

<span class={`inline-flex items-center gap-1.5 rounded-full border px-2 py-px text-[11.5px] font-medium ${badge}`}>
  <span class={`h-1.5 w-1.5 rounded-full ${dot}`} aria-hidden="true"></span>
  {label}
</span>
