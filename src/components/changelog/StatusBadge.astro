---
import Badge from '../ui/Badge.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  status: 'released' | 'in-progress' | 'planned';
  showIcon?: boolean;
  class?: string;
}

const { status, showIcon = true, class: className = '' } = Astro.props;

const config = {
  released: {
    label: 'Released',
    colorClass: 'bg-green-500/10 text-green-600 dark:text-green-400 border-green-500/20',
    icon: 'lucide:check-circle',
  },
  'in-progress': {
    label: 'In Progress',
    colorClass: 'bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 border-yellow-500/20',
    icon: 'lucide:loader',
  },
  planned: {
    label: 'Planned',
    colorClass: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20',
    icon: 'lucide:clock',
  },
};

const { label, colorClass, icon } = config[status];
---

<Badge variant="outline" class={`${colorClass} ${className}`}>
  {showIcon && <Icon name={icon} class="w-3 h-3 mr-1" />}
  {label}
</Badge>
