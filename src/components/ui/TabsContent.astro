---
interface Props {
  value: string;
  class?: string;
}
const { value, class: className = "" } = Astro.props;
---
<div
  data-tab-content={value}
  class:list={["mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hidden", className]}
>
  <slot />
</div>
