---
interface Props {
  value: string;
  class?: string;
}
const { value, class: className = "" } = Astro.props;
---
<button
  type="button"
  data-tab-trigger={value}
  class:list={[
    "inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 hover:bg-background/50 hover:text-foreground",
    className
  ]}
>
  <slot />
</button>
