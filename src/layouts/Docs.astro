---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsTableOfContents from '../components/docs/DocsTableOfContents.astro';
import Breadcrumbs from '../components/docs/Breadcrumbs.astro';
import { ViewTransitions } from 'astro:transitions';
import { Icon } from 'astro-icon/components';
import { execSync } from 'child_process';

interface Props {
  title?: string;
  description?: string;
  headings?: { id?: string; slug?: string; text: string; level?: number; depth?: number }[];
  frontmatter?: {
    title: string;
    description?: string;
  };
}

const { title: propTitle, description: propDescription, headings: propHeadings = [], frontmatter } = Astro.props;

const title = frontmatter?.title || propTitle || 'LogTide Documentation';
const description = frontmatter?.description || propDescription || 'LogTide Documentation';

// Normalize headings from MDX (slug/depth) or manual (id/level)
const headings = propHeadings.map(h => ({
  id: h.slug || h.id || '',
  text: h.text,
  level: h.depth || h.level || 2
}));

const pathname = Astro.url.pathname.replace(/\/$/, '');
const indexPages = ['/docs', '/docs/sdks', '/docs/migration'];
const isIndexPage = indexPages.includes(pathname);
const filePath = isIndexPage
  ? `src/pages${pathname}/index.astro`
  : `src/pages${pathname}.astro`;
const editUrl = `https://github.com/logtide-dev/logtide.dev/edit/main/${filePath}`;
let lastUpdated: string | null = null;
try {
  const gitDate = execSync(`git log -1 --format="%ci" -- ${filePath}`, { encoding: 'utf-8' }).trim();
  if (gitDate) {
    const date = new Date(gitDate);
    lastUpdated = date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  }
} catch {
  // Git command failed (not a git repo, file not committed, etc.)
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title} | LogTide Docs</title>
    <ViewTransitions />
    <script is:inline>
      // Theme detection (runs before page renders to prevent flash)
      (function() {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = localStorage.getItem('theme') || (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <div class="docs-layout">
      <!-- Mobile menu button -->
      <div class="mobile-menu-button lg:hidden">
        <button
          id="mobile-menu-toggle"
          class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          Menu
        </button>
      </div>

      <!-- Mobile sidebar overlay -->
      <div id="mobile-overlay" class="fixed inset-0 z-50 hidden bg-background/80 backdrop-blur-sm lg:hidden"></div>

      <!-- Mobile sidebar drawer -->
      <aside
        id="mobile-sidebar"
        class="fixed left-0 top-0 z-50 h-screen w-72 -translate-x-full transform overflow-y-auto border-r border-border bg-background transition-transform duration-300 ease-in-out lg:hidden"
      >
        <div class="flex items-center justify-between border-b border-border p-4">
          <span class="font-semibold">Documentation</span>
          <button id="mobile-menu-close" class="rounded p-1 hover:bg-muted">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <DocsSidebar mobile />
      </aside>

      <div class="docs-container">
        <DocsSidebar />

        <main class="docs-main">
          <div class="docs-content mx-auto max-w-4xl p-8">
            <Breadcrumbs />
            <slot />

            <div class="edit-page-link">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                {lastUpdated && (
                  <span class="text-sm text-muted-foreground">
                    Last updated: {lastUpdated}
                  </span>
                )}
                <a
                  href={editUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
                >
                  <Icon name="lucide:pencil" class="w-4 h-4" />
                  Edit this page on GitHub
                </a>
              </div>
            </div>
          </div>
        </main>

        <DocsTableOfContents headings={headings} />
      </div>
    </div>

    <Footer />

    <script>
      // Mobile menu toggle
      const toggle = document.getElementById('mobile-menu-toggle');
      const close = document.getElementById('mobile-menu-close');
      const overlay = document.getElementById('mobile-overlay');
      const sidebar = document.getElementById('mobile-sidebar');

      function openMenu() {
        sidebar?.classList.remove('-translate-x-full');
        sidebar?.classList.add('translate-x-0');
        overlay?.classList.remove('hidden');
      }

      function closeMenu() {
        sidebar?.classList.add('-translate-x-full');
        sidebar?.classList.remove('translate-x-0');
        overlay?.classList.add('hidden');
      }

      toggle?.addEventListener('click', openMenu);
      close?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', closeMenu);

      sidebar?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      document.querySelectorAll('.docs-content pre').forEach((preElement) => {
        const pre = preElement as HTMLElement;
        if (pre.closest('.code-block-wrapper')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper group relative my-6 rounded-lg border border-border bg-card overflow-hidden';

        const header = document.createElement('div');
        header.className = 'flex items-center justify-between border-b border-border bg-muted/50 px-4 py-2.5';
        
        let lang = 'text';
        if (pre.dataset.language) {
            lang = pre.dataset.language;
        } else if (pre.className.includes('language-')) {
            const match = pre.className.match(/language-([a-zA-Z0-9_-]+)/);
            if (match) lang = match[1];
        } else {
            const code = pre.querySelector('code');
            if (code) {
                if (code.dataset && code.dataset.language) {
                    lang = code.dataset.language;
                } else if (code.className.includes('language-')) {
                    const match = code.className.match(/language-([a-zA-Z0-9_-]+)/);
                    if (match) lang = match[1];
                }
            }
        }

        const leftSide = document.createElement('div');
        leftSide.className = 'flex items-center gap-3';
        leftSide.innerHTML = `
            <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-red-500/20 border border-red-500/50"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/20 border border-yellow-500/50"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-green-500/20 border border-green-500/50"></div>
            </div>
            <span class="text-xs font-mono text-muted-foreground uppercase"></span>
        `;
        const langSpan = leftSide.querySelector('span');
        if (langSpan) langSpan.textContent = lang;

        const copyBtn = document.createElement('button');
        copyBtn.className = 'opacity-60 hover:opacity-100 transition-opacity p-1';
        copyBtn.innerHTML = `
            <svg class="copy-icon h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            <svg class="check-icon h-4 w-4 text-green-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        `;
        copyBtn.addEventListener('click', async () => {
            const text = pre.innerText;
            await navigator.clipboard.writeText(text);
            
            const copyIcon = copyBtn.querySelector('.copy-icon');
            const checkIcon = copyBtn.querySelector('.check-icon');
            
            copyIcon?.classList.add('hidden');
            checkIcon?.classList.remove('hidden');
            
            setTimeout(() => {
                copyIcon?.classList.remove('hidden');
                checkIcon?.classList.add('hidden');
            }, 2000);
        });

        header.appendChild(leftSide);
        header.appendChild(copyBtn);
        wrapper.appendChild(header);
        
        // Move pre into wrapper
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);
        
        // Clean up pre styling to fit wrapper
        pre.className += ' !mt-0 !mb-0 !rounded-none !bg-secondary !border-none';
        pre.style.margin = '0';
    });

    // Enhance Tables
    document.querySelectorAll('.docs-content table').forEach((table) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'overflow-x-auto rounded-lg border border-border my-6';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
        table.className = 'w-full text-sm';
    });

    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tailwind.css';
  @import '../styles/custom.css';

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
  }

  code, pre {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-weight: 400;
  }

  .docs-layout {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 64px);
  }

  .docs-container {
    display: flex;
    flex: 1;
  }

  .docs-main {
    flex: 1;
    min-width: 0;
  }

  /* Docs Content Typography & Layout */
  .docs-content {
    width: 100%;
  }

  .docs-content > * + * {
    margin-top: 1.5em;
  }

  .docs-content h1 {
    @apply text-4xl font-bold mb-8 bg-gradient-to-r from-primary to-purple-400 bg-clip-text text-transparent leading-tight;
  }

  .docs-content h2 {
    @apply text-2xl font-semibold mt-12 mb-6 pb-2 border-b border-border scroll-mt-24;
  }

  .docs-content h3 {
    @apply text-xl font-semibold mb-0 scroll-mt-24;
  }

  .docs-content h4 {
    @apply text-lg font-semibold mt-6 mb-2;
  }

  .docs-content p {
    @apply leading-7;
  }

  .docs-content ul {
    @apply list-none space-y-2 mb-4 pl-0;
  }

  .docs-content ol {
    @apply list-none space-y-2 pl-0;
  }

  .docs-content li > p {
    @apply my-0;
  }

  .docs-content a:not(:has(button)):not(:has([role="heading"])):not(:has(.rounded-lg)):not(.block) {
    @apply font-medium text-primary underline underline-offset-4 decoration-primary/20 hover:decoration-primary transition-all cursor-pointer;
  }

  .docs-content a.block,
  .docs-content a:has(button) {
    @apply no-underline;
  }

  .docs-content blockquote {
    @apply pl-6 py-1 my-6 border-l-4 border-primary/20 italic text-muted-foreground bg-primary/5 rounded-r-lg;
  }

  /* Inline Code */
  .docs-content :not(pre) > code {
    @apply relative rounded bg-muted px-[0.3rem] py-[0.2rem] font-mono text-sm font-normal text-foreground;
  }

  /* Tables */
  .docs-content table {
    @apply w-full text-left border-collapse;
  }
  
  .docs-content thead {
    @apply bg-muted/50 text-foreground;
  }

  .docs-content th {
    @apply p-4 font-semibold border-b border-border;
  }

  .docs-content td {
    @apply p-4 border-b border-border text-muted-foreground;
  }

  .docs-content tr:last-child td {
    @apply border-0;
  }

  /* Fix for HTML divs inside Markdown (Grids/Cards) */
  .docs-content .grid {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  
  /* Reset spacing for elements inside Cards */
  .docs-content [class*="rounded-"] p,
  .docs-content [class*="rounded-"] h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }
  
  /* Pre styling overrides for standard Shiki output before JS wraps it */
  .docs-content pre {
    @apply p-4 rounded-lg overflow-x-auto bg-secondary border border-border my-6 font-normal;
  }

  .docs-content pre code {
    @apply font-normal;
  }

  .edit-page-link {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid hsl(var(--border));
  }

  .edit-page-link a {
    text-decoration: none !important;
  }

  /* Header and Footer alignment with sidebar spacing */
  .header-container,
  .footer-container {
    margin-left: 280px;
    margin-right: 240px;
  }

  @media (max-width: 1280px) {
    .header-container,
    .footer-container {
      margin-right: 0;
    }
  }

  @media (max-width: 1024px) {
    .header-container,
    .footer-container {
      margin-left: 0;
    }
  }

  @media (max-width: 1024px) {
    .docs-container {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .docs-content pre,
    .docs-content pre code,
    .docs-content .code-block-wrapper pre,
    .docs-content .code-block-wrapper code {
      font-size: 0.75rem;
      line-height: 1.5;
    }

    .docs-content .code-block-wrapper .text-xs {
      font-size: 0.625rem;
    }
  }
</style>