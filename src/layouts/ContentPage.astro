---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import FAQSection from '../components/content/FAQSection.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  ogImage?: string | null;
  breadcrumbs?: Array<{ name: string; url: string }>;
  datePublished?: string | null;
  dateModified?: string | null;
  keywords?: string[];
  faqs?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  ogImage = null,
  breadcrumbs = [],
  datePublished = null,
  dateModified = null,
  keywords = [],
  faqs = []
} = Astro.props;

const SITE_URL = 'https://logtide.dev';
const defaultOgImage = ogImage || `${SITE_URL}/docs/images/sections/guides.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      type="article"
      ogImage={defaultOgImage}
      breadcrumbs={breadcrumbs}
      datePublished={datePublished}
      dateModified={dateModified}
      keywords={keywords}
      faqs={faqs}
    />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        function applyTheme() {
          // Dark by default; the header toggle and the footer picker store
          // 'dark', 'light' or 'system' (follow the OS).
          const stored = localStorage.getItem('theme') || 'dark';
          const theme = stored === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : stored;
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main class="content-page relative">
      <div class="pointer-events-none absolute inset-x-0 top-0 hidden h-[560px] bg-[radial-gradient(45%_50%_at_25%_0%,hsl(var(--primary)/0.14),transparent_70%)] dark:block" aria-hidden="true"></div>
      <div class="dot-grid pointer-events-none absolute inset-x-0 top-0 h-[420px]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[77.5rem] px-4 pb-24 pt-12 sm:px-6 md:pb-36 md:pt-20 lg:px-10">
        <div class="content-container max-w-[46rem]">
          <slot />
          <FAQSection faqs={faqs} />
        </div>
      </div>
    </main>

    <Footer />

    <script>
      // Enhance code blocks
      document.querySelectorAll('.content-container pre').forEach((preElement) => {
        const pre = preElement as HTMLElement;
        if (pre.closest('.code-block-wrapper')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper group relative my-6 rounded-xl border border-foreground/[0.08] bg-card overflow-hidden';

        const header = document.createElement('div');
        header.className = 'flex items-center justify-between border-b border-foreground/[0.08] bg-muted/50 px-4 py-2.5';

        let lang = 'text';
        if (pre.dataset.language) {
          lang = pre.dataset.language;
        } else if (pre.className.includes('language-')) {
          const match = pre.className.match(/language-([a-zA-Z0-9_-]+)/);
          if (match) lang = match[1];
        } else {
          const code = pre.querySelector('code');
          if (code) {
            if (code.dataset && code.dataset.language) {
              lang = code.dataset.language;
            } else if (code.className.includes('language-')) {
              const match = code.className.match(/language-([a-zA-Z0-9_-]+)/);
              if (match) lang = match[1];
            }
          }
        }

        const leftSide = document.createElement('div');
        leftSide.className = 'flex items-center gap-3';
        leftSide.innerHTML = `
          <span class="text-xs font-mono text-muted-foreground uppercase"></span>
        `;
        const langSpan = leftSide.querySelector('span');
        if (langSpan) langSpan.textContent = lang;

        const copyBtn = document.createElement('button');
        copyBtn.className = 'opacity-60 hover:opacity-100 transition-opacity p-1';
        copyBtn.setAttribute('aria-label', 'Copy code');
        copyBtn.innerHTML = `
          <svg class="copy-icon h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
          <svg class="check-icon h-4 w-4 text-success-text hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        `;
        copyBtn.addEventListener('click', async () => {
          const text = pre.innerText;
          await navigator.clipboard.writeText(text);

          const copyIcon = copyBtn.querySelector('.copy-icon');
          const checkIcon = copyBtn.querySelector('.check-icon');

          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');

          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
          }, 2000);
        });

        header.appendChild(leftSide);
        header.appendChild(copyBtn);
        wrapper.appendChild(header);

        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        pre.className += ' !mt-0 !mb-0 !rounded-none !bg-secondary !border-none';
        pre.style.margin = '0';
      });

      // Enhance Tables
      document.querySelectorAll('.content-container table').forEach((table) => {
        if (table.closest('.overflow-x-auto')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'overflow-x-auto rounded-xl border border-foreground/[0.08] my-6';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
        table.className = 'w-full text-sm';
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tailwind.css';
  @import '../styles/custom.css';



  code, pre {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-weight: 400;
  }

  /* Header and Footer alignment */

  .content-page {
    min-height: calc(100vh - 64px - 200px);
  }

  /* Content Typography */
  .content-container h1 {
    @apply mb-5 text-[clamp(2.25rem,1.4rem+3vw,3.75rem)] font-bold leading-[0.95] tracking-[-0.032em] text-foreground;
  }

  .content-container h2 {
    @apply mb-5 mt-14 scroll-mt-24 border-t border-foreground/[0.08] pt-8 text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-bold leading-[1.1] tracking-[-0.025em];
  }

  .content-container h3 {
    @apply text-xl font-semibold mt-8 mb-4 scroll-mt-24 tracking-[-0.015em];
  }

  .content-container h4 {
    @apply text-lg font-semibold mt-6 mb-2;
  }

  .content-container p {
    @apply leading-7;
  }

  .content-container > * + * {
    margin-top: 1.5em;
  }

  .content-container .prose-content ul {
    @apply list-disc list-inside space-y-2 mb-4;
  }

  .content-container .prose-content ol {
    @apply list-decimal list-inside space-y-2 mb-4;
  }

  .content-container .prose-content li > p {
    @apply my-0 inline;
  }

  .content-container .prose-content a {
    @apply font-medium text-primary-readable underline underline-offset-4 decoration-primary/20 hover:decoration-primary transition-all cursor-pointer;
  }

  .content-container blockquote {
    @apply pl-6 py-1 my-6 border-l-2 border-primary-readable/45 text-muted-foreground bg-primary/[0.06] rounded-r-[10px];
  }

  .content-container :not(pre) > code {
    @apply relative rounded bg-muted px-[0.3rem] py-[0.2rem] font-mono text-sm font-normal text-foreground;
  }

  .content-container table {
    @apply w-full text-left border-collapse;
  }

  .content-container thead {
    @apply bg-muted/50 text-foreground;
  }

  .content-container th {
    /* Plain font-size: `@apply text-xs` is circular here because this block
       also styles `.text-xs` (code block labels, below). */
    @apply p-4 font-mono font-medium border-b border-foreground/[0.08];
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .content-container td {
    @apply p-4 border-b border-foreground/[0.08] text-muted-foreground;
  }

  .content-container tr:last-child td {
    @apply border-0;
  }

  .content-container pre {
    @apply p-4 rounded-xl overflow-x-auto bg-secondary border border-foreground/[0.08] my-6 font-normal;
  }

  .content-container pre code {
    @apply font-normal;
  }

  @media (max-width: 640px) {
    .content-container pre,
    .content-container pre code,
    .content-container .code-block-wrapper pre,
    .content-container .code-block-wrapper code {
      font-size: 0.75rem;
      line-height: 1.5;
    }

    .content-container .code-block-wrapper .text-xs {
      font-size: 0.625rem;
    }
  }
</style>
