---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
import Badge from '../../components/ui/Badge.astro';
import TimelineNode from '../../components/changelog/TimelineNode.astro';
import YearGroup from '../../components/changelog/YearGroup.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

const allEntries = await getCollection('changelog', ({ data }) => !data.draft);

// Sort: in-progress first, then planned (by version ascending), then released by date descending
const statusOrder: Record<string, number> = {
  'in-progress': 0,
  planned: 1,
  released: 2,
};

const sorted = allEntries.sort((a, b) => {
  const statusDiff = statusOrder[a.data.status] - statusOrder[b.data.status];
  if (statusDiff !== 0) return statusDiff;
  // For roadmap items (in-progress/planned), sort by version ascending
  if (a.data.status !== 'released') {
    return (a.data.version ?? '').localeCompare(b.data.version ?? '', undefined, { numeric: true });
  }
  // For released items, sort by date descending
  const dateA = a.data.date?.getTime() ?? 0;
  const dateB = b.data.date?.getTime() ?? 0;
  return dateB - dateA;
});

// Bodies are NOT rendered here: each release links to its own page instead.
// Keeping ~50 releases' worth of markdown on this page made it a 20k+ word
// long-tail impression magnet in search with a near-zero CTR.

// Group entries: Roadmap (planned + in-progress) and years (released)
type Group = {
  label: string;
  isRoadmap: boolean;
  entries: typeof sorted;
};

const groups: Group[] = [];

const roadmapEntries = sorted.filter(
  (entry) => entry.data.status === 'planned' || entry.data.status === 'in-progress'
);
const releasedEntries = sorted.filter(
  (entry) => entry.data.status === 'released'
);

if (roadmapEntries.length > 0) {
  groups.push({ label: 'Roadmap', isRoadmap: true, entries: roadmapEntries });
}

// Group released by year
const byYear = new Map<string, typeof sorted>();
for (const entry of releasedEntries) {
  const year = entry.data.date
    ? String(entry.data.date.getFullYear())
    : 'Undated';
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(entry);
}

const sortedYears = [...byYear.keys()].sort((a, b) => Number(b) - Number(a));
for (const year of sortedYears) {
  groups.push({ label: year, isRoadmap: false, entries: byYear.get(year)! });
}

const totalReleased = releasedEntries.length;
const totalPlanned = roadmapEntries.length;
const latestVersion = releasedEntries[0]?.data.version ?? null;

// Entries with a markdown body have their own page under /changelog/<id>/.
const hasDetailPage = (entry: (typeof sorted)[number]) =>
  (entry.body ?? '').trim().length > 0;

const title = "LogTide Changelog - What's New & Roadmap";
const description = "What's new in LogTide, the self-hosted log management platform: latest releases, fixes, features in progress, and the public roadmap.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      type="website"
      ogImage="https://logtide.dev/images/changelogs.png"
      keywords={["LogTide changelog", "product updates", "new features", "bug fixes", "log management roadmap", "open source security updates"]}
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        function applyTheme() {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = localStorage.getItem('theme') || (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main class="mx-auto max-w-3xl px-6 py-16">
      <!-- Hero Section -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold mb-4 text-foreground">
          Changelog & Roadmap
        </h1>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
          What we've shipped and what's coming next.
        </p>
      </div>

      <!-- Stats -->
      <div class="mb-12 grid grid-cols-3 gap-px overflow-hidden rounded-xl border border-border bg-border">
        <div class="bg-card p-5">
          <div class="font-mono text-2xl font-bold text-foreground">{totalReleased}</div>
          <div class="mt-1 text-xs text-muted-foreground">Releases</div>
        </div>
        <div class="bg-card p-5">
          <div class="font-mono text-2xl font-bold text-foreground">{latestVersion ?? '-'}</div>
          <div class="mt-1 text-xs text-muted-foreground">Latest</div>
        </div>
        <div class="bg-card p-5">
          <div class="font-mono text-2xl font-bold text-foreground">{totalPlanned}</div>
          <div class="mt-1 text-xs text-muted-foreground">Planned</div>
        </div>
      </div>

      <!-- Status Legend -->
      <div class="flex flex-wrap gap-3 mb-10">
        <Badge variant="outline" class="bg-green-500/10 text-green-600 dark:text-green-400 border-green-500/20">
          <Icon name="lucide:check-circle" class="w-3 h-3 mr-1" />
          Released
        </Badge>
        <Badge variant="outline" class="bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 border-yellow-500/20">
          <Icon name="lucide:loader" class="w-3 h-3 mr-1" />
          In Progress
        </Badge>
        <Badge variant="outline" class="bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20">
          <Icon name="lucide:clock" class="w-3 h-3 mr-1" />
          Planned
        </Badge>
      </div>

      <!-- Timeline -->
      <div class="relative">
        {groups.map((group, groupIndex) => {
          const isLastGroup = groupIndex === groups.length - 1;

          return (
            <>
              <YearGroup label={group.label} isRoadmap={group.isRoadmap} />
              {group.entries.map((entry, entryIndex) => {
                const isLastEntry = isLastGroup && entryIndex === group.entries.length - 1;
                return (
                  <TimelineNode
                    entry={entry}
                    isLast={isLastEntry}
                    detailUrl={hasDetailPage(entry) ? `/changelog/${entry.id}/` : undefined}
                  />
                );
              })}
            </>
          );
        })}

        {sorted.length === 0 && (
          <div class="text-center py-16 text-muted-foreground">
            <Icon name="lucide:scroll-text" class="w-12 h-12 mx-auto mb-4 opacity-40" />
            <p>No changelog entries yet.</p>
          </div>
        )}
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center p-8 rounded-2xl bg-card border border-border">
        <h2 class="text-xl font-semibold mb-3">Have a feature request?</h2>
        <p class="text-muted-foreground mb-5 text-sm max-w-sm mx-auto">
          Open a discussion on GitHub or vote on existing proposals to help shape the roadmap.
        </p>
        <a
          href="https://github.com/logtide-dev/logtide/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground rounded-lg hover:bg-primary-600 transition-colors text-sm font-medium"
        >
          <Icon name="lucide:message-circle" class="w-4 h-4" />
          Open a Discussion
        </a>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  @import '../../styles/tailwind.css';
  @import '../../styles/custom.css';



</style>
