---
import { getCollection, render } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
import Badge from '../../components/ui/Badge.astro';
import TimelineNode from '../../components/changelog/TimelineNode.astro';
import YearGroup from '../../components/changelog/YearGroup.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

const allEntries = await getCollection('changelog', ({ data }) => !data.draft);

// Sort: in-progress first, then planned (by version ascending), then released by date descending
const statusOrder: Record<string, number> = {
  'in-progress': 0,
  planned: 1,
  released: 2,
};

const sorted = allEntries.sort((a, b) => {
  const statusDiff = statusOrder[a.data.status] - statusOrder[b.data.status];
  if (statusDiff !== 0) return statusDiff;
  // For roadmap items (in-progress/planned), sort by version ascending
  if (a.data.status !== 'released') {
    return (a.data.version ?? '').localeCompare(b.data.version ?? '', undefined, { numeric: true });
  }
  // For released items, sort by date descending
  const dateA = a.data.date?.getTime() ?? 0;
  const dateB = b.data.date?.getTime() ?? 0;
  return dateB - dateA;
});

// Render all markdown bodies
const rendered = await Promise.all(
  sorted.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

// Group entries: Roadmap (planned + in-progress) and years (released)
type Group = {
  label: string;
  isRoadmap: boolean;
  entries: typeof rendered;
};

const groups: Group[] = [];

const roadmapEntries = rendered.filter(
  ({ entry }) => entry.data.status === 'planned' || entry.data.status === 'in-progress'
);
const releasedEntries = rendered.filter(
  ({ entry }) => entry.data.status === 'released'
);

if (roadmapEntries.length > 0) {
  groups.push({ label: 'Roadmap', isRoadmap: true, entries: roadmapEntries });
}

// Group released by year
const byYear = new Map<string, typeof rendered>();
for (const item of releasedEntries) {
  const year = item.entry.data.date
    ? String(item.entry.data.date.getFullYear())
    : 'Undated';
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(item);
}

const sortedYears = [...byYear.keys()].sort((a, b) => Number(b) - Number(a));
for (const year of sortedYears) {
  groups.push({ label: year, isRoadmap: false, entries: byYear.get(year)! });
}

const totalReleased = releasedEntries.length;
const totalPlanned = roadmapEntries.length;
const latestVersion = releasedEntries[0]?.entry.data.version ?? null;

const title = 'Changelog & Roadmap | LogTide';
const description = 'Track what we have shipped and what is coming next. Released versions, improvements in progress, and planned features for LogTide.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <SEO
      title={title}
      description={description}
      type="website"
      ogImage="https://logtide.dev/docs/images/sections/guides.png"
      keywords={["LogTide changelog", "product updates", "new features", "bug fixes", "log management roadmap", "open source security updates"]}
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        function applyTheme() {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = localStorage.getItem('theme') || (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main class="mx-auto max-w-3xl px-6 py-16">
      <!-- Hero Section -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold mb-4 bg-gradient-to-r from-primary to-purple-400 bg-clip-text text-transparent">
          Changelog & Roadmap
        </h1>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
          What we've shipped and what's coming next.
        </p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4 mb-12">
        <div class="text-center p-4 rounded-lg bg-card border border-border">
          <div class="text-2xl font-bold text-primary">{totalReleased}</div>
          <div class="text-xs text-muted-foreground">Releases</div>
        </div>
        <div class="text-center p-4 rounded-lg bg-card border border-border">
          <div class="text-2xl font-bold text-green-500">{latestVersion ?? '\u2014'}</div>
          <div class="text-xs text-muted-foreground">Latest</div>
        </div>
        <div class="text-center p-4 rounded-lg bg-card border border-border">
          <div class="text-2xl font-bold text-blue-500">{totalPlanned}</div>
          <div class="text-xs text-muted-foreground">Planned</div>
        </div>
      </div>

      <!-- Status Legend -->
      <div class="flex flex-wrap gap-3 mb-10">
        <Badge variant="outline" class="bg-green-500/10 text-green-600 dark:text-green-400 border-green-500/20">
          <Icon name="lucide:check-circle" class="w-3 h-3 mr-1" />
          Released
        </Badge>
        <Badge variant="outline" class="bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 border-yellow-500/20">
          <Icon name="lucide:loader" class="w-3 h-3 mr-1" />
          In Progress
        </Badge>
        <Badge variant="outline" class="bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20">
          <Icon name="lucide:clock" class="w-3 h-3 mr-1" />
          Planned
        </Badge>
      </div>

      <!-- Timeline -->
      <div class="relative">
        {groups.map((group, groupIndex) => {
          const isLastGroup = groupIndex === groups.length - 1;

          return (
            <>
              <YearGroup label={group.label} isRoadmap={group.isRoadmap} />
              {group.entries.map((item, entryIndex) => {
                const isLastEntry = isLastGroup && entryIndex === group.entries.length - 1;
                return (
                  <TimelineNode
                    entry={item.entry}
                    isLast={isLastEntry}
                  >
                    <item.Content />
                  </TimelineNode>
                );
              })}
            </>
          );
        })}

        {sorted.length === 0 && (
          <div class="text-center py-16 text-muted-foreground">
            <Icon name="lucide:scroll-text" class="w-12 h-12 mx-auto mb-4 opacity-40" />
            <p>No changelog entries yet.</p>
          </div>
        )}
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center p-8 rounded-2xl bg-gradient-to-r from-primary/10 to-purple-500/10 border border-primary/20">
        <h2 class="text-xl font-semibold mb-3">Have a feature request?</h2>
        <p class="text-muted-foreground mb-5 text-sm max-w-sm mx-auto">
          Open a discussion on GitHub or vote on existing proposals to help shape the roadmap.
        </p>
        <a
          href="https://github.com/logtide-dev/logtide/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors text-sm font-medium"
        >
          <Icon name="lucide:message-circle" class="w-4 h-4" />
          Open a Discussion
        </a>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  @import '../../styles/tailwind.css';
  @import '../../styles/custom.css';

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
  }

  .header-container,
  .footer-container {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  /* Changelog prose styles for rendered markdown inside timeline cards */
  .changelog-prose h2 {
    @apply text-sm font-semibold mt-4 mb-2 text-foreground;
  }

  .changelog-prose h3 {
    @apply text-xs font-semibold mt-3 mb-1 text-foreground;
  }

  .changelog-prose p {
    @apply text-sm text-muted-foreground mb-2 leading-relaxed;
  }

  .changelog-prose p:last-child {
    @apply mb-0;
  }

  .changelog-prose ul {
    @apply list-disc list-inside text-sm text-muted-foreground space-y-1 mb-2;
  }

  .changelog-prose ol {
    @apply list-decimal list-inside text-sm text-muted-foreground space-y-1 mb-2;
  }

  .changelog-prose li > strong {
    @apply text-foreground;
  }

  .changelog-prose pre {
    @apply rounded-lg text-xs overflow-x-auto my-3 p-3 bg-secondary border border-border;
  }

  .changelog-prose code:not(pre code) {
    @apply bg-muted text-foreground rounded px-1 py-0.5 text-xs font-mono;
  }

  .changelog-prose a {
    @apply text-primary hover:underline;
  }

  .changelog-prose > *:first-child {
    @apply mt-0;
  }
</style>
