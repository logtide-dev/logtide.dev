---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import StatusBadge from '../../components/changelog/StatusBadge.astro';
import TypeBadge from '../../components/changelog/TypeBadge.astro';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const entries = await getCollection('changelog', ({ data }) => !data.draft);
  // Only entries with a markdown body get their own page; frontmatter-only
  // entries (most roadmap items) are fully represented on the index.
  return entries
    .filter((entry) => (entry.body ?? '').trim().length > 0)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

interface Props {
  entry: CollectionEntry<'changelog'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { version, title, description, date, targetDate, status, highlights, githubPr } = entry.data;

const pageTitle = `${title} | LogTide Changelog`;

const rawPathname = Astro.url.pathname;
const pathname = rawPathname.endsWith('/') ? rawPathname : rawPathname + '/';

const seoBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Changelog', url: '/changelog/' },
  { name: title, url: pathname },
];

const formattedDate = date
  ? date.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })
  : targetDate ?? null;
---

<ContentPage
  title={pageTitle}
  description={description}
  ogImage="https://logtide.dev/images/changelogs.png"
  breadcrumbs={seoBreadcrumbs}
  datePublished={date ? date.toISOString() : null}
>
  <!-- Navigation breadcrumb -->
  <nav class="mb-8" aria-label="Breadcrumb">
    <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 font-mono text-xs text-muted-foreground">
      <li>
        <a href="/" class="transition-colors hover:text-foreground">Home</a>
      </li>
      <li class="text-muted-foreground/50">/</li>
      <li>
        <a href="/changelog/" class="transition-colors hover:text-foreground">Changelog</a>
      </li>
      <li class="text-muted-foreground/50">/</li>
      <li class="text-foreground line-clamp-1">{version ?? title}</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <header class="mb-10">
    <p class="font-mono text-xs text-primary-readable">changelog</p>
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
      {version && (
        <span class="font-mono text-sm font-semibold">{version}</span>
      )}
      <StatusBadge status={status} />
      <TypeBadge type={entry.data.type} />
      {formattedDate && (
        date
          ? <time datetime={date.toISOString()} class="font-mono text-xs text-muted-foreground">{formattedDate}</time>
          : <span class="font-mono text-xs text-muted-foreground">{formattedDate}</span>
      )}
    </div>

    <h1 class="mt-5">
      {title}
    </h1>

    <p class="text-lg text-muted-foreground">
      {description}
    </p>

    {highlights.length > 0 && (
      <ul class="m-0 mt-6 grid list-none gap-px overflow-hidden rounded-xl border border-foreground/[0.08] cell-grid p-0 sm:grid-cols-2">
        {highlights.map((h) => (
          <li class="bg-background px-4 py-3.5 text-[14.5px] text-foreground/85">{h}</li>
        ))}
      </ul>
    )}
  </header>

  <!-- Markdown Content -->
  <div class="prose-content">
    <Content />
  </div>

  <!-- Footer links -->
  <div class="mt-16 border-t border-foreground/[0.08] pt-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <a
        href="/changelog/"
        class="inline-flex items-center gap-2 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
      >
        <Icon name="lucide:arrow-left" class="w-4 h-4" />
        All releases
      </a>
      {githubPr && (
        <a
          href={githubPr}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
        >
          <Icon name="simple-icons:github" class="w-4 h-4" />
          View pull request
          <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
        </a>
      )}
    </div>
  </div>
</ContentPage>
