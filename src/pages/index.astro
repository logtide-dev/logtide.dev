---
import Layout from '../layouts/Landing.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import FeaturesSection from '../components/landing/FeaturesSection.astro';
import QuickStartSection from '../components/landing/QuickStartSection.astro';
import SDKsSection from '../components/landing/SDKsSection.astro';
import ExploreSection from '../components/landing/ExploreSection.astro';
import CTASection from '../components/landing/CTASection.astro';
---

<Layout
  title="LogTide - Privacy-first Log Management. Open Source."
  description="Open source alternative to Datadog and Splunk. GDPR compliant, self-hosted log management with Sigma rules for threat detection. Built in Europe."
>
  <Header />
  <main>
    <HeroSection />
    <FeaturesSection />
    <QuickStartSection />
    <SDKsSection />
    <ExploreSection />
    <CTASection />
  </main>
  <Footer />
</Layout>
