---
import Layout from '../layouts/Landing.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import FeaturesSection from '../components/landing/FeaturesSection.astro';
import QuickStartSection from '../components/landing/QuickStartSection.astro';
import SDKsSection from '../components/landing/SDKsSection.astro';
import DeploySection from '../components/landing/DeploySection.astro';
import CTASection from '../components/landing/CTASection.astro';
---

<Layout
  title="LogTide: Open-Source Log Management and SIEM, Self-Hosted"
  description="Open-source log management and SIEM you can self-host or run in our EU cloud. Logs, traces and Sigma threat detection, an alternative to Datadog and Splunk."
  keywords={["LogTide", "log management", "open source datadog alternative", "self-hosted logs", "GDPR log management", "Sigma rules", "SIEM", "threat detection"]}
>
  <Header />
  <main>
    <HeroSection />
    <SDKsSection />
    <FeaturesSection />
    <QuickStartSection />
    <DeploySection />
    <CTASection />
  </main>
  <Footer />
</Layout>
