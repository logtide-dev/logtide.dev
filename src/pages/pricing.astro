---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import FAQSection from '../components/content/FAQSection.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

const title = 'LogTide Cloud Pricing: Log Management and SIEM from $0 | LogTide';
const description =
  'Simple fixed pricing for LogTide Cloud. A real SIEM (Sigma rules, incidents, MITRE ATT&CK) and unlimited users in every plan. Free, Pro $29/month, Pro Plus $99/month.';
const keywords = [
  'logtide pricing',
  'log management pricing',
  'siem pricing',
  'managed log management',
  'log management free tier',
  'log management without per-user pricing',
];

const seoBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Pricing', url: '/pricing/' },
];

const signup = 'https://app.logtide.dev/register';

const plans = [
  {
    name: 'Free',
    tagline: 'For side projects and trying LogTide Cloud.',
    price: '$0',
    priceNote: 'forever',
    annual: null,
    cta: { label: 'Start for free', href: signup },
    highlight: false,
    limits: [
      '10 GB logs / month',
      '10M spans / month',
      '20M metric datapoints / month',
      '7-day retention',
      '2 projects',
      '5 alert rules',
      '5 notification channels',
    ],
    sso: false,
  },
  {
    name: 'Pro',
    tagline: 'For teams running production workloads.',
    price: '$29',
    priceNote: '/month',
    annual: '$24/month billed annually ($288/year)',
    cta: { label: 'Start with Pro', href: signup },
    highlight: true,
    limits: [
      '100 GB logs / month',
      '100M spans / month',
      '250M metric datapoints / month',
      '30-day retention',
      'Unlimited projects',
      'Unlimited alert rules',
      'Unlimited notification channels',
    ],
    sso: false,
  },
  {
    name: 'Pro Plus',
    tagline: 'For larger teams with compliance and SSO needs.',
    price: '$99',
    priceNote: '/month',
    annual: '$79/month billed annually ($948/year)',
    cta: { label: 'Start with Pro Plus', href: signup },
    highlight: false,
    limits: [
      '400 GB logs / month',
      '400M spans / month',
      '1B metric datapoints / month',
      '90-day retention',
      'Unlimited projects',
      'Unlimited alert rules',
      'Unlimited notification channels',
    ],
    sso: true,
  },
];

const siemIncluded = ['Sigma detection rules', 'Incidents', 'MITRE ATT&CK mapping'];

const faqs = [
  {
    question: 'What happens when I reach my monthly quota?',
    answer:
      'On paid plans you get a 10% margin over your quota and an immediate notice as soon as you reach it. After that margin, ingestion pauses until your monthly quota resets on the 1st of the next month (UTC) or until you upgrade. Quotas reset monthly, whether you pay monthly or annually. You are never charged extra: there are no surprise overage fees.',
  },
  {
    question: 'What about the Free plan?',
    answer:
      'The Free plan has fixed quotas and never charges you. Upgrade to Pro or Pro Plus whenever you need more volume or longer retention.',
  },
  {
    question: 'Is there per-user pricing?',
    answer:
      'No. Every plan includes unlimited users, so you can give the whole team access without changing your bill.',
  },
  {
    question: 'Is the SIEM really included in every plan?',
    answer:
      'Yes. Sigma detection rules, incidents and MITRE ATT&CK mapping are part of every plan, including Free. There is no separate security add-on.',
  },
  {
    question: 'Do prices include VAT?',
    answer:
      'No. Prices are shown excluding VAT. Applicable taxes are added at checkout, and you can provide a VAT ID if you are buying as a business.',
  },
  {
    question: 'How does annual billing work?',
    answer:
      'Pro is $29/month billed monthly, or $24/month billed annually ($288/year). Pro Plus is $99/month billed monthly, or $79/month billed annually ($948/year).',
  },
  {
    question: 'Can I cancel at any time?',
    answer:
      'Yes. You can cancel your subscription whenever you like. Consumers in the EU also have a statutory right of withdrawal, described in our Terms.',
  },
  {
    question: 'What if I need more than 400 GB per month?',
    answer: 'Contact us and we will put together a plan for your volume.',
  },
  {
    question: 'Should I self-host or use LogTide Cloud?',
    answer:
      'The same open-source core powers both. Self-hosting is free and gives you full control of your infrastructure; LogTide Cloud removes the operations work and gives you a hosted instance with fixed monthly pricing. Pick whichever fits your team.',
  },
  {
    question: 'Which plans include SSO?',
    answer: 'SSO (OIDC) is included in Pro Plus. Free and Pro do not include SSO.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      type="website"
      ogImage="https://logtide.dev/images/default.png"
      breadcrumbs={seoBreadcrumbs}
      keywords={keywords}
      faqs={faqs}
    />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyTheme() {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = localStorage.getItem('theme') || (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main>
      <section class="relative overflow-hidden px-6 py-16 md:py-24" aria-labelledby="hero-heading">
        <div class="relative mx-auto max-w-4xl text-center">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary-readable">
            <Icon name="lucide:shield-check" class="h-3.5 w-3.5" />
            SIEM included in every plan
          </div>
          <h1 id="hero-heading" class="mb-6 text-4xl font-bold tracking-tight md:text-5xl">
            A real SIEM at <span class="text-primary-readable">log management prices</span>
          </h1>
          <p class="mx-auto mb-4 max-w-2xl text-lg text-muted-foreground">
            Every LogTide Cloud plan includes Sigma detection, incidents and MITRE ATT&amp;CK mapping,
            with unlimited users. Fixed tiers, no per-user pricing, no surprise overage.
          </p>
          <p class="text-sm text-muted-foreground">All prices exclude VAT.</p>
        </div>
      </section>

      <section class="px-6 pb-16" aria-labelledby="plans-heading">
        <div class="mx-auto max-w-6xl">
          <h2 id="plans-heading" class="sr-only">Plans</h2>
          <div class="mb-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
            <span class="font-medium text-foreground">Included in every plan:</span>
            {siemIncluded.map((item) => (
              <span class="inline-flex items-center gap-1.5">
                <Icon name="lucide:check" class="h-4 w-4 text-primary-readable" />
                {item}
              </span>
            ))}
          </div>
          <div class="grid gap-6 lg:grid-cols-3">
            {plans.map((plan) => (
              <article
                class:list={[
                  'flex flex-col rounded-2xl border bg-card p-6',
                  plan.highlight ? 'border-primary ring-1 ring-primary' : 'border-border',
                ]}
              >
                <h3 class="text-xl font-semibold">{plan.name}</h3>
                <p class="mb-4 mt-1 text-sm text-muted-foreground">{plan.tagline}</p>
                <p class="flex items-baseline gap-1">
                  <span class="text-4xl font-bold tracking-tight">{plan.price}</span>
                  <span class="text-muted-foreground">{plan.priceNote}</span>
                </p>
                <p class="mb-6 mt-1 min-h-[1.25rem] text-sm text-muted-foreground">
                  {plan.annual ? `or ${plan.annual}` : 'No credit card required'}
                </p>
                <a
                  href={plan.cta.href}
                  class:list={[
                    'mb-6 inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 font-medium transition-colors',
                    plan.highlight
                      ? 'bg-primary text-primary-foreground hover:bg-primary-600'
                      : 'border border-border bg-card text-foreground hover:bg-muted',
                  ]}
                >
                  {plan.cta.label}
                </a>
                <ul class="space-y-2.5 text-sm">
                  <li class="flex items-start gap-2">
                    <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary-readable" />
                    <span>Full SIEM (Sigma rules, incidents, MITRE ATT&amp;CK)</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary-readable" />
                    <span>Unlimited users</span>
                  </li>
                  {plan.limits.map((limit) => (
                    <li class="flex items-start gap-2">
                      <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary-readable" />
                      <span>{limit}</span>
                    </li>
                  ))}
                  {plan.sso && (
                    <li class="flex items-start gap-2">
                      <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary-readable" />
                      <span>SSO (OIDC)</span>
                    </li>
                  )}
                </ul>
              </article>
            ))}
          </div>

          <div class="mt-8 rounded-2xl border border-border bg-muted/30 p-6 text-center">
            <p class="font-medium">Need more than 400 GB per month?</p>
            <p class="mt-1 text-sm text-muted-foreground">
              <a href="/contact/" class="text-primary-readable hover:underline">Contact us</a> and we will size a plan for your volume.
            </p>
          </div>
        </div>
      </section>

      <section class="border-t border-border bg-muted/30 px-6 py-16" aria-labelledby="quota-heading">
        <div class="mx-auto max-w-3xl text-center">
          <h2 id="quota-heading" class="mb-4 text-3xl font-bold">No surprise charges</h2>
          <p class="text-lg text-muted-foreground">
            When you reach your quota, paid plans get a 10% margin and an immediate notice. After that,
            ingestion pauses until your monthly quota resets on the 1st of the next month (UTC) or until you upgrade. You are never billed more than your plan price.
          </p>
        </div>
      </section>

      <section class="px-6 py-16" aria-labelledby="selfhost-heading">
        <div class="mx-auto max-w-3xl text-center">
          <h2 id="selfhost-heading" class="mb-4 text-3xl font-bold">Prefer to run it yourself?</h2>
          <p class="mb-8 text-lg text-muted-foreground">
            LogTide is open source and self-hosting is free.
          </p>
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a
              href="/docs/getting-started/"
              class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3 font-medium text-foreground transition-colors hover:bg-muted"
            >
              Self-hosting guide
              <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
            <a
              href="/self-hosted-log-management/"
              class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3 font-medium text-foreground transition-colors hover:bg-muted"
            >
              Why self-host
            </a>
          </div>
        </div>
      </section>

      <section class="border-t border-border px-6 py-20" aria-labelledby="faq-wrap">
        <div class="mx-auto max-w-3xl">
          <h2 id="faq-wrap" class="sr-only">Pricing FAQ</h2>
          <FAQSection faqs={faqs} title="Pricing: FAQ" />
        </div>
      </section>
    </main>

    <Footer />

    <style is:global>
      @import '../styles/tailwind.css';
      @import '../styles/custom.css';
    </style>
  </body>
</html>
