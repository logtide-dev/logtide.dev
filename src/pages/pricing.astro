---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';
import { EU_COUNTRIES, TIMEZONE_COUNTRY } from '../data/eu-vat-rates';

const countryOptions = Object.entries(EU_COUNTRIES)
  .map(([code, c]) => ({ code, name: c.name }))
  .sort((a, b) => a.name.localeCompare(b.name));
const clientData = JSON.stringify({ countries: EU_COUNTRIES, timezones: TIMEZONE_COUNTRY });

const title = 'LogTide Cloud Pricing: Log Management and SIEM from $0 | LogTide';
const description =
  'Simple fixed pricing for LogTide Cloud. A real SIEM (Sigma rules, incidents, MITRE ATT&CK) and unlimited users in every plan. Free (10 GB/month), Pro $29/month (100 GB), Pro Plus $99/month (400 GB). One combined quota for logs, traces and metrics.';
const keywords = [
  'logtide pricing',
  'log management pricing',
  'siem pricing',
  'managed log management',
  'log management free tier',
  'log management without per-user pricing',
];

const seoBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Pricing', url: '/pricing/' },
];

const signup = 'https://app.logtide.dev/register';

const plans = [
  {
    name: 'Free',
    tagline: 'For side projects and trying LogTide Cloud.',
    price: '$0',
    priceNote: 'forever',
    annual: null,
    monthly: 0,
    annualMonthly: 0,
    annualTotal: 0,
    cta: { label: 'Start for free', href: signup },
    highlight: false,
    limits: [
      '10 GB / month of logs, traces and metrics',
      '7-day retention',
      '2 projects',
      '5 alert rules',
      '5 notification channels',
    ],
    sso: false,
  },
  {
    name: 'Pro',
    tagline: 'For teams running production workloads.',
    price: '$29',
    priceNote: '/month',
    annual: '$24/month billed annually ($288/year)',
    monthly: 29,
    annualMonthly: 24,
    annualTotal: 288,
    cta: { label: 'Start with Pro', href: signup },
    highlight: true,
    limits: [
      '100 GB / month of logs, traces and metrics',
      '30-day retention',
      'Unlimited projects',
      'Unlimited alert rules',
      'Unlimited notification channels',
    ],
    sso: false,
  },
  {
    name: 'Pro Plus',
    tagline: 'For teams that need 90-day retention.',
    price: '$99',
    priceNote: '/month',
    annual: '$79/month billed annually ($948/year)',
    monthly: 99,
    annualMonthly: 79,
    annualTotal: 948,
    cta: { label: 'Start with Pro Plus', href: signup },
    highlight: false,
    limits: [
      '400 GB / month of logs, traces and metrics',
      '90-day retention',
      'Unlimited projects',
      'Unlimited alert rules',
      'Unlimited notification channels',
    ],
    sso: true,
  },
];

const siemIncluded = ['Sigma detection rules', 'Incidents', 'MITRE ATT&CK mapping'];

const faqs = [
  {
    question: 'How is usage measured?',
    answer:
      'Usage is the size of the data we store for you: each log record, span and metric datapoint as JSON, before compression, summed across all three signals. The quota resets on the 1st of each month (UTC). A typical log line is 300 bytes to 1 KB, so 100 GB is roughly 100 to 350 million log lines per month. Metric ingestion is subject to fair use.',
  },
  {
    question: 'What happens when I reach my monthly quota?',
    answer:
      'Your monthly quota is the combined total across logs, traces and metrics. On paid plans you get a 10% margin over your quota and an immediate notice as soon as you reach it. After that margin, ingestion pauses until your monthly quota resets on the 1st of the next month (UTC) or until you upgrade. Quotas reset monthly, whether you pay monthly or annually. You are never charged extra: there are no surprise overage fees.',
  },
  {
    question: 'What about the Free plan?',
    answer:
      'The Free plan has fixed quotas and never charges you. Upgrade to Pro or Pro Plus whenever you need more volume or longer retention.',
  },
  {
    question: 'Is there per-user pricing?',
    answer:
      'No. Every plan includes unlimited users, so you can give the whole team access without changing your bill.',
  },
  {
    question: 'Is the SIEM really included in every plan?',
    answer:
      'Yes. Sigma detection rules, incidents and MITRE ATT&CK mapping are part of every plan, including Free. There is no separate security add-on.',
  },
  {
    question: 'Do prices include VAT?',
    answer:
      'It depends on who you are. Consumers in the EU see prices including the VAT of their country. Businesses see prices excluding VAT, and EU businesses with a valid VAT ID pay no VAT (reverse charge). Outside the EU, applicable taxes are added at checkout. The exact VAT is always calculated at checkout by Stripe Tax; use the selector above the plans to see prices for your situation.',
  },
  {
    question: 'How does annual billing work?',
    answer:
      'Pro is $29/month billed monthly, or $24/month billed annually ($288/year). Pro Plus is $99/month billed monthly, or $79/month billed annually ($948/year). These are prices excluding VAT; EU consumers see the VAT-inclusive amount for their country in the price selector.',
  },
  {
    question: 'Can I cancel at any time?',
    answer:
      'Yes. You can cancel your subscription whenever you like. Consumers in the EU also have a statutory right of withdrawal, described in our Terms.',
  },
  {
    question: 'What if I need more volume or longer retention?',
    answer: 'Contact us and we will put together a custom plan for your data volume and retention needs.',
  },
  {
    question: 'Should I self-host or use LogTide Cloud?',
    answer:
      'The same open-source core powers both. Self-hosting is free and gives you full control of your infrastructure; LogTide Cloud removes the operations work and gives you a hosted instance with fixed monthly pricing. Pick whichever fits your team.',
  },
  {
    question: 'Which plans include SSO?',
    answer: 'Per-organization SSO (OIDC) is coming soon and will be included in Pro Plus. It is not available on any plan yet.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      type="website"
      ogImage="https://logtide.dev/images/default.png"
      breadcrumbs={seoBreadcrumbs}
      keywords={keywords}
      faqs={faqs}
    />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyTheme() {
          // Dark by default; the header toggle and the footer picker store
          // 'dark', 'light' or 'system' (follow the OS).
          const stored = localStorage.getItem('theme') || 'dark';
          const theme = stored === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : stored;
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main>
      <section class="relative" aria-labelledby="hero-heading">
        <div class="pointer-events-none absolute inset-x-0 -top-16 hidden h-[760px] bg-[radial-gradient(50%_45%_at_50%_0%,hsl(var(--primary)/0.24),transparent_70%)] dark:block" aria-hidden="true"></div>
        <div class="dot-grid pointer-events-none absolute inset-x-0 -top-16 h-[620px]" aria-hidden="true"></div>

        <div class="relative mx-auto max-w-[77.5rem] px-4 pt-16 sm:px-6 md:pt-28 lg:px-10">
          <p class="font-mono text-xs text-primary-readable">pricing · logtide cloud</p>
          <h1 id="hero-heading" class="mt-4 max-w-[15ch] text-[clamp(2.75rem,1.6rem+4.4vw,5.25rem)] font-bold leading-[0.95] tracking-[-0.032em]">
            Fixed prices. The SIEM is in every plan.
          </h1>
          <p class="mt-6 max-w-[58ch] text-lg text-muted-foreground">
            One combined quota for logs, traces and metrics. Sigma detection, incidents and MITRE ATT&amp;CK
            mapping with unlimited users on every plan, and never an overage fee.
          </p>

          <h2 id="plans-heading" class="sr-only">Plans</h2>
          <div id="price-controls" class="mt-12 flex flex-wrap items-center justify-between gap-x-5 gap-y-3 text-sm">
            <div class="inline-flex rounded-[10px] border border-border bg-card p-1" role="group" aria-label="Billing period">
              <button type="button" data-billing="monthly" aria-pressed="false" class="h-9 rounded-[7px] px-4 font-medium text-muted-foreground transition-colors aria-pressed:bg-nav-active aria-pressed:text-nav-active-foreground">Monthly</button>
              <button type="button" data-billing="annual" aria-pressed="true" class="flex h-9 items-center gap-2 rounded-[7px] px-4 font-medium text-muted-foreground transition-colors aria-pressed:bg-nav-active aria-pressed:text-nav-active-foreground">
                Annual <span class="font-mono text-[11px] text-success-text">save up to 20%</span>
              </button>
            </div>
            <div class="flex flex-wrap items-center gap-2.5 text-muted-foreground">
              <span>Prices for</span>
              <div class="inline-flex rounded-[10px] border border-border bg-card p-1" role="group" aria-label="Customer type">
                <button type="button" data-audience="personal" aria-pressed="false" class="h-8 rounded-[7px] px-3 font-medium transition-colors aria-pressed:bg-nav-active aria-pressed:text-nav-active-foreground">Personal</button>
                <button type="button" data-audience="business" aria-pressed="true" class="h-8 rounded-[7px] px-3 font-medium transition-colors aria-pressed:bg-nav-active aria-pressed:text-nav-active-foreground">Business</button>
              </div>
              <label class="sr-only" for="price-country">Country</label>
              <select id="price-country" class="h-10 rounded-lg border border-input bg-popover px-3 text-foreground">
                {countryOptions.map((c) => <option value={c.code}>{c.name}</option>)}
                <option value="OUT">Outside the EU</option>
              </select>
            </div>
          </div>

          <div class="elevate mt-5 flex flex-wrap gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] bg-foreground/[0.08]">
            {plans.map((plan) => (
              <article
                class:list={[
                  'flex min-w-0 flex-[1_1_20rem] flex-col gap-6 p-7 md:p-10',
                  plan.highlight
                    ? 'panel-featured shadow-[inset_0_0_0_1px_hsl(var(--primary-readable)/0.45)]'
                    : 'bg-card dark:bg-background',
                ]}
              >
                <div>
                  <div class="flex items-center justify-between gap-3">
                    <h3 class="font-display text-[28px] font-bold tracking-[-0.025em]">{plan.name}</h3>
                    {plan.highlight && (
                      <span class="rounded-[5px] bg-nav-active px-2 py-0.5 font-mono text-[11px] text-nav-active-foreground">most teams</span>
                    )}
                  </div>
                  <p class="mt-1.5 text-[15px] text-muted-foreground">{plan.tagline}</p>
                </div>
                <div>
                  <p class="flex items-baseline gap-2">
                    <span
                      class="font-display text-[56px] font-bold leading-none tracking-[-0.035em]"
                      data-price-monthly={plan.monthly || undefined}
                      data-price-annual={plan.annual ? plan.annualMonthly : undefined}
                    >{plan.annual ? `$${plan.annualMonthly}` : plan.price}</span>
                    <span class="text-muted-foreground">{plan.priceNote}</span>
                  </p>
                  <p
                    class="mt-2 min-h-[1.5rem] text-sm text-muted-foreground"
                    data-annual-monthly={plan.annual ? plan.annualMonthly : undefined}
                    data-annual-total={plan.annual ? plan.annualTotal : undefined}
                  >
                    {plan.annual ? `Billed annually, $${plan.annualTotal}/year` : 'No credit card required'}
                  </p>
                  <p class="mt-1 min-h-[2.5rem] text-xs text-muted-foreground" data-tax-note>
                    {plan.annual ? 'excl. VAT. EU consumers: VAT of your country is included at checkout.' : ''}
                  </p>
                </div>
                <a
                  href={plan.cta.href}
                  class:list={[
                    'inline-flex h-12 items-center justify-center rounded-[10px] font-medium',
                    plan.highlight ? 'btn-primary bg-primary text-primary-foreground' : 'btn-ghost border border-foreground/15',
                  ]}
                >
                  {plan.cta.label}
                </a>
                <ul class="m-0 flex list-none flex-col gap-3 border-t border-foreground/[0.08] p-0 pt-5 text-[15px]">
                  {plan.limits.map((limit) => (
                    <li class="flex items-start gap-3">
                      <Icon name="lucide:check" class="mt-1 h-4 w-4 shrink-0 text-primary-readable" aria-hidden="true" />
                      <span>{limit}</span>
                    </li>
                  ))}
                  {plan.sso && (
                    <li class="flex items-start gap-3 text-muted-foreground">
                      <Icon name="lucide:clock" class="mt-1 h-4 w-4 shrink-0" aria-hidden="true" />
                      <span>SSO (OIDC), coming soon</span>
                    </li>
                  )}
                </ul>
              </article>
            ))}
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-x-7 gap-y-3 rounded-[14px] border border-foreground/[0.08] px-6 py-4">
            <span class="font-mono text-xs text-muted-foreground">in every plan</span>
            {[...siemIncluded, 'Unlimited users', 'No overage fees'].map((item) => (
              <span class="flex items-center gap-2 text-[15px]">
                <span class="h-1.5 w-1.5 rounded-full bg-primary-readable" aria-hidden="true"></span>{item}
              </span>
            ))}
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-[77.5rem] px-4 pt-20 sm:px-6 md:pt-28 lg:px-10" aria-labelledby="selfhost-heading">
        <div class="flex flex-wrap items-center gap-x-14 gap-y-7 rounded-2xl border border-foreground/15 bg-card p-7 md:p-12">
          <div class="flex-[1_1_26rem]">
            <p class="font-mono text-xs text-muted-foreground">self-hosted</p>
            <h2 id="selfhost-heading" class="mt-3 text-[clamp(1.875rem,1.3rem+1.8vw,2.75rem)] font-bold">
              $0, on your own servers. Same open-source core.
            </h2>
            <p class="mt-3 max-w-[54ch] text-muted-foreground">AGPLv3 with every feature. You run the infrastructure, we never see your data.</p>
          </div>
          <div class="flex flex-[1_1_20rem] flex-col gap-3">
            <div class="flex h-12 items-center gap-3 rounded-[10px] border border-border bg-background px-4 font-mono text-[13px]">
              <span class="text-primary-readable" aria-hidden="true">$</span><code>docker compose up -d</code>
            </div>
            <div class="flex flex-wrap gap-2.5">
              <a href="/docs/getting-started/" class="btn-ghost inline-flex h-11 items-center rounded-[10px] border border-foreground/15 px-5 font-medium">Self-hosting guide</a>
              <a href="/self-hosted-log-management/" class="inline-flex h-11 items-center px-2 text-sm font-medium text-primary-readable hover:underline">Why self-host →</a>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-[77.5rem] px-4 pt-24 sm:px-6 md:pt-36 lg:px-10" aria-labelledby="faq-heading">
        <div class="flex flex-wrap gap-x-[4.5rem] gap-y-10">
          <div class="flex-[1_1_17rem]">
            <h2 id="faq-heading" class="text-[clamp(2.25rem,1.5rem+2.4vw,3.5rem)] font-bold">Questions, answered.</h2>
            <p class="mt-4 max-w-[34ch] text-muted-foreground">
              Need more volume or longer retention?
              <a href="/contact/" class="text-primary-readable underline underline-offset-[3px]">Talk to us</a> about a custom plan.
            </p>
          </div>
          <dl class="m-0 grid flex-[2.2_1_34rem] gap-x-12 md:grid-cols-2">
            {faqs.map((faq) => (
              <div class="border-t border-foreground/[0.08] py-5">
                <dt class="text-[17px] font-semibold">{faq.question}</dt>
                <dd class="m-0 mt-2 text-[15px] text-muted-foreground">{faq.answer}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section class="mx-auto max-w-[77.5rem] px-4 py-24 sm:px-6 md:py-36 lg:px-10">
        <div class="flex flex-wrap items-end justify-between gap-6 border-t border-foreground/15 pt-10">
          <h2 class="text-[clamp(2.75rem,1.5rem+4.4vw,5.5rem)] font-bold leading-[0.92] tracking-[-0.032em]">
            Start on Free. Upgrade when you need to.
          </h2>
          <a href={signup} class="btn-primary inline-flex h-[50px] items-center rounded-[10px] bg-primary px-6 font-medium text-primary-foreground">Start for free</a>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline type="application/json" id="vat-data" set:html={clientData} />
    <script>
      import { priceWithVat } from '../data/eu-vat-rates';

      type Vat = { countries: Record<string, { name: string; vat: number }>; timezones: Record<string, string> };
      const KEY = 'logtide_price_view';

      function init() {
        const dataEl = document.getElementById('vat-data');
        const select = document.getElementById('price-country') as HTMLSelectElement | null;
        const buttons = document.querySelectorAll<HTMLButtonElement>('[data-audience]');
        const billingButtons = document.querySelectorAll<HTMLButtonElement>('[data-billing]');
        if (!dataEl || !select || !buttons.length) return;
        const data: Vat = JSON.parse(dataEl.textContent || '{}');

        function guess(): string {
          try {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            if (tz && data.timezones[tz]) return data.timezones[tz];
          } catch {}
          try {
            const region = (navigator.language || '').split('-')[1]?.toUpperCase();
            if (region && data.countries[region]) return region;
          } catch {}
          return 'OUT';
        }

        let audience = 'business';
        let country = 'OUT';
        let billing = 'annual';
        let saved: { audience?: string; country?: string; billing?: string } | null = null;
        try {
          saved = JSON.parse(localStorage.getItem(KEY) || 'null');
        } catch {}
        if (
          saved &&
          (saved.audience === 'personal' || saved.audience === 'business') &&
          typeof saved.country === 'string' &&
          (saved.country === 'OUT' || data.countries[saved.country])
        ) {
          audience = saved.audience;
          country = saved.country;
        } else {
          country = guess();
          audience = country === 'OUT' ? 'business' : 'personal';
        }
        if (saved && (saved.billing === 'monthly' || saved.billing === 'annual')) billing = saved.billing;

        const usd = (n: number) => '$' + n.toLocaleString('en-US', Number.isInteger(n) ? { maximumFractionDigits: 0 } : { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        function render() {
          const c = data.countries[country];
          const consumer = audience === 'personal' && !!c;
          const rate = consumer ? c.vat : 0;
          const amt = (n: number) => (consumer ? priceWithVat(n, rate) : n);
          select!.value = country;
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.audience === audience)));
          billingButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.billing === billing)));
          document.querySelectorAll<HTMLElement>('article').forEach((card) => {
            const priceEl = card.querySelector<HTMLElement>('[data-price-monthly]');
            const annEl = card.querySelector<HTMLElement>('[data-annual-monthly]');
            const noteEl = card.querySelector<HTMLElement>('[data-tax-note]');
            if (!priceEl || !annEl || !noteEl) return;
            const monthly = amt(Number(priceEl.dataset.priceMonthly));
            const m = amt(Number(annEl.dataset.annualMonthly));
            const t = amt(Number(annEl.dataset.annualTotal));
            if (billing === 'annual') {
              priceEl.textContent = usd(m);
              annEl.textContent = `Billed annually, ${usd(t)}/year`;
            } else {
              priceEl.textContent = usd(monthly);
              annEl.textContent = `Billed monthly, or ${usd(m)}/month billed annually`;
            }
            if (consumer) {
              noteEl.textContent = `incl. ${rate}% VAT (${c.name})`;
            } else if (country === 'OUT') {
              noteEl.textContent = 'plus applicable taxes';
            } else {
              noteEl.textContent = 'excl. VAT; EU businesses with a valid VAT ID pay no VAT (reverse charge)';
            }
          });
        }

        function save() {
          try {
            localStorage.setItem(KEY, JSON.stringify({ audience, country, billing }));
          } catch {}
        }

        buttons.forEach((b) =>
          b.addEventListener('click', () => {
            audience = b.dataset.audience || 'business';
            if (audience === 'personal' && country === 'OUT') country = guess() === 'OUT' ? 'IT' : guess();
            render();
            save();
          })
        );
        billingButtons.forEach((b) =>
          b.addEventListener('click', () => {
            billing = b.dataset.billing === 'monthly' ? 'monthly' : 'annual';
            render();
            save();
          })
        );
        select.addEventListener('change', () => {
          country = select.value;
          render();
          save();
        });
        render();
      }

      document.addEventListener('astro:page-load', init);
    </script>

    <style is:global>
      @import '../styles/tailwind.css';
      @import '../styles/custom.css';
    </style>
  </body>
</html>
