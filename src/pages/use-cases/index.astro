---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
import DifficultyBadge from '../../components/content/DifficultyBadge.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

// Get all published use cases
const allUseCases = await getCollection('use-cases', ({ data }) => !data.draft);

// Group by category
const categories = {
  'compliance': { label: 'Compliance & Privacy', icon: 'lucide:shield-check', items: [] as typeof allUseCases },
  'performance': { label: 'Performance & Optimization', icon: 'lucide:gauge', items: [] as typeof allUseCases },
  'security': { label: 'Security & Monitoring', icon: 'lucide:lock', items: [] as typeof allUseCases },
  'cost': { label: 'Cost Optimization', icon: 'lucide:wallet', items: [] as typeof allUseCases },
  'operations': { label: 'Operations & DevOps', icon: 'lucide:settings', items: [] as typeof allUseCases },
};

// Sort use cases into categories
allUseCases.forEach((useCase) => {
  const cat = categories[useCase.data.category];
  if (cat) {
    cat.items.push(useCase);
  }
});

// Sort items alphabetically within each category
Object.values(categories).forEach((cat) => {
  cat.items.sort((a, b) => a.data.title.localeCompare(b.data.title));
});

// Filter out empty categories
const populatedCategories = Object.entries(categories).filter(([, cat]) => cat.items.length > 0);

const title = 'Use Cases | LogTide';
const description = 'Real-world logging scenarios and how to solve them with LogTide. GDPR compliance, security monitoring, cost optimization, and more.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <SEO
      title={title}
      description={description}
      type="website"
      ogImage="https://logtide.dev/images/use-cases.png"
      keywords={["log management use cases", "GDPR compliance logs", "security monitoring", "SIEM use cases", "incident response", "threat detection", "compliance monitoring"]}
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        function applyTheme() {
          // Dark by default; the header toggle and the footer picker store
          // 'dark', 'light' or 'system' (follow the OS).
          const stored = localStorage.getItem('theme') || 'dark';
          const theme = stored === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : stored;
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main>
      <section class="relative" aria-labelledby="use-cases-heading">
        <div class="pointer-events-none absolute inset-x-0 -top-16 hidden h-[640px] bg-[radial-gradient(45%_50%_at_25%_0%,hsl(var(--primary)/0.2),transparent_70%)] dark:block" aria-hidden="true"></div>
        <div class="dot-grid pointer-events-none absolute inset-x-0 -top-16 h-[520px]" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-[77.5rem] px-4 pt-16 sm:px-6 md:pt-28 lg:px-10">
          <p class="font-mono text-xs text-primary-readable">use cases</p>
          <h1 id="use-cases-heading" class="mt-4 text-[clamp(2.75rem,1.6rem+4.4vw,5.25rem)] font-bold leading-[0.95] tracking-[-0.032em]">
            Use Cases
          </h1>
          <p class="mt-6 max-w-[58ch] text-lg text-muted-foreground">
            Real-world logging scenarios and how to solve them with LogTide.
            Each guide includes problem analysis, implementation steps, and best practices.
          </p>
        </div>
      </section>

      <div class="mx-auto max-w-[77.5rem] px-4 pb-24 sm:px-6 md:pb-36 lg:px-10">
        <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid sm:grid-cols-3">
          <div class="bg-background p-6">
            <Icon name="lucide:shield-check" class="h-6 w-6 text-primary-readable" aria-hidden="true" />
            <h3 class="mt-4 font-semibold">Privacy-First</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">
              Self-hosted, GDPR compliant. Your logs never leave your infrastructure.
            </p>
          </div>
          <div class="bg-background p-6">
            <Icon name="lucide:zap" class="h-6 w-6 text-primary-readable" aria-hidden="true" />
            <h3 class="mt-4 font-semibold">Production-Ready</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">
              Complete examples with Docker, Kubernetes, and enterprise deployment guides.
            </p>
          </div>
          <div class="bg-background p-6">
            <Icon name="lucide:git-branch" class="h-6 w-6 text-primary-readable" aria-hidden="true" />
            <h3 class="mt-4 font-semibold">Open Source</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">
              AGPLv3 licensed. No vendor lock-in, full transparency, community-driven.
            </p>
          </div>
        </div>

        {populatedCategories.map(([key, category]) => (
          <section class="pt-20 md:pt-28" aria-labelledby={key}>
            <div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
              <h2 id={key} class="flex items-center gap-3 text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] font-bold leading-[1.05] tracking-[-0.03em]">
                <Icon name={category.icon} class="h-6 w-6 text-primary-readable" aria-hidden="true" />
                {category.label}
              </h2>
              <p class="font-mono text-xs text-muted-foreground">{category.items.length} {category.items.length === 1 ? 'guide' : 'guides'}</p>
            </div>

            <div class="grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid md:grid-cols-2">
              {category.items.map((useCase) => (
                <a href={`/use-cases/${useCase.id}/`} class="group flex flex-col bg-background p-6 transition-colors hover:bg-card">
                  <div class="flex items-center justify-between gap-3">
                    <DifficultyBadge difficulty={useCase.data.difficulty} />
                    {useCase.data.industries.length > 0 && (
                      <span class="truncate font-mono text-xs text-muted-foreground">
                        {useCase.data.industries.slice(0, 2).join(', ')}
                      </span>
                    )}
                  </div>
                  <h3 class="mt-5 text-lg font-semibold tracking-[-0.015em] group-hover:text-primary-readable">
                    {useCase.data.title}
                  </h3>
                  <p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">{useCase.data.description}</p>
                  {useCase.data.highlights.length > 0 && (
                    <ul class="m-0 mt-4 flex list-none flex-wrap gap-x-4 gap-y-1 p-0">
                      {useCase.data.highlights.slice(0, 3).map((highlight) => (
                        <li class="font-mono text-xs text-muted-foreground">{highlight}</li>
                      ))}
                    </ul>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))}

        {populatedCategories.length === 0 && (
          <div class="mt-20 rounded-2xl border border-foreground/15 px-6 py-16 text-center">
            <Icon name="lucide:lightbulb" class="mx-auto mb-6 h-12 w-12 text-muted-foreground" aria-hidden="true" />
            <h2 class="text-2xl font-bold tracking-[-0.025em]">Use case guides coming soon</h2>
            <p class="mx-auto mt-3 max-w-[58ch] text-muted-foreground">
              We're working on adding real-world use case guides. Check back later or
            </p>
            <a
              href="https://github.com/logtide-dev/logtide"
              target="_blank"
              rel="noopener"
              class="btn-primary mt-6 inline-flex h-12 items-center gap-2 rounded-[10px] bg-primary px-5 font-medium text-primary-foreground"
            >
              <Icon name="simple-icons:github" class="h-4 w-4" aria-hidden="true" />
              Contribute on GitHub
            </a>
          </div>
        )}

        <section class="mt-20 flex flex-wrap items-center justify-between gap-x-12 gap-y-6 rounded-2xl border border-foreground/15 bg-card p-8 md:mt-28 md:p-10">
          <div class="flex-[1_1_24rem]">
            <h2 class="text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-bold leading-[1.1] tracking-[-0.025em]">Have a specific scenario?</h2>
            <p class="mt-3 max-w-[58ch] text-muted-foreground">
              We're always adding new use case guides. Tell us about your logging challenges and we'll help.
            </p>
          </div>
          <a
            href="https://github.com/logtide-dev/logtide/discussions"
            target="_blank"
            rel="noopener"
            class="btn-primary inline-flex h-12 items-center gap-2 rounded-[10px] bg-primary px-5 font-medium text-primary-foreground"
          >
            Start a Discussion
            <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
          </a>
        </section>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  @import '../../styles/tailwind.css';
  @import '../../styles/custom.css';



</style>
