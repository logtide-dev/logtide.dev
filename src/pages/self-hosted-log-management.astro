---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import FAQSection from '../components/content/FAQSection.astro';
import GitHubIcon from '../components/ui/GitHubIcon.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

const title = 'Self-Hosted Log Management | Open Source & GDPR-Compliant | LogTide';
const description =
  'LogTide is self-hosted, open-source log management with a built-in SIEM - a privacy-first alternative to ELK, Datadog and Splunk. Keep every log on your own infrastructure.';
const keywords = [
  'self-hosted log management',
  'open source log management',
  'self-hosted logging',
  'ELK alternative',
  'open source Datadog alternative',
  'self-hosted SIEM',
  'GDPR log management',
  'self hosted log analysis',
];

const seoBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Self-Hosted Log Management', url: '/self-hosted-log-management/' },
];

// Pull comparison entries to drive internal links to the /vs/ cluster.
const allComparisons = await getCollection('comparisons', ({ data }) => !data.draft);
const alternativeSlugs = ['elk-stack', 'datadog', 'splunk', 'grafana-loki', 'graylog', 'signoz'];
const alternatives = alternativeSlugs
  .map((slug) => allComparisons.find((c) => c.id === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);

const benefits = [
  {
    icon: 'lucide:server',
    title: 'Your servers, your data',
    description:
      'Logs never leave infrastructure you control. No third-party SaaS holds your data, and nothing is shared with a vendor.',
  },
  {
    icon: 'lucide:dollar-sign',
    title: 'No per-GB ingestion fees',
    description:
      'Self-hosting removes metered pricing entirely. You pay for the box, not for every gigabyte you ingest or query.',
  },
  {
    icon: 'lucide:lock',
    title: 'GDPR & EU data residency',
    description:
      'Keep logs in your own region to satisfy data-sovereignty and GDPR requirements - no transatlantic data transfers.',
  },
  {
    icon: 'lucide:shield-check',
    title: 'Built-in SIEM included',
    description:
      'Sigma detection rules and MITRE ATT&CK mapping ship in the box. Turn your logs into threat detection with no add-on.',
  },
  {
    icon: 'lucide:feather',
    title: 'Lighter than the ELK Stack',
    description:
      'A single service on TimescaleDB or ClickHouse instead of a multi-node JVM cluster - far less RAM and no shard babysitting.',
  },
  {
    icon: 'lucide:git-fork',
    title: 'Open source, no lock-in',
    description:
      'AGPLv3 licensed. Your logs live in standard SQL stores you can query and export anytime. Inspect the code, self-audit, fork it.',
  },
];

const faqs = [
  {
    question: 'What is self-hosted log management?',
    answer:
      'Self-hosted log management means running the log collection, storage, search and alerting stack on infrastructure you control - your own servers or private cloud - instead of sending logs to a third-party SaaS. You own the data end to end and pay for infrastructure rather than per-GB ingestion.',
  },
  {
    question: 'Is self-hosted logging cheaper than SaaS tools like Datadog or Splunk?',
    answer:
      'Beyond modest volumes, yes. SaaS platforms charge per GB ingested plus per-user seats, which scales with your traffic. Self-hosting LogTide shifts cost to fixed infrastructure, which commonly saves 70-90% at scale. See the LogTide vs Datadog and vs Splunk breakdowns for worked numbers.',
  },
  {
    question: 'Is LogTide a good open-source alternative to the ELK Stack?',
    answer:
      'For most teams, yes. LogTide replaces Elasticsearch, Logstash and Kibana with a single service backed by TimescaleDB or ClickHouse, uses far less memory, and adds a built-in SIEM and alerting - without cluster management. ELK still wins for petabyte-scale search and its Beats ecosystem.',
  },
  {
    question: 'Do I keep full data ownership and GDPR compliance when self-hosting?',
    answer:
      'Yes. Because logs stay on infrastructure you operate, you control where data physically lives, who can access it, and how long it is retained - which makes EU data residency and GDPR obligations straightforward compared with a US-based SaaS.',
  },
  {
    question: 'How do I deploy LogTide on my own infrastructure?',
    answer:
      'LogTide runs as a Docker Compose stack. Download the compose file and .env.example from the repository, run docker compose up -d, create an organization and API key, then point your SDKs or log shippers at the HTTP endpoint. The deployment guide covers production setups including reverse proxy and storage tuning.',
  },
  {
    question: 'Can self-hosted LogTide replace a SIEM?',
    answer:
      'For log-based detection, yes. LogTide includes Sigma rules, MITRE ATT&CK mapping and incident management at no extra cost, so you get core SIEM capabilities without a separate product or per-event security pricing.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      type="website"
      ogImage="https://logtide.dev/images/default.png"
      breadcrumbs={seoBreadcrumbs}
      keywords={keywords}
      faqs={faqs}
    />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyTheme() {
          // Dark by default; the header toggle and the footer picker store
          // 'dark', 'light' or 'system' (follow the OS).
          const stored = localStorage.getItem('theme') || 'dark';
          const theme = stored === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : stored;
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main>
      <!-- Hero -->
      <section class="relative" aria-labelledby="hero-heading">
        <div class="pointer-events-none absolute inset-x-0 -top-16 hidden h-[640px] bg-[radial-gradient(45%_50%_at_25%_0%,hsl(var(--primary)/0.2),transparent_70%)] dark:block" aria-hidden="true"></div>
        <div class="dot-grid pointer-events-none absolute inset-x-0 -top-16 h-[520px]" aria-hidden="true"></div>

        <div class="relative mx-auto grid max-w-[77.5rem] items-center gap-12 px-4 pt-16 sm:px-6 md:pt-28 lg:grid-cols-2 lg:px-10">
          <div>
            <p class="font-mono text-xs text-primary-readable">open source, self-hosted, gdpr-ready</p>

            <h1 id="hero-heading" class="mt-4 text-[clamp(2.75rem,1.6rem+4.4vw,5.25rem)] font-bold leading-[0.95] tracking-[-0.032em]">
              Self-Hosted Log Management.
              <span class="text-primary-readable">On your terms.</span>
            </h1>

            <p class="mt-6 max-w-[58ch] text-lg text-muted-foreground">
              LogTide is an open-source log management platform with a built-in SIEM that runs
              entirely on your own infrastructure - a privacy-first alternative to
              <a href="/vs/elk-stack/" class="text-foreground underline decoration-primary/30 underline-offset-4 hover:decoration-primary">ELK</a>,
              <a href="/vs/datadog/" class="text-foreground underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Datadog</a> and
              <a href="/vs/splunk/" class="text-foreground underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Splunk</a>.
              No per-GB fees. No data leaving your servers.
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="/docs/deployment/"
                class="btn-primary inline-flex h-12 items-center gap-2 rounded-[10px] bg-primary px-5 font-medium text-primary-foreground"
              >
                Deploy in minutes
                <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
              </a>
              <a
                href="/docs/getting-started/"
                class="btn-ghost inline-flex h-12 items-center rounded-[10px] border border-foreground/15 px-5 font-medium"
              >
                Read the docs
              </a>
            </div>
          </div>

          <!-- Terminal card -->
          <div class="min-w-0 overflow-hidden rounded-xl border border-foreground/15 bg-card shadow-glow-sm">
            <div class="flex items-center gap-2 border-b border-foreground/[0.08] px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-foreground/20"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-foreground/20"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-foreground/20"></span>
              <span class="ml-2 font-mono text-xs text-muted-foreground">deploy.sh</span>
            </div>
            <pre class="overflow-x-auto p-5 text-sm leading-relaxed"><code><span class="text-muted-foreground"># Self-host LogTide on your own box</span>
<span class="text-primary-readable">mkdir</span> logtide && <span class="text-primary-readable">cd</span> logtide
<span class="text-primary-readable">curl</span> -O https://raw.githubusercontent.com/logtide-dev/logtide/main/docker/docker-compose.yml
<span class="text-primary-readable">curl</span> -O https://raw.githubusercontent.com/logtide-dev/logtide/main/docker/.env.example
<span class="text-primary-readable">mv</span> .env.example .env
<span class="text-primary-readable">docker</span> compose up -d

<span class="text-muted-foreground"># Your logs. Your server. Your rules.</span></code></pre>
          </div>
        </div>
      </section>

      <!-- Why self-host -->
      <section class="mx-auto max-w-[77.5rem] px-4 pt-24 sm:px-6 md:pt-36 lg:px-10" aria-labelledby="why-heading">
        <p class="font-mono text-xs text-primary-readable">why self-host</p>
        <h2 id="why-heading" class="mt-3 max-w-[22ch] text-[clamp(2.25rem,1.5rem+2.6vw,4rem)] font-bold leading-none tracking-[-0.03em]">
          Own your logs end to end
        </h2>
        <p class="mt-5 max-w-[58ch] text-lg text-muted-foreground">
          Self-hosted log management gives you the cost, privacy and control that metered SaaS platforms can't.
        </p>

        <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid md:grid-cols-2 lg:grid-cols-3">
          {benefits.map((benefit) => (
            <article class="bg-background p-6 transition-colors hover:bg-card md:p-8">
              <Icon name={benefit.icon} class="h-6 w-6 text-primary-readable" aria-hidden="true" />
              <h3 class="mt-4 text-lg font-semibold tracking-[-0.015em]">{benefit.title}</h3>
              <p class="mt-1.5 text-sm text-muted-foreground">{benefit.description}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Open-source alternative -->
      <section class="mx-auto max-w-[77.5rem] px-4 pt-24 sm:px-6 md:pt-36 lg:px-10" aria-labelledby="alt-heading">
        <h2 id="alt-heading" class="max-w-[22ch] text-[clamp(2.25rem,1.5rem+2.6vw,4rem)] font-bold leading-none tracking-[-0.03em]">
          An open-source alternative to your current tool
        </h2>
        <p class="mt-5 max-w-[58ch] text-lg text-muted-foreground">
          Already on a hosted platform or a heavy stack? See how self-hosted LogTide compares -
          honestly, including where the incumbent still wins.
        </p>

        <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid sm:grid-cols-2 lg:grid-cols-3">
          {alternatives.map((item) => (
            <a href={`/vs/${item.id}/`} class="group flex flex-col bg-background p-6 transition-colors hover:bg-card">
              <span class="font-mono text-xs text-primary-readable">LogTide vs {item.data.competitor}</span>
              <p class="mt-3 line-clamp-3 text-sm text-muted-foreground">{item.data.description}</p>
              <span class="mt-4 text-sm font-medium text-primary-readable group-hover:underline">Compare →</span>
            </a>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
          <a href="/vs/" class="font-medium text-primary-readable hover:underline">All comparisons →</a>
          <a href="/docs/migration/" class="font-medium text-primary-readable hover:underline">Migration guides →</a>
        </div>
      </section>

      <!-- Cost / sovereignty band -->
      <section class="mx-auto max-w-[77.5rem] px-4 pt-24 sm:px-6 md:pt-36 lg:px-10" aria-labelledby="value-heading">
        <h2 id="value-heading" class="sr-only">Cost and data ownership</h2>
        <div class="grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid md:grid-cols-2">
          <div class="bg-background p-6 md:p-8">
            <Icon name="lucide:trending-down" class="h-6 w-6 text-primary-readable" aria-hidden="true" />
            <h3 class="mt-4 text-2xl font-bold tracking-[-0.025em]">Cut log costs at scale</h3>
            <p class="mt-2 text-muted-foreground">
              Per-GB ingestion pricing punishes growth. Self-hosting turns log cost into a flat
              infrastructure line, commonly saving 70-90% once you pass the free tiers.
            </p>
            <a href="/use-cases/cost-optimization/" class="mt-4 inline-block font-medium text-primary-readable hover:underline">
              Cost optimization guide →
            </a>
          </div>
          <div class="bg-background p-6 md:p-8">
            <Icon name="lucide:shield-check" class="h-6 w-6 text-primary-readable" aria-hidden="true" />
            <h3 class="mt-4 text-2xl font-bold tracking-[-0.025em]">Data sovereignty by default</h3>
            <p class="mt-2 text-muted-foreground">
              Keep every log inside your own region and access boundary. Self-hosting makes EU data
              residency and GDPR obligations a configuration detail, not a contract negotiation.
            </p>
            <a href="/use-cases/gdpr-compliance/" class="mt-4 inline-block font-medium text-primary-readable hover:underline">
              GDPR compliance guide →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="mx-auto max-w-[77.5rem] px-4 pt-20 sm:px-6 md:pt-28 lg:px-10" aria-labelledby="faq-wrap">
        <div class="max-w-[46rem]">
          <h2 id="faq-wrap" class="sr-only">Self-hosted log management FAQ</h2>
          <FAQSection faqs={faqs} title="Self-hosted log management: FAQ" />
        </div>
      </section>

      <!-- CTA -->
      <section class="mx-auto max-w-[77.5rem] px-4 pb-24 pt-20 sm:px-6 md:pb-36 md:pt-28 lg:px-10" aria-labelledby="cta-heading">
        <div class="flex flex-wrap items-center justify-between gap-x-12 gap-y-6 rounded-2xl border border-foreground/15 bg-card p-8 md:p-12">
          <div class="flex-[1_1_24rem]">
            <h2 id="cta-heading" class="text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] font-bold leading-[1.05] tracking-[-0.03em]">Self-host your logs today</h2>
            <p class="mt-4 max-w-[58ch] text-lg text-muted-foreground">
              Free, open-source, and yours to run anywhere. Deploy with Docker Compose and start
              shipping logs in minutes.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href="/docs/getting-started/"
              class="btn-primary inline-flex h-12 items-center gap-2 rounded-[10px] bg-primary px-5 font-medium text-primary-foreground"
            >
              Get started
              <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
            </a>
            <a
              href="https://github.com/logtide-dev/logtide"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost inline-flex h-12 items-center gap-2 rounded-[10px] border border-foreground/15 px-5 font-medium"
            >
              <GitHubIcon class="h-4 w-4" />
              View on GitHub
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style is:global>
      @import '../styles/tailwind.css';
      @import '../styles/custom.css';




    </style>
  </body>
</html>
