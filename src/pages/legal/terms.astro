---
import ContentPage from '../../layouts/ContentPage.astro';
import DraftBanner from '../../components/DraftBanner.astro';

const title = 'Terms of Service - LogTide';
const description = 'LogTide terms of service. Read the conditions for using the LogTide log management platform.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Terms of Service', url: '/legal/terms/' },
];
---

