---
import ContentPage from '../../layouts/ContentPage.astro';
import DraftBanner from '../../components/DraftBanner.astro';

const title = 'Subprocessors - LogTide';
const description = 'List of subprocessors LogTide uses to provide the LogTide Cloud service, with purpose, location and transfer basis.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Subprocessors', url: '/legal/subprocessors/' },
];
---

<ContentPage title={title} description={description} breadcrumbs={breadcrumbs}>
  <h1>Subprocessors</h1>
  <p class="text-muted-foreground">Last updated: October 2026</p>

  <DraftBanner />

  <div class="prose-content">
    <p>
      LogTide Cloud, operated by <strong><a href="https://solture.it" target="_blank" rel="noopener noreferrer">Solture S.R.L.</a></strong>, uses the third parties below to deliver the service. This list is referenced by the <a href="/legal/dpa/">Data Processing Agreement</a>. Self-hosted deployments do not use any of them.
    </p>

    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Purpose</th>
          <th>Location</th>
          <th>Transfer basis</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>OVH SAS</td>
          <td>Infrastructure hosting for the cloud service, including storage of customer log data</td>
          <td>2 rue Kellermann, 59100 Roubaix, France. Data center: Strasbourg (SBG), France.</td>
          <td>No transfer outside the EEA</td>
        </tr>
        <tr>
          <td>Stripe Payments Europe, Ltd.</td>
          <td>Payment processing, subscriptions, invoicing and tax calculation. Receives billing details only, never log data.</td>
          <td>Dublin, Ireland (EU). Stripe Payments Europe, Ltd. is the contracting entity.</td>
          <td>Any transfer to Stripe, Inc. (USA) relies on the EU-U.S. Data Privacy Framework and the Standard Contractual Clauses</td>
        </tr>
      </tbody>
    </table>

    <p>
      Transactional email (account messages, alert notifications and billing notices) is operated by LogTide itself and does not use a third-party email provider.
    </p>

    <h2>Changes to this list</h2>
    <p>
      We notify customers by email or through the Service at least 30 days before adding or replacing a subprocessor, as described in section 7 of the <a href="/legal/dpa/">DPA</a>. To object, contact <a href="mailto:privacy@logtide.dev">privacy@logtide.dev</a>.
    </p>

    <h2>Contact</h2>
    <ul>
      <li>Email: <a href="mailto:privacy@logtide.dev">privacy@logtide.dev</a></li>
    </ul>
  </div>
</ContentPage>
