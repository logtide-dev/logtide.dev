---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import { Icon } from 'astro-icon/components';
import { execSync } from 'child_process';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const title = entry.data.title;
const description = entry.data.description;

const rawPathname = Astro.url.pathname;
const pathname = rawPathname.endsWith('/') ? rawPathname : rawPathname + '/';

const seoBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: entry.data.title, url: pathname },
];

const pubDate = entry.data.pubDate;
const pubDateFormatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// File path for git dates
const filePath = `src/content/blog/${entry.id}.md`;
const editUrl = `https://github.com/logtide-dev/logtide.dev/edit/main/${filePath}`;

let lastUpdated: string | null = null;
let dateModifiedISO: string | null = null;

try {
  const cwd = process.cwd();
  const gitDateModified = execSync(`git log -1 --format="%ci" -- "${filePath}"`, { encoding: 'utf-8', cwd }).trim();
  if (gitDateModified) {
    const date = new Date(gitDateModified);
    lastUpdated = date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
    dateModifiedISO = date.toISOString();
  }
} catch {
  // Git command failed
}
---

<ContentPage
  title={`${title} | LogTide Blog`}
  description={description}
  ogImage="https://logtide.dev/images/blog.png"
  breadcrumbs={seoBreadcrumbs}
  datePublished={pubDate.toISOString()}
  dateModified={dateModifiedISO}
  keywords={entry.data.keywords}
  faqs={entry.data.faqs}
>
  <!-- Navigation breadcrumb -->
  <nav class="mb-8" aria-label="Breadcrumb">
    <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 font-mono text-xs text-muted-foreground">
      <li>
        <a href="/" class="transition-colors hover:text-foreground">Home</a>
      </li>
      <li class="text-muted-foreground/50">/</li>
      <li>
        <a href="/blog/" class="transition-colors hover:text-foreground">Blog</a>
      </li>
      <li class="text-muted-foreground/50">/</li>
      <li class="text-foreground line-clamp-1">{title}</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <header class="mb-10">
    <p class="font-mono text-xs text-primary-readable">blog</p>

    <h1 class="mt-4">
      {title}
    </h1>

    <p class="text-lg text-muted-foreground">
      {description}
    </p>

    <p class="mt-5 font-mono text-xs text-muted-foreground">
      <time datetime={pubDate.toISOString()}>{pubDateFormatted}</time> · {entry.data.author}
    </p>

    {entry.data.tags.length > 0 && (
      <ul class="m-0 mt-3 flex list-none flex-wrap gap-x-3 gap-y-1 p-0">
        {entry.data.tags.map((tag) => (
          <li class="font-mono text-xs text-muted-foreground">#{tag}</li>
        ))}
      </ul>
    )}
  </header>

  <!-- Markdown Content -->
  <div class="prose-content">
    <Content />
  </div>

  <!-- Edit Link -->
  <div class="mt-16 border-t border-foreground/[0.08] pt-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      {lastUpdated && (
        <span class="font-mono text-xs text-muted-foreground">
          Last updated: {lastUpdated}
        </span>
      )}
      <a
        href={editUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
      >
        <Icon name="lucide:pencil" class="w-4 h-4" />
        Edit this page on GitHub
      </a>
    </div>
  </div>
</ContentPage>
