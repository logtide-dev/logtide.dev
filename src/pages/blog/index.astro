---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

const title = 'Blog | LogTide';
const description =
  'Articles on log management, observability costs, SIEM and self-hosting from the LogTide team: comparisons, tutorials and engineering deep dives.';

const seoBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [latest, ...rest] = posts;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Posts have no cover images, so covers are generated: the first tag as a
// wordmark over the dot texture, tinted with one of the status tones.
const coverTints = [
  'bg-[radial-gradient(70%_80%_at_85%_100%,hsl(var(--primary)/0.45),transparent_70%)]',
  'bg-[radial-gradient(70%_80%_at_90%_100%,hsl(var(--success)/0.35),transparent_70%)]',
  'bg-[radial-gradient(70%_80%_at_90%_100%,hsl(var(--destructive)/0.35),transparent_70%)]',
  'bg-[radial-gradient(70%_80%_at_90%_100%,hsl(var(--info)/0.38),transparent_70%)]',
];
const coverTint = (i: number) => coverTints[i % coverTints.length];
const coverMark = (post: (typeof posts)[number]) => post.data.tags[0] ?? 'logtide';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      type="website"
      ogImage="https://logtide.dev/images/blog.png"
      breadcrumbs={seoBreadcrumbs}
    />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyTheme() {
          // Dark by default; the header toggle and the footer picker store
          // 'dark', 'light' or 'system' (follow the OS).
          const stored = localStorage.getItem('theme') || 'dark';
          const theme = stored === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : stored;
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main class="min-h-[60vh]">
      <section class="mx-auto max-w-[77.5rem] px-4 pt-14 sm:px-6 md:pt-24 lg:px-10" aria-labelledby="hero-heading">
        <div class="flex flex-wrap items-end justify-between gap-x-16 gap-y-6">
          <div class="flex-[1_1_32rem]">
            <p class="font-mono text-xs text-primary-readable">blog</p>
            <h1 id="hero-heading" class="mt-4 text-[clamp(2.75rem,1.6rem+4.4vw,5.25rem)] font-bold leading-[0.95] tracking-[-0.032em]">
              Notes on logging, in practice.
            </h1>
          </div>
          <p class="max-w-[42ch] flex-[1_1_18rem] text-muted-foreground">
            Log management, observability costs, SIEM and self-hosting: tutorials and engineering
            notes from the LogTide team.
          </p>
        </div>
      </section>

      <section class="mx-auto max-w-[77.5rem] px-4 pb-24 pt-10 sm:px-6 md:pb-36 lg:px-10" aria-label="Articles">
        {posts.length === 0 && (
          <p class="py-16 text-center text-muted-foreground">No articles yet - check back soon.</p>
        )}

        {latest && (
          <a
            href={`/blog/${latest.id}/`}
            class="post group flex flex-wrap items-center gap-x-12 gap-y-7 rounded-[18px] border border-foreground/15 bg-card p-5"
          >
            <div class="relative aspect-video min-w-0 flex-[1.3_1_28rem] overflow-hidden rounded-xl bg-[hsl(240_10%_5%)]">
              <div class={`cover absolute inset-0 ${coverTint(0)}`}>
                <div class="cover-dots absolute inset-0 opacity-60" aria-hidden="true"></div>
                <span class="absolute left-7 top-6 font-display text-[clamp(2.5rem,1.5rem+3vw,4.5rem)] font-bold tracking-[-0.03em] text-white/90" aria-hidden="true">
                  {coverMark(latest)}
                </span>
              </div>
            </div>
            <div class="min-w-0 flex-[1_1_22rem] py-2 pr-2">
              <p class="font-mono text-xs text-muted-foreground">
                latest · <time datetime={latest.data.pubDate.toISOString()}>{formatDate(latest.data.pubDate)}</time> · {latest.data.tags.slice(0, 3).join(', ')}
              </p>
              <h2 class="post-title mt-3.5 text-[clamp(1.75rem,1.3rem+1.4vw,2.5rem)] font-bold leading-[1.05] tracking-[-0.028em]">
                {latest.data.title}
              </h2>
              <p class="mt-3.5 text-muted-foreground">{latest.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-primary-readable">
                Read the article
                <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
              </span>
            </div>
          </a>
        )}

        {rest.length > 0 && (
          <div class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((post, i) => (
              <a href={`/blog/${post.id}/`} class="post group flex flex-col gap-4">
                <div class="relative aspect-[16/10] overflow-hidden rounded-[14px] border border-foreground/[0.08] bg-[hsl(240_10%_5%)]">
                  <div class={`cover absolute inset-0 ${coverTint(i + 1)}`}>
                    <div class="cover-dots absolute inset-0 opacity-50" aria-hidden="true"></div>
                    <span class="absolute left-[22px] top-[18px] font-display text-[44px] font-bold tracking-[-0.03em] text-white/90" aria-hidden="true">
                      {coverMark(post)}
                    </span>
                  </div>
                </div>
                <p class="font-mono text-xs text-muted-foreground">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> · {post.data.tags.slice(0, 2).join(', ')}
                </p>
                <h2 class="post-title font-sans text-[21px] font-semibold leading-[1.25] tracking-[-0.015em]">{post.data.title}</h2>
                <p class="text-[15px] text-muted-foreground">{post.data.description}</p>
              </a>
            ))}
          </div>
        )}
      </section>
    </main>


    <Footer />

    <style is:global>
      @import '../../styles/tailwind.css';
      @import '../../styles/custom.css';



    </style>
  </body>
</html>
