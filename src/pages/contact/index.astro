---
import ContentPage from '../../layouts/ContentPage.astro';

const title = 'Contact — LogTide';
const description = 'Get in touch with the LogTide team. Reach us for support, security reports, or sales inquiries.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
];
---

<ContentPage 
  title={title} 
  description={description} 
  breadcrumbs={breadcrumbs}
  keywords={["LogTide support", "contact LogTide", "security reporting", "log management help", "sales inquiries", "EU cloud support"]}
>
  <h1>Contact</h1>
  <p class="text-muted-foreground">
    We're a small team — we read every message. Pick the right address and we'll get back to you.
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    <a
      href="mailto:support@logtide.dev"
      class="group rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5"
    >
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10">
        <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <p class="mb-1 text-base font-semibold text-foreground">Support</p>
      <p class="mb-3 text-sm text-muted-foreground">Questions, bugs, or anything about using LogTide.</p>
      <span class="text-sm font-medium text-primary transition-colors group-hover:text-primary/80">
        support@logtide.dev
      </span>
    </a>

    <a
      href="mailto:security@logtide.dev"
      class="group rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5"
    >
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10">
        <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
      <p class="mb-1 text-base font-semibold text-foreground">Security</p>
      <p class="mb-3 text-sm text-muted-foreground">Vulnerability reports and responsible disclosure.</p>
      <span class="text-sm font-medium text-primary transition-colors group-hover:text-primary/80">
        security@logtide.dev
      </span>
    </a>

    <a
      href="mailto:hello@logtide.dev"
      class="group rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5"
    >
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10">
        <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <p class="mb-1 text-base font-semibold text-foreground">Sales & Partnerships</p>
      <p class="mb-3 text-sm text-muted-foreground">Enterprise plans, integrations, and collaborations.</p>
      <span class="text-sm font-medium text-primary transition-colors group-hover:text-primary/80">
        hello@logtide.dev
      </span>
    </a>
  </div>

  <div class="prose-content">
    <h2>Response times</h2>
    <p>
      We aim to respond within one business day. For urgent security issues, please use
      <a href="mailto:security@logtide.dev">security@logtide.dev</a> and include "URGENT" in the subject line.
    </p>

    <h2>Community</h2>
    <p>
      For public questions and feature requests, the fastest way to get help is often
      <a href="https://github.com/logtide-dev/logtide/discussions" target="_blank" rel="noopener noreferrer">GitHub Discussions</a>.
      The community and the core team are both active there.
    </p>

    <h2>Follow us</h2>
    <p>
      Keep up with releases and behind-the-scenes updates on
      <a href="https://x.com/Logtide_dev" target="_blank" rel="noopener noreferrer">X</a>
      and
      <a href="https://bsky.app/profile/logtide.bsky.social" target="_blank" rel="noopener noreferrer">Bluesky</a>.
    </p>
  </div>
</ContentPage>
