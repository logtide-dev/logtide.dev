---
import ContentPage from '../../layouts/ContentPage.astro';

const title = 'Contact - LogTide';
const description = 'Get in touch with the LogTide team. Reach us for support, security reports, or sales inquiries.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
];

const contacts = [
  {
    label: 'Support',
    description: 'Questions, bugs, or anything about using LogTide.',
    email: 'support@logtide.dev',
  },
  {
    label: 'Security',
    description: 'Vulnerability reports and responsible disclosure.',
    email: 'security@logtide.dev',
  },
  {
    label: 'Sales & Partnerships',
    description: 'Enterprise plans, integrations, and collaborations.',
    email: 'hello@logtide.dev',
  },
];
---

<ContentPage 
  title={title} 
  description={description} 
  breadcrumbs={breadcrumbs}
  keywords={["LogTide support", "contact LogTide", "security reporting", "log management help", "sales inquiries", "EU cloud support"]}
>
  <p class="font-mono text-xs text-primary-readable">contact</p>
  <h1 class="mt-4">Contact</h1>
  <p class="text-lg text-muted-foreground">
    We're a small team - we read every message. Pick the right address and we'll get back to you.
  </p>

  <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid sm:grid-cols-3">
    {contacts.map((contact) => (
      <a href={`mailto:${contact.email}`} class="group flex flex-col bg-background p-6 transition-colors hover:bg-card">
        <p class="font-mono text-xs text-muted-foreground">{contact.label.toLowerCase()}</p>
        <p class="mt-4 text-lg font-semibold tracking-[-0.015em]">{contact.label}</p>
        <p class="mt-1.5 flex-1 text-sm text-muted-foreground">{contact.description}</p>
        <span class="mt-4 break-all font-mono text-xs text-primary-readable group-hover:underline">
          {contact.email} →
        </span>
      </a>
    ))}
  </div>

  <div class="prose-content">
    <h2>Response times</h2>
    <p>
      We aim to respond within one business day. For urgent security issues, please use
      <a href="mailto:security@logtide.dev">security@logtide.dev</a> and include "URGENT" in the subject line.
    </p>

    <h2>Community</h2>
    <p>
      For public questions and feature requests, the fastest way to get help is often
      <a href="https://github.com/logtide-dev/logtide/discussions" target="_blank" rel="noopener noreferrer">GitHub Discussions</a>.
      The community and the core team are both active there.
    </p>

    <h2>Follow us</h2>
    <p>
      Keep up with releases and behind-the-scenes updates on
      <a href="https://x.com/Logtide_dev" target="_blank" rel="noopener noreferrer">X</a>
      and
      <a href="https://bsky.app/profile/logtide.bsky.social" target="_blank" rel="noopener noreferrer">Bluesky</a>.
    </p>
  </div>
</ContentPage>
