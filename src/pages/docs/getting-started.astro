          </TabsTrigger>
          <TabsTrigger value="nodejs" class="flex items-center gap-1.5">
            <Icon name="simple-icons:nodedotjs" class="w-3.5 h-3.5" />
            <span class="hidden sm:inline">Node.js</span>
          </TabsTrigger>
          <TabsTrigger value="docker" class="flex items-center gap-1.5">
            <Icon name="simple-icons:docker" class="w-3.5 h-3.5" />
            <span class="hidden sm:inline">Docker</span>
          </TabsTrigger>
          <TabsTrigger value="otel" class="flex items-center gap-1.5">
            <Icon name="simple-icons:opentelemetry" class="w-3.5 h-3.5" />
            <span class="hidden sm:inline">OTel</span>
          </TabsTrigger>
        </TabsList>

        <TabsContent value="curl" class="space-y-4">
          <p class="text-sm text-muted-foreground">
            The simplest way to test log ingestion using curl:
          </p>
          <div>
            <h4 class="text-sm font-semibold mb-2">Cloud (api.logtide.dev)</h4>
