---
import DocsLayout from '../../../layouts/Docs.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardContent from '../../../components/ui/CardContent.astro';
import Button from '../../../components/ui/Button.astro';
import { Code } from 'astro:components';
import { Icon } from 'astro-icon/components';

const headings = [
  { text: "Installation", slug: "installation", depth: 2 },
  { text: "Quick Start", slug: "quick-start", depth: 2 },
  { text: "Configuration", slug: "configuration", depth: 2 },
  { text: "Session Tracking", slug: "session-tracking", depth: 2 },
  { text: "Core Web Vitals", slug: "web-vitals", depth: 2 },
  { text: "Breadcrumbs", slug: "breadcrumbs", depth: 2 },
  { text: "Source Maps (CLI)", slug: "source-maps", depth: 2 },
  { text: "Offline Support", slug: "offline-support", depth: 2 },
  { text: "Framework Integrations", slug: "framework-integrations", depth: 2 }
];
---

<DocsLayout
  title="Browser SDK"
  description="Official Browser SDK for LogTide with session tracking, Core Web Vitals, breadcrumbs, and source maps support."
  headings={headings}
>
  <div class="flex items-center justify-between mb-4">
      <h1 class="text-3xl font-bold">Browser SDK</h1>
      <div class="flex items-center gap-2">
          <a
              href="https://github.com/logtide-dev/logtide-js"
              target="_blank"
              rel="noopener noreferrer"
          >
              <Button variant="ghost" size="sm" class="gap-1.5">
                  <Icon name="simple-icons:github" class="w-4 h-4" />
                  GitHub
              </Button>
          </a>
          <a
              href="https://www.npmjs.com/package/@logtide/browser"
              target="_blank"
              rel="noopener noreferrer"
          >
              <Button variant="ghost" size="sm" class="gap-1.5">
                  <Icon name="simple-icons:npm" class="w-4 h-4" />
                  npm
              </Button>
          </a>
      </div>
  </div>

  <p class="text-lg text-muted-foreground mb-8">
      The <code class="bg-muted px-1 rounded">@logtide/browser</code> package brings LogTide's
      observability to the frontend. It features session tracking, automatic Core Web Vitals collection,
      user interaction breadcrumbs, and source map un-minification.
  </p>

  <h2
      id="installation"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Installation
  </h2>

  <div class="mb-8">
      <Code
          lang="bash"
          theme="one-dark-pro"
          code={`npm install @logtide/browser

# or with pnpm
pnpm add @logtide/browser

# or with yarn
yarn add @logtide/browser`}
      />
  </div>

  <h2
      id="quick-start"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Quick Start
  </h2>

  <div class="mb-8">
      <Code
          lang="typescript"
          theme="one-dark-pro"
          code={`import { initLogtide } from '@logtide/browser';

initLogtide({
  dsn: 'https://lp_abc123@api.logtide.dev',
  environment: 'production',
  release: '1.0.0',
});`}
      />
  </div>

  <p class="text-muted-foreground mb-4">
      Once initialized, the SDK automatically starts capturing unhandled errors,
      user interactions, and performance metrics.
  </p>

  <h2
      id="configuration"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Configuration
  </h2>

  <div class="mb-8">
      <Code
          lang="typescript"
          theme="one-dark-pro"
          code={`import { initLogtide, WebVitalsIntegration, ClickIntegration, NetworkIntegration } from '@logtide/browser';

initLogtide({
  dsn: 'https://lp_abc123@api.logtide.dev',
  service: 'frontend-app',
  environment: 'production',
  release: 'v1.2.3',

  // Integrations (enabled by default)
  integrations: [
    new WebVitalsIntegration(),
    new ClickIntegration(),
    new NetworkIntegration(),
  ],

  // Sampling
  tracesSampleRate: 0.1,  // Capture 10% of traces
});`}
      />
  </div>

  <h2
      id="session-tracking"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Session Tracking
  </h2>

  <p class="text-muted-foreground mb-4">
      LogTide automatically generates a unique <code class="bg-muted px-1 rounded">session_id</code> for every visitor.
      This allows you to correlate all logs, errors, and traces to a specific user journey in the dashboard.
  </p>

  <h2
      id="web-vitals"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Core Web Vitals
  </h2>

  <p class="text-muted-foreground mb-4">
      The <code class="bg-muted px-1 rounded">WebVitalsIntegration</code> automatically collects Google's
      Core Web Vitals to monitor your application's performance:
  </p>

  <ul class="list-none ml-6 text-muted-foreground space-y-2 mb-8">
      <li>✅ <strong>LCP</strong> (Largest Contentful Paint)</li>
      <li>✅ <strong>FID</strong> (First Input Delay)</li>
      <li>✅ <strong>CLS</strong> (Cumulative Layout Shift)</li>
      <li>✅ <strong>INP</strong> (Interaction to Next Paint)</li>
      <li>✅ <strong>TTFB</strong> (Time to First Byte)</li>
  </ul>

  <h2
      id="breadcrumbs"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Breadcrumbs
  </h2>

  <p class="text-muted-foreground mb-8 text-muted-foreground">
      Breadcrumbs provide a timeline of events leading up to an error. The Browser SDK includes
      automatic tracking for clicks and network requests.
  </p>

  <div class="grid md:grid-cols-2 gap-6 mb-8">
      <Card>
          <CardHeader>
              <CardTitle class="text-base font-bold">User Clicks</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              Automatically captures clicks on buttons, links, and inputs, including element IDs
              and class names to reconstruct user actions.
          </CardContent>
      </Card>
      <Card>
          <CardHeader>
              <CardTitle class="text-base font-bold">Network Requests</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              Intercepts <code class="bg-muted px-1 rounded">fetch</code> and <code class="bg-muted px-1 rounded">XHR</code> calls
              to record request URLs, methods, status codes, and durations.
          </CardContent>
      </Card>
  </div>

  <h2
      id="source-maps"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Source Maps (CLI)
  </h2>

  <p class="text-muted-foreground mb-4">
      To see original source code in your stack traces instead of minified production code,
      you can upload your source maps using the <code class="bg-muted px-1 rounded">@logtide/cli</code>.
  </p>

  <div class="mb-8">
      <Code
          lang="bash"
          theme="one-dark-pro"
          code={`# Install the CLI
npm install -g @logtide/cli

# Upload source maps
logtide sourcemaps upload --path ./dist --release 1.0.0 --apiKey YOUR_API_KEY`}
      />
  </div>

  <h2
      id="offline-support"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Offline Support
  </h2>

  <p class="text-muted-foreground mb-4">
      The Browser SDK includes an <code class="bg-muted px-1 rounded">OfflineTransport</code> that buffers
      events when the user is offline and flushes them once connectivity is restored.
      It also uses <code class="bg-muted px-1 rounded">navigator.sendBeacon</code> to ensure data
      is sent even if the user closes the tab or navigates away.
  </p>

  <h2
      id="framework-integrations"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Framework Integrations
  </h2>

  <p class="text-muted-foreground mb-4">
      If you are using a frontend framework, we recommend using the dedicated package
      which includes the Browser SDK pre-configured:
  </p>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <a href="/docs/sdks/nextjs-sdk/" class="flex flex-col items-center p-4 border border-border rounded-lg hover:bg-muted/50 transition-colors">
          <Icon name="simple-icons:nextdotjs" class="w-8 h-8 mb-2" />
          <span class="text-sm font-medium">Next.js</span>
      </a>
      <a href="/docs/sdks/nuxt-sdk/" class="flex flex-col items-center p-4 border border-border rounded-lg hover:bg-muted/50 transition-colors">
          <Icon name="simple-icons:nuxtdotjs" class="w-8 h-8 mb-2" />
          <span class="text-sm font-medium">Nuxt</span>
      </a>
      <a href="/docs/sdks/sveltekit/" class="flex flex-col items-center p-4 border border-border rounded-lg hover:bg-muted/50 transition-colors">
          <Icon name="simple-icons:svelte" class="w-8 h-8 mb-2" />
          <span class="text-sm font-medium">SvelteKit</span>
      </a>
      <a href="/docs/sdks/angular/" class="flex flex-col items-center p-4 border border-border rounded-lg hover:bg-muted/50 transition-colors">
          <Icon name="simple-icons:angular" class="w-8 h-8 mb-2" />
          <span class="text-sm font-medium">Angular</span>
      </a>
  </div>
</DocsLayout>
