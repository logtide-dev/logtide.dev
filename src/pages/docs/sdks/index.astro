---
import DocsLayout from '../../../layouts/Docs.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardDescription from '../../../components/ui/CardDescription.astro';
import CardContent from '../../../components/ui/CardContent.astro';
import Button from '../../../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

const headings = [
  { text: "Available SDKs", slug: "available-sdks", depth: 2 },
  { text: "Common Features", slug: "common-features", depth: 2 },
  { text: "Next Steps", slug: "next-steps", depth: 2 }
];
---

<DocsLayout
  title="Official SDKs"
  description="LogTide official SDKs for Node.js, Python, Go, PHP, Kotlin, Ruby, and C#."
  headings={headings}
>
  <h1 class="text-3xl font-bold mb-4">Official SDKs</h1>
  <p class="text-lg text-muted-foreground mb-8">
      LogTide provides official SDKs for multiple programming languages,
      making it easy to integrate log management into your applications.
  </p>

  <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-4 mb-8">
      <div class="flex items-start gap-3">
          <div class="flex-1">
              <p class="font-semibold text-blue-600 dark:text-blue-400 mb-1">
                  Don't want to install an SDK?
              </p>
              <p class="text-sm text-muted-foreground mb-2">
                  No problem! LogTide supports stdout-based logging for
                  <strong>any language</strong> (Rust, Ruby, Java, .NET, etc.).
                  Just write to stdout and configure Fluent Bit to collect your logs.
              </p>
              <a
                  href="/docs/no-sdk-setup/"
                  class="text-primary underline text-sm hover:text-primary/80"
              >
                  Learn more about No-SDK Setup →
              </a>
          </div>
      </div>
  </div>

  <h2
      id="available-sdks"
      class="text-2xl font-semibold mb-6 scroll-mt-24 border-b border-border pb-2"
  >
      Available SDKs
  </h2>

  <div class="grid md:grid-cols-2 gap-6 mb-12">
      <!-- JavaScript & Browser SDKs -->
      <Card class="md:col-span-2 border-primary/20">
          <CardHeader>
              <div class="flex items-center justify-between">
                  <CardTitle class="flex items-center gap-2">
                      <Icon name="simple-icons:javascript" class="w-5 h-5 text-primary" />
                      JavaScript & Browser SDKs
                  </CardTitle>
                  <div class="flex items-center gap-1">
                      <a
                          href="https://github.com/logtide-dev/logtide-js"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="GitHub"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:github" class="w-4 h-4" />
                          </Button>
                      </a>
                      <a
                          href="https://www.npmjs.com/org/logtide"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="npm"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:npm" class="w-4 h-4" />
                          </Button>
                      </a>
                  </div>
              </div>
              <CardDescription>
                  Full-stack observability with Node.js, Browser, and Framework-specific packages
              </CardDescription>
          </CardHeader>
          <CardContent>
              <div class="grid md:grid-cols-2 gap-6">
                  <div class="space-y-3">
                      <div>
                          <p class="text-sm font-semibold mb-1">Node.js / Backend:</p>
                          <code class="text-xs bg-muted px-2 py-1 rounded">npm install @logtide/core</code>
                      </div>
                      <div>
                          <p class="text-sm font-semibold mb-1">Browser / Frontend:</p>
                          <code class="text-xs bg-muted px-2 py-1 rounded">npm install @logtide/browser</code>
                      </div>
                      <div>
                          <p class="text-sm font-semibold mb-1">CLI Tool:</p>
                          <code class="text-xs bg-muted px-2 py-1 rounded">npm install -g @logtide/cli</code>
                      </div>
                  </div>
                  <div class="space-y-3">
                      <div>
                          <p class="text-sm font-semibold mb-1">Features:</p>
                          <ul class="text-sm text-muted-foreground space-y-1 list-none pl-0">
                              <li>✅ Session tracking & Web Vitals</li>
                              <li>✅ Source maps upload (CLI)</li>
                              <li>✅ Distributed tracing & Spans</li>
                              <li>✅ Offline transport support</li>
                          </ul>
                      </div>
                  </div>
              </div>
              <div class="mt-4">
                  <p class="text-sm font-semibold mb-2">Framework & Platform packages:</p>
                  <div class="flex flex-wrap gap-2 mb-4">
                      <a href="/docs/sdks/browser/" class="text-xs bg-primary/10 text-primary font-medium px-2 py-1 rounded hover:bg-primary/20 transition-colors">@logtide/browser</a>
                      <a href="/docs/sdks/nodejs/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">@logtide/sdk-node</a>
                      <a href="/docs/sdks/nextjs-sdk/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">@logtide/nextjs</a>
                      <a href="/docs/sdks/nuxt-sdk/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">@logtide/nuxt</a>
                      <a href="/docs/sdks/sveltekit/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">@logtide/sveltekit</a>
                      <a href="/docs/sdks/angular/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">@logtide/angular</a>
                      <a href="/docs/sdks/express/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">@logtide/express</a>
                      <a href="/docs/sdks/fastify/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">@logtide/fastify</a>
                      <a href="/docs/sdks/hono/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">@logtide/hono</a>
                      <a href="/docs/sdks/elysia/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">@logtide/elysia</a>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                      <a href="/docs/sdks/nodejs/">
                          <Button variant="outline" size="sm" class="w-full">
                              Node.js Docs
                          </Button>
                      </a>
                      <a href="/docs/sdks/browser/">
                          <Button variant="default" size="sm" class="w-full">
                              Browser Docs
                          </Button>
                      </a>
                  </div>
              </div>
          </CardContent>
      </Card>

      <!-- Python SDK -->
      <Card>
          <CardHeader>
              <div class="flex items-center justify-between">
                  <CardTitle class="flex items-center gap-2">
                      <Icon name="simple-icons:python" class="w-5 h-5 text-primary" />
                      Python SDK
                  </CardTitle>
                  <div class="flex items-center gap-1">
                      <a
                          href="https://github.com/logtide-dev/logtide-python"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="GitHub"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:github" class="w-4 h-4" />
                          </Button>
                      </a>
                      <a
                          href="https://pypi.org/project/logtide-sdk/"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="PyPI"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:pypi" class="w-4 h-4" />
                          </Button>
                      </a>
                  </div>
              </div>
              <CardDescription>
                  Official SDK for Python 3.8+ — sync &amp; async clients, middleware, stdlib logging
              </CardDescription>
          </CardHeader>
          <CardContent>
              <div class="space-y-3">
                  <div>
                      <p class="text-sm font-semibold mb-1">Installation:</p>
                      <code class="text-xs bg-muted px-2 py-1 rounded">pip install logtide-sdk</code>
                  </div>
                  <div>
                      <p class="text-sm font-semibold mb-1">Features:</p>
                      <ul class="text-sm text-muted-foreground space-y-1 list-none pl-0">
                          <li>✅ Sync &amp; async clients (aiohttp)</li>
                          <li>✅ stdlib <code class="bg-muted px-1 rounded text-xs">logging</code> handler</li>
                          <li>✅ Flask, Django, FastAPI &amp; Starlette middleware</li>
                          <li>✅ Circuit breaker &amp; payload limits</li>
                          <li>✅ Trace ID context managers</li>
                      </ul>
                  </div>
                  <a href="/docs/sdks/python/">
                      <Button variant="outline" size="sm" class="w-full mt-2">
                          View Documentation
                      </Button>
                  </a>
              </div>
          </CardContent>
      </Card>

      <!-- Go SDK -->
      <Card>
          <CardHeader>
              <div class="flex items-center justify-between">
                  <CardTitle class="flex items-center gap-2">
                      <Icon name="simple-icons:go" class="w-5 h-5 text-primary" />
                      Go SDK
                  </CardTitle>
                  <div class="flex items-center gap-1">
                      <a
                          href="https://github.com/logtide-dev/logtide-sdk-go"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="GitHub"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:github" class="w-4 h-4" />
                          </Button>
                      </a>
                      <a
                          href="https://pkg.go.dev/github.com/logtide-dev/logtide-sdk-go"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="pkg.go.dev"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:go" class="w-4 h-4" />
                          </Button>
                      </a>
                  </div>
              </div>
              <CardDescription>
                  Official SDK for Go applications
              </CardDescription>
          </CardHeader>
          <CardContent>
              <div class="space-y-3">
                  <div>
                      <p class="text-sm font-semibold mb-1">Installation:</p>
                      <code class="text-xs bg-muted px-2 py-1 rounded">go get github.com/logtide-dev/logtide-sdk-go</code>
                  </div>
                  <div>
                      <p class="text-sm font-semibold mb-1">Features:</p>
                      <ul class="text-sm text-muted-foreground space-y-1 list-none pl-0">
                          <li>✅ Goroutine-safe logging</li>
                          <li>✅ Automatic batching & retry</li>
                          <li>✅ Context support for tracing</li>
                      </ul>
                  </div>
                  <a href="/docs/sdks/go/">
                      <Button variant="outline" size="sm" class="w-full mt-2">
                          View Documentation
                      </Button>
                  </a>
              </div>
          </CardContent>
      </Card>

      <!-- PHP SDK -->
      <Card class="md:col-span-2 border-primary/20">
          <CardHeader>
              <div class="flex items-center justify-between">
                  <CardTitle class="flex items-center gap-2">
                      <Icon name="simple-icons:php" class="w-5 h-5 text-primary" />
                      PHP SDK
                  </CardTitle>
                  <div class="flex items-center gap-1">
                      <a
                          href="https://github.com/logtide-dev/logtide-php-sdk"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="GitHub"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:github" class="w-4 h-4" />
                          </Button>
                      </a>
                      <a
                          href="https://packagist.org/packages/logtide/logtide"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="Packagist"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:packagist" class="w-4 h-4" />
                          </Button>
                      </a>
                  </div>
              </div>
              <CardDescription>
                  Core SDK + 4 framework-specific packages for PHP 8.1+
              </CardDescription>
          </CardHeader>
          <CardContent>
              <div class="space-y-3">
                  <div>
                      <p class="text-sm font-semibold mb-1">Core package:</p>
                      <code class="text-xs bg-muted px-2 py-1 rounded">composer require logtide/logtide</code>
                  </div>
                  <div>
                      <p class="text-sm font-semibold mb-1">Features:</p>
                      <ul class="text-sm text-muted-foreground space-y-1 list-none pl-0">
                          <li>✅ DSN-based configuration</li>
                          <li>✅ Distributed tracing (W3C Trace Context)</li>
                          <li>✅ Breadcrumbs, scopes & spans</li>
                          <li>✅ Built-in Monolog handlers</li>
                      </ul>
                  </div>
                  <div>
                      <p class="text-sm font-semibold mb-2">Framework packages:</p>
                      <div class="flex flex-wrap gap-2">
                          <a href="/docs/sdks/laravel/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">logtide/logtide-laravel</a>
                          <a href="/docs/sdks/symfony/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">logtide/logtide-symfony</a>
                          <a href="/docs/sdks/slim/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">logtide/logtide-slim</a>
                          <a href="/docs/sdks/wordpress/" class="text-xs bg-muted px-2 py-1 rounded hover:bg-muted/80 transition-colors">logtide/logtide-wordpress</a>
                      </div>
                  </div>
                  <a href="/docs/sdks/php/">
                      <Button variant="outline" size="sm" class="w-full mt-2">
                          View Documentation
                      </Button>
                  </a>
              </div>
          </CardContent>
      </Card>

      <!-- Kotlin SDK -->
      <Card>
          <CardHeader>
              <div class="flex items-center justify-between">
                  <CardTitle class="flex items-center gap-2">
                      <Icon name="simple-icons:kotlin" class="w-5 h-5 text-primary" />
                      Kotlin SDK
                  </CardTitle>
                  <div class="flex items-center gap-1">
                      <a
                          href="https://github.com/logtide-dev/logtide-kotlin-java"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="GitHub"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:github" class="w-4 h-4" />
                          </Button>
                      </a>
                      <a
                          href="https://central.sonatype.com/artifact/io.github.logtide-dev/logtide-core"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="Maven Central"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:apachemaven" class="w-4 h-4" />
                          </Button>
                      </a>
                  </div>
              </div>
              <CardDescription>
                  Official SDK for Kotlin & JVM applications
              </CardDescription>
          </CardHeader>
          <CardContent>
              <div class="space-y-3">
                  <div>
                      <p class="text-sm font-semibold mb-1">Installation:</p>
                      <code class="text-xs bg-muted px-2 py-1 rounded">implementation("io.github.logtide-dev:logtide-core:0.9.8")</code>
                  </div>
                  <div>
                      <p class="text-sm font-semibold mb-1">Features:</p>
                      <ul class="text-sm text-muted-foreground space-y-1 list-none pl-0">
                          <li>✅ Coroutines support</li>
                          <li>✅ Ktor, Spring Boot & Jakarta middleware</li>
                          <li>✅ Multiplatform ready</li>
                      </ul>
                  </div>
                  <a href="/docs/sdks/kotlin/">
                      <Button variant="outline" size="sm" class="w-full mt-2">
                          View Documentation
                      </Button>
                  </a>
              </div>
          </CardContent>
      </Card>

      <!-- Ruby SDK -->
      <Card>
          <CardHeader>
              <div class="flex items-center justify-between">
                  <CardTitle class="flex items-center gap-2">
                      <Icon name="simple-icons:ruby" class="w-5 h-5 text-primary" />
                      Ruby SDK
                  </CardTitle>
                  <div class="flex items-center gap-1">
                      <a
                          href="https://github.com/logtide-dev/logtide-ruby"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="GitHub"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:github" class="w-4 h-4" />
                          </Button>
                      </a>
                      <a
                          href="https://rubygems.org/gems/logtide"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="RubyGems"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:rubygems" class="w-4 h-4" />
                          </Button>
                      </a>
                  </div>
              </div>
              <CardDescription>
                  Official SDK for Ruby 3.1+ — Rack middleware, Rails Railtie, stdlib only
              </CardDescription>
          </CardHeader>
          <CardContent>
              <div class="space-y-3">
                  <div>
                      <p class="text-sm font-semibold mb-1">Installation:</p>
                      <code class="text-xs bg-muted px-2 py-1 rounded">gem install logtide</code>
                  </div>
                  <div>
                      <p class="text-sm font-semibold mb-1">Features:</p>
                      <ul class="text-sm text-muted-foreground space-y-1 list-none pl-0">
                          <li>✅ Rack middleware & Rails Railtie</li>
                          <li>✅ stdlib <code class="bg-muted px-1 rounded text-xs">Logger</code> bridge</li>
                          <li>✅ Spans, OTLP export & W3C traceparent</li>
                          <li>✅ Circuit breaker & bounded buffer</li>
                          <li>✅ Zero runtime dependencies</li>
                      </ul>
                  </div>
                  <a href="/docs/sdks/ruby/">
                      <Button variant="outline" size="sm" class="w-full mt-2">
                          View Documentation
                      </Button>
                  </a>
              </div>
          </CardContent>
      </Card>

      <!-- C# / .NET SDK -->
      <Card>
          <CardHeader>
              <div class="flex items-center justify-between">
                  <CardTitle class="flex items-center gap-2">
                      <Icon name="simple-icons:dotnet" class="w-5 h-5 text-primary" />
                      C# / .NET SDK
                  </CardTitle>
                  <div class="flex items-center gap-1">
                      <a
                          href="https://github.com/logtide-dev/logtide-dotnet"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="GitHub"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:github" class="w-4 h-4" />
                          </Button>
                      </a>
                      <a
                          href="https://www.nuget.org/packages/LogTide.SDK"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="NuGet"
                      >
                          <Button variant="ghost" size="sm">
                              <Icon name="simple-icons:nuget" class="w-4 h-4" />
                          </Button>
                      </a>
                  </div>
              </div>
              <CardDescription>
                  Official SDK for .NET 8/9 applications
              </CardDescription>
          </CardHeader>
          <CardContent>
              <div class="space-y-3">
                  <div>
                      <p class="text-sm font-semibold mb-1">Installation:</p>
                      <code class="text-xs bg-muted px-2 py-1 rounded">dotnet add package LogTide.SDK</code>
                  </div>
                  <div>
                      <p class="text-sm font-semibold mb-1">Features:</p>
                      <ul class="text-sm text-muted-foreground space-y-1 list-none pl-0">
                          <li>✅ W3C traceparent & span tracking</li>
                          <li>✅ ASP.NET Core middleware</li>
                          <li>✅ Serilog sink available</li>
                      </ul>
                  </div>
                  <a href="/docs/sdks/csharp/">
                      <Button variant="outline" size="sm" class="w-full mt-2">
                          View Documentation
                      </Button>
                  </a>
              </div>
          </CardContent>
      </Card>
  </div>

  <h2
      id="common-features"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Common Features
  </h2>

  <div class="mb-8">
      <p class="mb-4 text-muted-foreground">
          All LogTide SDKs share these core features:
      </p>

      <div class="grid md:grid-cols-2 gap-4">
          <Card class="flex flex-col h-full">
              <CardHeader>
                  <CardTitle class="text-base">🚀 Performance</CardTitle>
              </CardHeader>
              <CardContent class="text-sm text-muted-foreground">
                  <ul class="space-y-1 list-none pl-0">
                      <li>• Automatic batching for efficiency</li>
                      <li>• Configurable batch size and intervals</li>
                      <li>• Async processing to avoid blocking</li>
                  </ul>
              </CardContent>
          </Card>

          <Card class="flex flex-col h-full">
              <CardHeader>
                  <CardTitle class="text-base">🛡️ Reliability</CardTitle>
              </CardHeader>
              <CardContent class="text-sm text-muted-foreground">
                  <ul class="space-y-1 list-none pl-0">
                      <li>• Retry logic with exponential backoff</li>
                      <li>• Circuit breaker for fault tolerance</li>
                      <li>• Max buffer size to prevent memory leaks</li>
                  </ul>
              </CardContent>
          </Card>

          <Card class="flex flex-col h-full">
              <CardHeader>
                  <CardTitle class="text-base">🔍 Query & Streaming</CardTitle>
              </CardHeader>
              <CardContent class="text-sm text-muted-foreground">
                  <ul class="space-y-1 list-none pl-0">
                      <li>• Query API for log search</li>
                      <li>• Live tail with Server-Sent Events</li>
                      <li>• Trace ID correlation support</li>
                  </ul>
              </CardContent>
          </Card>

          <Card class="flex flex-col h-full">
              <CardHeader>
                  <CardTitle class="text-base">📊 Observability</CardTitle>
              </CardHeader>
              <CardContent class="text-sm text-muted-foreground">
                  <ul class="space-y-1 list-none pl-0">
                      <li>• Internal metrics (sent, errors, latency)</li>
                      <li>• Global metadata support</li>
                      <li>• Structured error serialization</li>
                  </ul>
              </CardContent>
          </Card>
      </div>
  </div>

  <h2
      id="next-steps"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Next Steps
  </h2>

  <p class="text-muted-foreground mb-4">
      Choose your SDK and follow the documentation to integrate LogTide into
      your application. Each SDK page includes:
  </p>

  <ul class="list-none ml-6 text-muted-foreground space-y-2 mb-6">
      <li>Installation instructions</li>
      <li>Quick start examples</li>
      <li>Configuration options</li>
      <li>Framework middleware integration</li>
      <li>API reference</li>
  </ul>
</DocsLayout>
