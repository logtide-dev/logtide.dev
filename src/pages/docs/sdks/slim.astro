---
import DocsLayout from '../../../layouts/Docs.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardContent from '../../../components/ui/CardContent.astro';
import Button from '../../../components/ui/Button.astro';
import { Code } from 'astro:components';
import { Icon } from 'astro-icon/components';

const headings = [
  { text: "Installation", slug: "installation", depth: 2 },
  { text: "Quick Start", slug: "quick-start", depth: 2 },
  { text: "LogtideMiddleware", slug: "middleware", depth: 2 },
  { text: "Error Middleware", slug: "error-middleware", depth: 2 },
  { text: "Best Practices", slug: "best-practices", depth: 2 }
];
---

<DocsLayout
  title="Slim SDK"
  description="LogTide integration for Slim Framework 4 with PSR-15 middleware, route pattern resolution, and error handling."
  headings={headings}
>
  <div class="flex items-center justify-between mb-4">
      <h1 class="text-3xl font-bold">Slim SDK</h1>
      <div class="flex items-center gap-2">
          <a
              href="https://github.com/logtide-dev/logtide-slim"
              target="_blank"
              rel="noopener noreferrer"
          >
              <Button variant="ghost" size="sm" class="gap-1.5">
                  <Icon name="simple-icons:github" class="w-4 h-4" />
                  GitHub
              </Button>
          </a>
          <a
              href="https://packagist.org/packages/logtide/logtide-slim"
              target="_blank"
              rel="noopener noreferrer"
          >
              <Button variant="ghost" size="sm" class="gap-1.5">
                  <Icon name="simple-icons:packagist" class="w-4 h-4" />
                  Packagist
              </Button>
          </a>
      </div>
  </div>

  <p class="text-lg text-muted-foreground mb-8">
      PSR-15 middleware pair for Slim 4. One middleware handles request tracing with
      automatic route pattern resolution; an optional second handles error capture.
  </p>

  <h2
      id="installation"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Installation
  </h2>

  <div class="mb-8">
      <Code lang="bash" theme="one-dark-pro" code={`composer require logtide/logtide-slim`} />
  </div>

  <h2
      id="quick-start"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Quick Start
  </h2>

  <div class="mb-8">
      <Code
          lang="php"
          theme="one-dark-pro"
          code={`<?php

use LogTide\\Slim\\LogtideMiddleware;
use LogTide\\Slim\\LogtideErrorMiddleware;
use Slim\\Factory\\AppFactory;

// Initialize the SDK
\\LogTide\\init([
    'dsn' => 'https://lp_abc123@api.logtide.dev',
    'service' => 'slim-api',
    'environment' => 'production',
]);

$app = AppFactory::create();

// Add routing middleware first (required for route pattern resolution)
$app->addRoutingMiddleware();

// Add LogTide middleware
$app->add(new LogtideMiddleware());

// Optional: replace Slim's error middleware with LogTide's
$app->add(new LogtideErrorMiddleware());

$app->get('/users/{id}', function ($request, $response, $args) {
    // Your route handler
    return $response;
});

$app->run();`}
      />
  </div>

  <h2
      id="middleware"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      LogtideMiddleware
  </h2>

  <p class="text-muted-foreground mb-4">
      The main middleware wraps each HTTP request with a scope and span:
  </p>

  <div class="mb-8">
      <ul class="list-none pl-0 space-y-2 text-muted-foreground mb-6">
          <li>&#x2022; Creates an isolated scope per request</li>
          <li>&#x2022; Extracts <code class="bg-muted px-1 rounded">traceparent</code> header for distributed tracing</li>
          <li>&#x2022; Resolves Slim route patterns (e.g., <code class="bg-muted px-1 rounded">/users/{'{'}id{'}'}</code>) for span names</li>
          <li>&#x2022; Records HTTP request and response breadcrumbs</li>
          <li>&#x2022; Captures 5xx responses and exceptions</li>
          <li>&#x2022; Injects <code class="bg-muted px-1 rounded">traceparent</code> into response</li>
      </ul>

      <Code
          lang="php"
          theme="one-dark-pro"
          code={`<?php

// Skip health check paths
$app->add(new LogtideMiddleware(
    skipPaths: ['/health', '/healthz', '/metrics'],
));`}
      />
  </div>

  <h2
      id="error-middleware"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Error Middleware
  </h2>

  <p class="text-muted-foreground mb-4">
      An optional error middleware that captures all thrown exceptions. Use it as an alternative
      to Slim's built-in error middleware:
  </p>

  <div class="mb-8">
      <Code
          lang="php"
          theme="one-dark-pro"
          code={`<?php

use LogTide\\Slim\\LogtideErrorMiddleware;

// This captures exceptions and reports them to LogTide,
// then re-throws so Slim's error handling still works
$app->add(new LogtideErrorMiddleware());`}
      />
  </div>

  <h2
      id="best-practices"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Best Practices
  </h2>

  <div class="space-y-4">
      <Card>
          <CardHeader>
              <CardTitle class="text-base">1. Middleware Order</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              Add <code class="bg-muted px-1 rounded">addRoutingMiddleware()</code> before
              <code class="bg-muted px-1 rounded">LogtideMiddleware</code> so route patterns can be resolved
              for span names (e.g., <code class="bg-muted px-1 rounded">HTTP GET /users/{'{'}id{'}'}</code> instead of <code class="bg-muted px-1 rounded">HTTP GET /users/123</code>).
          </CardContent>
      </Card>

      <Card>
          <CardHeader>
              <CardTitle class="text-base">2. PSR-15 Compatible</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              Both middlewares implement <code class="bg-muted px-1 rounded">MiddlewareInterface</code> and work with
              any PSR-15 compatible dispatcher, not just Slim.
          </CardContent>
      </Card>
  </div>
</DocsLayout>
