---
import DocsLayout from '../../../layouts/Docs.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardContent from '../../../components/ui/CardContent.astro';
import Button from '../../../components/ui/Button.astro';
import { Code } from 'astro:components';
import { Icon } from 'astro-icon/components';

const headings = [
  { text: "Installation", slug: "installation", depth: 2 },
  { text: "Quick Start", slug: "quick-start", depth: 2 },
  { text: "Configuration", slug: "configuration", depth: 2 },
  { text: "Request Subscriber", slug: "request-subscriber", depth: 2 },
  { text: "Console Subscriber", slug: "console-subscriber", depth: 2 },
  { text: "Doctrine Integration", slug: "doctrine", depth: 2 },
  { text: "Using the Hub", slug: "hub", depth: 2 },
  { text: "Best Practices", slug: "best-practices", depth: 2 }
];
---

<DocsLayout
  title="Symfony SDK"
  description="LogTide Symfony Bundle with semantic configuration, request/console event subscribers, and Doctrine query tracking."
  headings={headings}
>
  <div class="flex items-center justify-between mb-4">
      <h1 class="text-3xl font-bold">Symfony SDK</h1>
      <div class="flex items-center gap-2">
          <a
              href="https://github.com/logtide-dev/logtide-symfony"
              target="_blank"
              rel="noopener noreferrer"
          >
              <Button variant="ghost" size="sm" class="gap-1.5">
                  <Icon name="simple-icons:github" class="w-4 h-4" />
                  GitHub
              </Button>
          </a>
          <a
              href="https://packagist.org/packages/logtide/logtide-symfony"
              target="_blank"
              rel="noopener noreferrer"
          >
              <Button variant="ghost" size="sm" class="gap-1.5">
                  <Icon name="simple-icons:packagist" class="w-4 h-4" />
                  Packagist
              </Button>
          </a>
      </div>
  </div>

  <p class="text-lg text-muted-foreground mb-8">
      A proper Symfony Bundle for Symfony 6.4 and 7.x with semantic YAML/XML configuration,
      DI container integration, and event subscribers for automated request/console tracing.
  </p>

  <h2
      id="installation"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Installation
  </h2>

  <div class="mb-8">
      <Code lang="bash" theme="one-dark-pro" code={`composer require logtide/logtide-symfony`} />
  </div>

  <p class="text-muted-foreground mb-4">
      If you're using Symfony Flex, the bundle is registered automatically.
      Otherwise, add it to <code class="bg-muted px-1 rounded">config/bundles.php</code>:
  </p>

  <div class="mb-8">
      <Code
          lang="php"
          theme="one-dark-pro"
          code={`<?php
// config/bundles.php

return [
    // ...
    LogTide\\Symfony\\LogtideBundle::class => ['all' => true],
];`}
      />
  </div>

  <h2
      id="quick-start"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Quick Start
  </h2>

  <div class="mb-8 space-y-4">
      <p class="text-muted-foreground">Add your DSN to <code class="bg-muted px-1 rounded">.env</code>:</p>
      <Code
          lang="bash"
          theme="one-dark-pro"
          code={`LOGTIDE_DSN=https://lp_abc123@api.logtide.dev`}
      />

      <p class="text-muted-foreground">Create the bundle configuration:</p>
      <Code
          lang="yaml"
          theme="one-dark-pro"
          code={`# config/packages/logtide.yaml
logtide:
    dsn: '%env(LOGTIDE_DSN)%'
    environment: '%kernel.environment%'`}
      />

      <p class="text-muted-foreground">That's it! The bundle registers the Hub, event subscribers, and integrations automatically.</p>
  </div>

  <h2
      id="configuration"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Configuration
  </h2>

  <div class="mb-8">
      <Code
          lang="yaml"
          theme="one-dark-pro"
          code={`# config/packages/logtide.yaml
logtide:
    dsn: '%env(LOGTIDE_DSN)%'
    service: 'my-symfony-app'         # default: 'symfony'
    environment: '%kernel.environment%'
    release: '1.2.3'

    # Batching
    batch_size: 100                   # default: 100
    flush_interval: 5000              # ms, default: 5000
    max_buffer_size: 10000            # default: 10000
    max_retries: 3                    # default: 3

    # Tracing
    traces_sample_rate: 1.0           # 0.0-1.0, default: 1.0

    # Privacy
    send_default_pii: false           # default: false

    # Debug
    debug: false                      # default: false`}
      />
  </div>

  <h3 class="text-lg font-semibold mb-3 scroll-mt-24">Configuration Reference</h3>

  <div class="mb-8 overflow-x-auto">
      <table class="w-full text-sm">
          <thead>
              <tr>
                  <th class="text-left p-3 border-b border-border font-semibold">Option</th>
                  <th class="text-left p-3 border-b border-border font-semibold">Type</th>
                  <th class="text-left p-3 border-b border-border font-semibold">Default</th>
                  <th class="text-left p-3 border-b border-border font-semibold">Description</th>
              </tr>
          </thead>
          <tbody class="text-muted-foreground">
              <tr><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">dsn</code></td><td class="p-3 border-b border-border">string</td><td class="p-3 border-b border-border">&mdash;</td><td class="p-3 border-b border-border">Data Source Name</td></tr>
              <tr><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">service</code></td><td class="p-3 border-b border-border">string</td><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">'symfony'</code></td><td class="p-3 border-b border-border">Service name</td></tr>
              <tr><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">environment</code></td><td class="p-3 border-b border-border">string</td><td class="p-3 border-b border-border">&mdash;</td><td class="p-3 border-b border-border">Deployment environment</td></tr>
              <tr><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">release</code></td><td class="p-3 border-b border-border">string</td><td class="p-3 border-b border-border">&mdash;</td><td class="p-3 border-b border-border">App version</td></tr>
              <tr><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">batch_size</code></td><td class="p-3 border-b border-border">int</td><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">100</code></td><td class="p-3 border-b border-border">Max events per batch (min: 1)</td></tr>
              <tr><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">flush_interval</code></td><td class="p-3 border-b border-border">int</td><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">5000</code></td><td class="p-3 border-b border-border">Flush interval in ms (min: 100)</td></tr>
              <tr><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">traces_sample_rate</code></td><td class="p-3 border-b border-border">float</td><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">1.0</code></td><td class="p-3 border-b border-border">Trace sampling rate (0.0&ndash;1.0)</td></tr>
              <tr><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">send_default_pii</code></td><td class="p-3 border-b border-border">bool</td><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">false</code></td><td class="p-3 border-b border-border">Send PII (IP, cookies, etc.)</td></tr>
              <tr><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">debug</code></td><td class="p-3 border-b border-border">bool</td><td class="p-3 border-b border-border"><code class="bg-muted px-1 rounded text-xs">false</code></td><td class="p-3 border-b border-border">Enable internal debug logging</td></tr>
          </tbody>
      </table>
  </div>

  <h2
      id="request-subscriber"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Request Subscriber
  </h2>

  <p class="text-muted-foreground mb-4">
      The <code class="bg-muted px-1 rounded">RequestSubscriber</code> automatically handles scope lifecycle
      per HTTP request:
  </p>

  <div class="mb-8">
      <ul class="list-none pl-0 space-y-2 text-muted-foreground">
          <li>&#x2022; Pushes a new scope on <code class="bg-muted px-1 rounded">kernel.request</code></li>
          <li>&#x2022; Extracts <code class="bg-muted px-1 rounded">traceparent</code> header for distributed tracing</li>
          <li>&#x2022; Starts a SERVER span with HTTP method, route, and URL attributes</li>
          <li>&#x2022; Captures exceptions on <code class="bg-muted px-1 rounded">kernel.exception</code></li>
          <li>&#x2022; Finishes the span and pops the scope on <code class="bg-muted px-1 rounded">kernel.response</code></li>
          <li>&#x2022; Injects <code class="bg-muted px-1 rounded">traceparent</code> into outgoing response headers</li>
      </ul>
  </div>

  <h2
      id="console-subscriber"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Console Subscriber
  </h2>

  <p class="text-muted-foreground mb-4">
      Requires <code class="bg-muted px-1 rounded">symfony/console</code>. Automatically traces Artisan-like
      console commands:
  </p>

  <div class="mb-8">
      <ul class="list-none pl-0 space-y-2 text-muted-foreground">
          <li>&#x2022; Creates a span for each command on <code class="bg-muted px-1 rounded">console.command</code></li>
          <li>&#x2022; Captures errors on <code class="bg-muted px-1 rounded">console.error</code></li>
          <li>&#x2022; Finishes the span on <code class="bg-muted px-1 rounded">console.terminate</code></li>
      </ul>
  </div>

  <h2
      id="doctrine"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Doctrine Integration
  </h2>

  <p class="text-muted-foreground mb-4">
      Requires <code class="bg-muted px-1 rounded">doctrine/dbal</code>. Records SQL queries as breadcrumbs
      with query text, parameters, and execution time.
  </p>

  <div class="mb-8">
      <Code
          lang="php"
          theme="one-dark-pro"
          code={`<?php
// Doctrine queries are automatically recorded as breadcrumbs:
// {
//   type: "query",
//   category: "doctrine",
//   message: "SELECT u.* FROM users u WHERE u.id = ?",
//   data: { duration_ms: 2.5, params: [123] }
// }`}
      />
  </div>

  <h2
      id="hub"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Using the Hub
  </h2>

  <p class="text-muted-foreground mb-4">
      The <code class="bg-muted px-1 rounded">HubInterface</code> is registered as a service in the DI container.
      Inject it into your services or controllers:
  </p>

  <div class="mb-8">
      <Code
          lang="php"
          theme="one-dark-pro"
          code={`<?php

namespace App\\Controller;

use LogTide\\Enum\\LogLevel;
use LogTide\\State\\HubInterface;
use Symfony\\Bundle\\FrameworkBundle\\Controller\\AbstractController;
use Symfony\\Component\\HttpFoundation\\Response;

class OrderController extends AbstractController
{
    public function __construct(
        private readonly HubInterface $hub,
    ) {}

    public function checkout(): Response
    {
        $this->hub->captureLog(LogLevel::INFO, 'Checkout started', [
            'user_id' => $this->getUser()->getId(),
        ]);

        try {
            // ... process order
        } catch (\\Throwable $e) {
            $this->hub->captureException($e);
            throw $e;
        }

        return $this->json(['status' => 'ok']);
    }
}`}
      />
  </div>

  <p class="text-muted-foreground mb-4">
      You can also use the procedural API anywhere in your code:
  </p>

  <div class="mb-8">
      <Code
          lang="php"
          theme="one-dark-pro"
          code={`<?php

use function LogTide\\{info, error, captureException, addBreadcrumb};
use LogTide\\Breadcrumb\\Breadcrumb;
use LogTide\\Enum\\BreadcrumbType;

addBreadcrumb(new Breadcrumb(BreadcrumbType::DEFAULT, 'Processing order', category: 'app'));
info('Order processed', ['order_id' => $orderId]);`}
      />
  </div>

  <h2
      id="best-practices"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Best Practices
  </h2>

  <div class="space-y-4">
      <Card>
          <CardHeader>
              <CardTitle class="text-base">1. Use Kernel Environment</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              Set <code class="bg-muted px-1 rounded">environment: '%kernel.environment%'</code> in the config
              to automatically pick up <code class="bg-muted px-1 rounded">dev</code>, <code class="bg-muted px-1 rounded">prod</code>,
              or <code class="bg-muted px-1 rounded">test</code>.
          </CardContent>
      </Card>

      <Card>
          <CardHeader>
              <CardTitle class="text-base">2. Type-Hint HubInterface</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              Inject <code class="bg-muted px-1 rounded">LogTide\State\HubInterface</code> into your services
              via constructor injection. Autowiring resolves it automatically.
          </CardContent>
      </Card>

      <Card>
          <CardHeader>
              <CardTitle class="text-base">3. Messenger Workers</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              Make sure the <code class="bg-muted px-1 rounded">LOGTIDE_DSN</code> environment variable is available
              to your Messenger worker processes for background job monitoring.
          </CardContent>
      </Card>
  </div>
</DocsLayout>
