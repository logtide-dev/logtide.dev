---
import DocsLayout from '../../../layouts/Docs.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardContent from '../../../components/ui/CardContent.astro';
import Button from '../../../components/ui/Button.astro';
import { Code } from 'astro:components';
import { Icon } from 'astro-icon/components';

const headings = [
  { text: "Installation", slug: "installation", depth: 2 },
  { text: "Quick Start", slug: "quick-start", depth: 2 },
  { text: "Configuration", slug: "configuration", depth: 2 },
  { text: "Logging Methods", slug: "logging", depth: 2 },
  { text: "Hub & Scope", slug: "hub-scope", depth: 2 },
  { text: "Error Capture", slug: "error-capture", depth: 2 },
  { text: "slog Handler", slug: "slog", depth: 2 },
  { text: "OpenTelemetry", slug: "opentelemetry", depth: 2 },
  { text: "HTTP Middleware", slug: "http-middleware", depth: 2 },
  { text: "Best Practices", slug: "best-practices", depth: 2 }
];
---

<DocsLayout
  title="Go SDK"
  description="Official Go SDK for LogTide with batching, retry logic, circuit breaker, and OpenTelemetry integration."
  headings={headings}
>
  <div class="flex items-center justify-between mb-4">
      <h1 class="text-3xl font-bold">Go SDK</h1>
      <div class="flex items-center gap-2">
          <a
              href="https://github.com/logtide-dev/logtide-go"
              target="_blank"
              rel="noopener noreferrer"
          >
              <Button variant="ghost" size="sm" class="gap-1.5">
                  <Icon name="simple-icons:github" class="w-4 h-4" />
                  GitHub
              </Button>
          </a>
          <a
              href="https://pkg.go.dev/github.com/logtide-dev/logtide-sdk-go"
              target="_blank"
              rel="noopener noreferrer"
          >
              <Button variant="ghost" size="sm" class="gap-1.5">
                  <Icon name="simple-icons:go" class="w-4 h-4" />
                  pkg.go.dev
              </Button>
          </a>
      </div>
  </div>

  <p class="text-lg text-muted-foreground mb-8">
      Official Go SDK for LogTide with automatic batching, retry logic,
      circuit breaker pattern, Hub/Scope context isolation, and native OpenTelemetry integration.
  </p>

  <h2
      id="installation"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Installation
  </h2>

  <div class="mb-8">
      <Code
          lang="bash"
          theme="one-dark-pro"
          code={`go get github.com/logtide-dev/logtide-sdk-go`}
      />
  </div>

  <p class="text-sm text-muted-foreground mb-8">Requires Go 1.23 or later.</p>

  <h2
      id="quick-start"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Quick Start
  </h2>

  <div class="mb-4">
      <h3 class="text-lg font-semibold mb-3">Global singleton (recommended)</h3>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`package main

import (
    "context"
    logtide "github.com/logtide-dev/logtide-sdk-go"
)

func main() {
    flush := logtide.Init(logtide.ClientOptions{
        DSN:         "https://lp_your_api_key@api.logtide.dev",
        Service:     "my-service",
        Environment: "production",
        Release:     "v1.2.3",
    })
    defer flush()

    ctx := context.Background()
    logtide.Info(ctx, "Server started", map[string]any{"port": 8080})
    logtide.Error(ctx, "Connection failed", map[string]any{"host": "db.example.com"})
}`}
      />
  </div>

  <div class="mb-8">
      <h3 class="text-lg font-semibold mb-3">Explicit client</h3>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`opts := logtide.NewClientOptions()
opts.DSN     = "https://lp_your_api_key@api.logtide.dev"
opts.Service = "my-service"

client, err := logtide.NewClient(opts)
if err != nil {
    log.Fatal(err)
}
defer client.Close()

client.Info(context.Background(), "Hello LogTide!", nil)`}
      />
  </div>

  <h2
      id="configuration"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Configuration
  </h2>

  <div class="mb-8">
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`opts := logtide.NewClientOptions()

// Identity
opts.DSN         = "https://lp_your_api_key@api.logtide.dev" // required
opts.Service     = "my-service"                               // required
opts.Release     = "v1.2.3"
opts.Environment = "production"
opts.Tags        = map[string]string{"region": "eu-west-1"}

// Batching
opts.BatchSize     = 100               // entries per HTTP batch (default: 100)
opts.FlushInterval = 5 * time.Second   // (default: 5s)
opts.FlushTimeout  = 10 * time.Second  // (default: 10s)

// Reliability
opts.MaxRetries             = 3
opts.RetryMinBackoff        = 1 * time.Second
opts.RetryMaxBackoff        = 60 * time.Second
opts.CircuitBreakerThreshold = 5               // failures before open (default: 5)
opts.CircuitBreakerTimeout  = 30 * time.Second

// Stack traces
opts.AttachStacktrace = logtide.Bool(true) // default: true`}
      />
  </div>

  <h2
      id="logging"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Logging Methods
  </h2>

  <div class="mb-8">
      <p class="text-sm text-muted-foreground mb-3">
          All methods return an <code class="bg-muted px-1 rounded">EventID</code> (empty string if the entry was dropped).
      </p>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`ctx := context.Background()

client.Debug(ctx, "cache miss", map[string]any{"key": "user:42"})
client.Info(ctx, "request handled", map[string]any{"status": 200, "ms": 12})
client.Warn(ctx, "rate limit approaching", nil)
client.Error(ctx, "db query failed", map[string]any{"query": "SELECT ..."})
client.Critical(ctx, "out of memory", nil)`}
      />
  </div>

  <h2
      id="hub-scope"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Hub &amp; Scope
  </h2>

  <p class="text-sm text-muted-foreground mb-4">
      The Hub/Scope model lets you attach tags, breadcrumbs, and user info to all log entries
      within a logical unit of work — without passing extra parameters everywhere.
  </p>

  <div class="mb-4">
      <h3 class="text-lg font-semibold mb-3">Global scope</h3>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`logtide.ConfigureScope(func(s *logtide.Scope) {
    s.SetTag("region", "eu-west-1")
    s.SetUser(logtide.User{ID: "u123", Email: "alice@example.com"})
})`}
      />
  </div>

  <div class="mb-4">
      <h3 class="text-lg font-semibold mb-3">Per-request isolation</h3>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`logtide.PushScope()
defer logtide.PopScope()

logtide.ConfigureScope(func(s *logtide.Scope) {
    s.SetTag("request_id", requestID)
    s.AddBreadcrumb(&logtide.Breadcrumb{
        Category:  "auth",
        Message:   "user authenticated",
        Level:     logtide.LevelInfo,
        Timestamp: time.Now(),
    }, nil)
})

// All log calls here include request_id tag + breadcrumb
logtide.Info(ctx, "processing order", nil)`}
      />
  </div>

  <div class="mb-8">
      <h3 class="text-lg font-semibold mb-3">Per-request with explicit Hub</h3>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`hub := logtide.CurrentHub().Clone()
hub.ConfigureScope(func(s *logtide.Scope) {
    s.SetTag("request_id", r.Header.Get("X-Request-ID"))
})

// Inject into context for use downstream
ctx := logtide.SetHubOnContext(r.Context(), hub)
hub.Info(ctx, "request received", nil)`}
      />
  </div>

  <h2
      id="error-capture"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Error Capture
  </h2>

  <div class="mb-8">
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`result, err := db.Query(ctx, "SELECT ...")
if err != nil {
    // Captures the error with full stack trace automatically
    client.CaptureError(ctx, err, map[string]any{
        "query": "SELECT ...",
        "user":  userID,
    })
}`}
      />
  </div>

  <h2
      id="slog"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      slog Handler
  </h2>

  <p class="text-sm text-muted-foreground mb-4">
      The <code class="bg-muted px-1 rounded">logtideslog</code> integration provides a
      <code class="bg-muted px-1 rounded">log/slog</code> handler, so existing slog-based logging
      flows to LogTide without code changes. Records honour the client's full pipeline — scope merge,
      processors, <code class="bg-muted px-1 rounded">BeforeSend</code>, sampling, and batching.
  </p>

  <div class="mb-4">
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`import (
    "log/slog"

    logtide "github.com/logtide-dev/logtide-sdk-go"
    "github.com/logtide-dev/logtide-sdk-go/integrations/logtideslog"
)

client, err := logtide.NewClient(logtide.ClientOptions{
    DSN:     "https://lp_your_api_key@api.logtide.dev",
    Service: "my-service",
})
if err != nil {
    log.Fatal(err)
}
defer client.Close()

// opts may be nil (defaults to slog.LevelInfo).
handler := logtideslog.New(client, &logtideslog.Options{Level: slog.LevelDebug})
slog.SetDefault(slog.New(handler))

slog.Info("user signed in", "user_id", 42, "plan", "pro")
slog.Error("checkout failed", "err", err, "order_id", 1234)`}
      />
  </div>

  <p class="text-sm text-muted-foreground mb-8">
      Attributes become entry metadata, slog groups become nested metadata objects, and attribute
      values implementing <code class="bg-muted px-1 rounded">error</code> are promoted to structured
      exceptions so server-side error grouping works.
  </p>

  <h2
      id="opentelemetry"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      OpenTelemetry Integration
  </h2>

  <div class="mb-4">
      <h3 class="text-lg font-semibold mb-3">Automatic trace context</h3>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`tracer := otel.Tracer("my-service")

func handleRequest(ctx context.Context) {
    ctx, span := tracer.Start(ctx, "handle-request")
    defer span.End()

    // trace_id and span_id are included automatically
    client.Info(ctx, "Processing request", map[string]any{"user_id": 123})
}`}
      />
  </div>

  <div class="mb-4">
      <h3 class="text-lg font-semibold mb-3">Span exporter</h3>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`import "github.com/logtide-dev/logtide-sdk-go/integrations/otelexport"

integration := otelexport.New()

flush := logtide.Init(logtide.ClientOptions{
    DSN:     "https://lp_your_api_key@api.logtide.dev",
    Service: "my-service",
    Integrations: func(defaults []logtide.Integration) []logtide.Integration {
        return append(defaults, integration)
    },
})
defer flush()

tp := sdktrace.NewTracerProvider(
    sdktrace.WithBatcher(integration.Exporter()),
)`}
      />
  </div>

  <div class="mb-8">
      <h3 class="text-lg font-semibold mb-3">Metric exporter</h3>
      <p class="text-sm text-muted-foreground mb-3">
          Export OpenTelemetry metrics (counters, gauges, histograms) to LogTide. Each data point
          becomes a log entry carrying the same service name, environment, tags, and resource
          attributes as your logs and traces. It is opt-in — register it only if you need metrics.
      </p>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`import (
    "go.opentelemetry.io/otel"
    sdkmetric "go.opentelemetry.io/otel/sdk/metric"

    "github.com/logtide-dev/logtide-sdk-go/integrations/otelmetric"
)

integration := otelmetric.New()

flush := logtide.Init(logtide.ClientOptions{
    DSN:     "https://lp_your_api_key@api.logtide.dev",
    Service: "my-service",
    Integrations: func(defaults []logtide.Integration) []logtide.Integration {
        return append(defaults, integration)
    },
})
defer flush()

// A PeriodicReader collects metrics on an interval and hands them to the exporter.
mp := sdkmetric.NewMeterProvider(
    sdkmetric.WithReader(sdkmetric.NewPeriodicReader(integration.Exporter())),
)
otel.SetMeterProvider(mp)`}
      />
      <p class="text-sm text-muted-foreground mt-3">
          When exemplars are enabled and a sampled span is active during measurement, each linked
          data point's entry inherits the exemplar's <code class="bg-muted px-1 rounded">trace_id</code>/<code class="bg-muted px-1 rounded">span_id</code>,
          and the full exemplar list is recorded under <code class="bg-muted px-1 rounded">metadata.metric.exemplars</code> —
          correlating metrics with the traces that produced them.
      </p>
  </div>

  <div class="mb-8">
      <h3 class="text-lg font-semibold mb-3">Outbound trace propagation</h3>
      <p class="text-sm text-muted-foreground mb-3">
          Wrap an <code class="bg-muted px-1 rounded">http.Client</code> transport with
          <code class="bg-muted px-1 rounded">WrapTransport</code> to inject the W3C
          <code class="bg-muted px-1 rounded">traceparent</code> header on outbound requests, propagating the
          current trace context to downstream services. The trace context is sourced from the active
          OTel span, falling back to the scope carried by the request context. Requests with no active
          trace, or with a <code class="bg-muted px-1 rounded">traceparent</code> already set, pass through untouched.
      </p>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`// A nil base uses http.DefaultTransport.
client := &http.Client{Transport: logtide.WrapTransport(nil)}

// Pass the request-scoped context so the trace context propagates.
req, _ := http.NewRequestWithContext(ctx, http.MethodGet, "https://api.upstream.dev/users", nil)
resp, err := client.Do(req)`}
      />
  </div>

  <h2
      id="http-middleware"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      HTTP Middleware
  </h2>

  <div class="mb-8">
      <p class="text-sm text-muted-foreground mb-3">
          The built-in middleware automatically isolates scope per request, sets HTTP tags,
          parses <code class="bg-muted px-1 rounded">Traceparent</code> headers, and adds request/response breadcrumbs.
      </p>
      <Code
          lang="go"
          theme="one-dark-pro"
          code={`import lnethttp "github.com/logtide-dev/logtide-sdk-go/integrations/nethttp"

mux := http.NewServeMux()
mux.HandleFunc("/users", usersHandler)

// Wrap with LogTide middleware
http.ListenAndServe(":8080", lnethttp.Middleware(mux))`}
      />
  </div>

  <h2
      id="best-practices"
      class="text-2xl font-semibold mb-4 scroll-mt-24 border-b border-border pb-2"
  >
      Best Practices
  </h2>

  <div class="space-y-4">
      <Card>
          <CardHeader>
              <CardTitle class="text-base">1. Always defer flush/Close</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              Use <code class="bg-muted px-1 rounded">defer flush()</code> (global) or
              <code class="bg-muted px-1 rounded">defer client.Close()</code> (explicit client)
              immediately after initialisation to guarantee buffered entries are delivered on shutdown.
          </CardContent>
      </Card>

      <Card>
          <CardHeader>
              <CardTitle class="text-base">2. Clone the Hub per request</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              Never share a Hub across goroutines with different lifecycles.
              Call <code class="bg-muted px-1 rounded">hub.Clone()</code> at the start of each
              request or goroutine to get an isolated scope.
          </CardContent>
      </Card>

      <Card>
          <CardHeader>
              <CardTitle class="text-base">3. Use CaptureError for Go errors</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              <code class="bg-muted px-1 rounded">CaptureError</code> attaches a full stack trace automatically.
              Use it instead of <code class="bg-muted px-1 rounded">Error</code> whenever you have a Go
              <code class="bg-muted px-1 rounded">error</code> value.
          </CardContent>
      </Card>

      <Card>
          <CardHeader>
              <CardTitle class="text-base">4. Use the net/http middleware</CardTitle>
          </CardHeader>
          <CardContent class="text-sm text-muted-foreground">
              <code class="bg-muted px-1 rounded">nethttp.Middleware</code> handles scope isolation,
              HTTP tagging, and breadcrumbs automatically — no boilerplate needed.
          </CardContent>
      </Card>
  </div>
</DocsLayout>
