---
import { getCollection, type CollectionEntry } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import DifficultyBadge from '../../components/content/DifficultyBadge.astro';
import CategoryBadge from '../../components/content/CategoryBadge.astro';
import RelatedContent from '../../components/content/RelatedContent.astro';
import MoreFromSection from '../../components/content/MoreFromSection.astro';
import { Icon } from 'astro-icon/components';
import { execSync } from 'child_process';

export async function getStaticPaths() {
  const entries = await getCollection('integrations', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'integrations'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const title = entry.data.title;
const description = entry.data.description;

const pathname = Astro.url.pathname.replace(/\/$/, '');

// Generate breadcrumbs for SEO
const seoBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Integrations', url: '/integrations' },
  { name: entry.data.title, url: pathname },
];

// File path for git dates
const filePath = `src/content/integrations/${entry.slug}.md`;
const editUrl = `https://github.com/logtide-dev/logtide.dev/edit/main/${filePath}`;

// Get dates from git
let lastUpdated: string | null = null;
let dateModifiedISO: string | null = null;
let datePublishedISO: string | null = null;

try {
  const cwd = process.cwd();
  const gitDateModified = execSync(`git log -1 --format="%ci" -- "${filePath}"`, { encoding: 'utf-8', cwd }).trim();
  if (gitDateModified) {
    const date = new Date(gitDateModified);
    lastUpdated = date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
    dateModifiedISO = date.toISOString();
  }

  const gitDateCreated = execSync(`git log --follow --format="%ci" --diff-filter=A -- "${filePath}"`, { encoding: 'utf-8', cwd }).trim();
  if (gitDateCreated) {
    const lines = gitDateCreated.split('\n');
    const firstDate = lines[lines.length - 1] || lines[0];
    if (firstDate) {
      datePublishedISO = new Date(firstDate).toISOString();
    }
  }
} catch {
  // Git command failed
}
---

<ContentPage
  title={`${title} | LogTide Integrations`}
  description={description}
  breadcrumbs={seoBreadcrumbs}
  datePublished={datePublishedISO}
  dateModified={dateModifiedISO}
>
  <!-- Navigation breadcrumb -->
  <nav class="mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted-foreground">
      <li>
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
      </li>
      <li class="text-muted-foreground/50">/</li>
      <li>
        <a href="/integrations/" class="hover:text-foreground transition-colors">Integrations</a>
      </li>
      <li class="text-muted-foreground/50">/</li>
      <li class="text-foreground">{title.replace(' Integration', '')}</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <header class="mb-8">
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <CategoryBadge category={entry.data.category} type="integration" />
      <DifficultyBadge difficulty={entry.data.difficulty} />
    </div>

    <h1 class="text-4xl font-bold mb-4 bg-gradient-to-r from-primary to-purple-400 bg-clip-text text-transparent leading-tight">
      {title}
    </h1>

    <p class="text-lg text-muted-foreground">
      {description}
    </p>

    {entry.data.highlights.length > 0 && (
      <div class="flex flex-wrap gap-4 mt-4">
        {entry.data.highlights.map((highlight) => (
          <span class="inline-flex items-center gap-1 text-sm text-muted-foreground">
            <Icon name="lucide:check" class="w-4 h-4 text-green-500" />
            {highlight}
          </span>
        ))}
      </div>
    )}
  </header>

  <!-- MDX Content -->
  <div class="prose-content">
    <Content />
  </div>

  <!-- Related Content -->
  <RelatedContent
    integrations={entry.data.relatedIntegrations}
    useCases={entry.data.relatedUseCases}
  />

  <!-- More from this section -->
  <MoreFromSection
    type="integrations"
    currentSlug={entry.slug}
    currentCategory={entry.data.category}
  />

  <!-- Edit Link -->
  <div class="mt-16 pt-8 border-t border-border">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      {lastUpdated && (
        <span class="text-sm text-muted-foreground">
          Last updated: {lastUpdated}
        </span>
      )}
      <a
        href={editUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors no-underline"
      >
        <Icon name="lucide:pencil" class="w-4 h-4" />
        Edit this page on GitHub
      </a>
    </div>
  </div>
</ContentPage>

<style>
  .prose-content > * + * {
    margin-top: 1.5em;
  }

  .prose-content :global(h2) {
    @apply text-2xl font-semibold mt-12 mb-6 pb-2 border-b border-border scroll-mt-24;
  }

  .prose-content :global(h3) {
    @apply text-xl font-semibold mt-8 mb-4 scroll-mt-24;
  }

  .prose-content :global(h4) {
    @apply text-lg font-semibold mt-6 mb-2;
  }

  .prose-content :global(p) {
    @apply leading-7;
  }

  .prose-content :global(ul) {
    @apply list-disc list-inside space-y-2 mb-4;
  }

  .prose-content :global(ol) {
    @apply list-decimal list-inside space-y-2 mb-4;
  }

  .prose-content :global(li > p) {
    @apply my-0 inline;
  }

  .prose-content :global(a) {
    @apply font-medium text-primary underline underline-offset-4 decoration-primary/20 hover:decoration-primary transition-all cursor-pointer;
  }

  .prose-content :global(blockquote) {
    @apply pl-6 py-1 my-6 border-l-4 border-primary/20 italic text-muted-foreground bg-primary/5 rounded-r-lg;
  }

  .prose-content :global(:not(pre) > code) {
    @apply relative rounded bg-muted px-[0.3rem] py-[0.2rem] font-mono text-sm font-normal text-foreground;
  }

  .prose-content :global(table) {
    @apply w-full text-left border-collapse;
  }

  .prose-content :global(thead) {
    @apply bg-muted/50 text-foreground;
  }

  .prose-content :global(th) {
    @apply p-4 font-semibold border-b border-border;
  }

  .prose-content :global(td) {
    @apply p-4 border-b border-border text-muted-foreground;
  }

  .prose-content :global(tr:last-child td) {
    @apply border-0;
  }

  .prose-content :global(pre) {
    @apply p-4 rounded-lg overflow-x-auto border border-border my-6 font-normal;
  }

  .prose-content :global(pre code) {
    @apply font-normal;
    background-color: transparent !important;
  }
</style>
