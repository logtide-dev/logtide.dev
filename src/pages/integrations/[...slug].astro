---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import DifficultyBadge from '../../components/content/DifficultyBadge.astro';
import CategoryBadge from '../../components/content/CategoryBadge.astro';
import RelatedContent from '../../components/content/RelatedContent.astro';
import MoreFromSection from '../../components/content/MoreFromSection.astro';
import { Icon } from 'astro-icon/components';
import { execSync } from 'child_process';

export async function getStaticPaths() {
  const entries = await getCollection('integrations', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'integrations'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const title = entry.data.title;
const description = entry.data.description;

const rawPathname = Astro.url.pathname;
const pathname = rawPathname.endsWith('/') ? rawPathname : rawPathname + '/';

// Generate breadcrumbs for SEO
const seoBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Integrations', url: '/integrations/' },
  { name: entry.data.title, url: pathname },
];

// File path for git dates
const filePath = `src/content/integrations/${entry.id}.md`;
const editUrl = `https://github.com/logtide-dev/logtide.dev/edit/main/${filePath}`;

// Get dates from git
let lastUpdated: string | null = null;
let dateModifiedISO: string | null = null;
let datePublishedISO: string | null = null;

try {
  const cwd = process.cwd();
  const gitDateModified = execSync(`git log -1 --format="%ci" -- "${filePath}"`, { encoding: 'utf-8', cwd }).trim();
  if (gitDateModified) {
    const date = new Date(gitDateModified);
    lastUpdated = date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
    dateModifiedISO = date.toISOString();
  }

  const gitDateCreated = execSync(`git log --follow --format="%ci" --diff-filter=A -- "${filePath}"`, { encoding: 'utf-8', cwd }).trim();
  if (gitDateCreated) {
    const lines = gitDateCreated.split('\n');
    const firstDate = lines[lines.length - 1] || lines[0];
    if (firstDate) {
      datePublishedISO = new Date(firstDate).toISOString();
    }
  }
} catch {
  // Git command failed
}
---

<ContentPage
  title={`${title} | LogTide Integrations`}
  description={description}
  ogImage="https://logtide.dev/images/integrations.png"
  breadcrumbs={seoBreadcrumbs}
  datePublished={datePublishedISO}
  dateModified={dateModifiedISO}
  faqs={entry.data.faqs}
>
  <!-- Navigation breadcrumb -->
  <nav class="mb-8" aria-label="Breadcrumb">
    <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 font-mono text-xs text-muted-foreground">
      <li>
        <a href="/" class="transition-colors hover:text-foreground">Home</a>
      </li>
      <li class="text-muted-foreground/50">/</li>
      <li>
        <a href="/integrations/" class="transition-colors hover:text-foreground">Integrations</a>
      </li>
      <li class="text-muted-foreground/50">/</li>
      <li class="text-foreground">{title.replace(' Integration', '')}</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <header class="mb-10">
    <p class="font-mono text-xs text-primary-readable">integration</p>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <CategoryBadge category={entry.data.category} type="integration" />
      <DifficultyBadge difficulty={entry.data.difficulty} />
    </div>

    <h1 class="mt-5">
      {title}
    </h1>

    <p class="text-lg text-muted-foreground">
      {description}
    </p>

    {entry.data.highlights.length > 0 && (
      <ul class="m-0 mt-5 flex list-none flex-wrap gap-x-5 gap-y-1.5 p-0">
        {entry.data.highlights.map((highlight) => (
          <li class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
            <Icon name="lucide:check" class="h-3.5 w-3.5 text-success-text" aria-hidden="true" />
            {highlight}
          </li>
        ))}
      </ul>
    )}
  </header>

  <!-- MDX Content -->
  <div class="prose-content">
    <Content />
  </div>

  <!-- Related Content -->
  <RelatedContent
    integrations={entry.data.relatedIntegrations}
    useCases={entry.data.relatedUseCases}
  />

  <!-- More from this section -->
  <MoreFromSection
    type="integrations"
    currentSlug={entry.id}
    currentCategory={entry.data.category}
  />

  <!-- Edit Link -->
  <div class="mt-16 border-t border-foreground/[0.08] pt-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      {lastUpdated && (
        <span class="font-mono text-xs text-muted-foreground">
          Last updated: {lastUpdated}
        </span>
      )}
      <a
        href={editUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
      >
        <Icon name="lucide:pencil" class="w-4 h-4" />
        Edit this page on GitHub
      </a>
    </div>
  </div>
</ContentPage>
