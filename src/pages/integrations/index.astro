---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardDescription from '../../components/ui/CardDescription.astro';
import CardContent from '../../components/ui/CardContent.astro';
import DifficultyBadge from '../../components/content/DifficultyBadge.astro';
import ArrowRight from '../../components/ui/ArrowRight.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

// Get all published integrations
const allIntegrations = await getCollection('integrations', ({ data }) => !data.draft);

// Group by category
const categories = {
  'web-server': { label: 'Web Servers', icon: 'lucide:server', items: [] as typeof allIntegrations },
  'database': { label: 'Databases', icon: 'lucide:database', items: [] as typeof allIntegrations },
  'framework': { label: 'Frameworks', icon: 'lucide:layers', items: [] as typeof allIntegrations },
  'container': { label: 'Containers & Orchestration', icon: 'lucide:box', items: [] as typeof allIntegrations },
  'language': { label: 'Languages & SDKs', icon: 'lucide:code', items: [] as typeof allIntegrations },
  'infrastructure': { label: 'Infrastructure', icon: 'lucide:cloud', items: [] as typeof allIntegrations },
};

// Sort integrations into categories
allIntegrations.forEach((integration) => {
  const cat = categories[integration.data.category];
  if (cat) {
    cat.items.push(integration);
  }
});

// Sort items alphabetically within each category
Object.values(categories).forEach((cat) => {
  cat.items.sort((a, b) => a.data.title.localeCompare(b.data.title));
});

// Filter out empty categories
const populatedCategories = Object.entries(categories).filter(([, cat]) => cat.items.length > 0);

const title = 'Integration Guides | LogTide';
const description = 'Step-by-step guides to integrate LogTide with your infrastructure. Web servers, databases, frameworks, containers, and more.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <SEO
      title={title}
      description={description}
      type="website"
      ogImage="https://logtide.dev/docs/images/sections/guides.png"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        function applyTheme() {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = localStorage.getItem('theme') || (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main class="mx-auto max-w-6xl px-6 py-16">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <h1 class="text-4xl font-bold mb-4 bg-gradient-to-r from-primary to-purple-400 bg-clip-text text-transparent">
          Integration Guides
        </h1>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
          Step-by-step guides to integrate LogTide with your infrastructure.
          Each guide includes complete configuration examples, Docker setup, and troubleshooting tips.
        </p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
        <div class="text-center p-6 rounded-lg bg-card border border-border">
          <div class="text-3xl font-bold text-primary">{allIntegrations.length}</div>
          <div class="text-sm text-muted-foreground">Integrations</div>
        </div>
        <div class="text-center p-6 rounded-lg bg-card border border-border">
          <div class="text-3xl font-bold text-primary">{populatedCategories.length}</div>
          <div class="text-sm text-muted-foreground">Categories</div>
        </div>
        <div class="text-center p-6 rounded-lg bg-card border border-border">
          <div class="text-3xl font-bold text-green-500">Free</div>
          <div class="text-sm text-muted-foreground">Open Source</div>
        </div>
        <div class="text-center p-6 rounded-lg bg-card border border-border">
          <div class="text-3xl font-bold text-primary">EU</div>
          <div class="text-sm text-muted-foreground">Data Residency</div>
        </div>
      </div>

      <!-- Categories -->
      {populatedCategories.map(([key, category]) => (
        <section class="mb-12">
          <h2
            id={key}
            class="text-2xl font-semibold mb-6 flex items-center gap-3"
          >
            <div class="p-2 rounded-lg bg-primary/10">
              <Icon name={category.icon} class="w-6 h-6 text-primary" />
            </div>
            {category.label}
          </h2>

          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {category.items.map((integration) => (
              <a href={`/integrations/${integration.id}`} class="block group">
                <Card class="h-full transition-all hover:border-primary/50 hover:shadow-lg">
                  <CardHeader class="pb-2">
                    <div class="flex items-center justify-between mb-2">
                      {integration.data.brandIcon && (
                        <Icon name={integration.data.brandIcon} class="w-8 h-8 text-muted-foreground group-hover:text-primary transition-colors" />
                      )}
                      <DifficultyBadge difficulty={integration.data.difficulty} showIcon={false} />
                    </div>
                    <CardTitle class="text-lg group-hover:text-primary transition-colors flex items-center gap-2">
                      {integration.data.title.replace(' Integration', '')}
                      <ArrowRight class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" />
                    </CardTitle>
                    <CardDescription class="line-clamp-2">{integration.data.description}</CardDescription>
                  </CardHeader>
                  {integration.data.highlights.length > 0 && (
                    <CardContent class="pt-0">
                      <div class="flex flex-wrap gap-2">
                        {integration.data.highlights.slice(0, 2).map((highlight) => (
                          <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
                            <Icon name="lucide:check" class="w-3 h-3 text-green-500" />
                            {highlight}
                          </span>
                        ))}
                      </div>
                    </CardContent>
                  )}
                </Card>
              </a>
            ))}
          </div>
        </section>
      ))}

      {populatedCategories.length === 0 && (
        <Card class="text-center py-16">
          <CardContent>
            <Icon name="lucide:package-open" class="w-16 h-16 mx-auto text-muted-foreground mb-6" />
            <h2 class="text-xl font-semibold mb-2">Integration guides coming soon</h2>
            <p class="text-muted-foreground mb-6">
              We're working on adding integration guides. Check back later or
            </p>
            <a
              href="https://github.com/logtide-dev/logtide"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors"
            >
              <Icon name="simple-icons:github" class="w-4 h-4" />
              Contribute on GitHub
            </a>
          </CardContent>
        </Card>
      )}

      <!-- CTA -->
      <div class="mt-16 text-center p-8 rounded-2xl bg-gradient-to-r from-primary/10 to-purple-500/10 border border-primary/20">
        <h2 class="text-2xl font-semibold mb-4">Can't find what you need?</h2>
        <p class="text-muted-foreground mb-6 max-w-xl mx-auto">
          We're always adding new integrations. Let us know what you need and we'll prioritize it.
        </p>
        <a
          href="https://github.com/logtide-dev/logtide/issues"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors font-medium"
        >
          Request an Integration
          <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  @import '../../styles/tailwind.css';
  @import '../../styles/custom.css';

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
  }

  .header-container,
  .footer-container {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
</style>
