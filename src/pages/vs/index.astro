---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

// Get all published comparisons
const allComparisons = await getCollection('comparisons', ({ data }) => !data.draft);

// Sort alphabetically by competitor name
allComparisons.sort((a, b) => a.data.competitor.localeCompare(b.data.competitor));

const title = 'LogTide vs Competitors | LogTide';
const description = 'Honest feature, cost, and architecture comparisons between LogTide and popular log management platforms like Datadog, Splunk, ELK, Grafana Loki, and SigNoz.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <SEO
      title={title}
      description={description}
      type="website"
      ogImage="https://logtide.dev/images/comparisons.png"
      keywords={["log management comparison", "Datadog alternative", "Splunk alternative", "ELK stack vs LogTide", "Grafana Loki vs LogTide", "New Relic alternative", "open source SIEM comparison"]}
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        function applyTheme() {
          // Dark by default; the header toggle and the footer picker store
          // 'dark', 'light' or 'system' (follow the OS).
          const stored = localStorage.getItem('theme') || 'dark';
          const theme = stored === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : stored;
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />

    <main>
      <section class="relative" aria-labelledby="vs-heading">
        <div class="pointer-events-none absolute inset-x-0 -top-16 hidden h-[640px] bg-[radial-gradient(45%_50%_at_25%_0%,hsl(var(--primary)/0.2),transparent_70%)] dark:block" aria-hidden="true"></div>
        <div class="dot-grid pointer-events-none absolute inset-x-0 -top-16 h-[520px]" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-[77.5rem] px-4 pt-16 sm:px-6 md:pt-28 lg:px-10">
          <p class="font-mono text-xs text-primary-readable">compare</p>
          <h1 id="vs-heading" class="mt-4 text-[clamp(2.75rem,1.6rem+4.4vw,5.25rem)] font-bold leading-[0.95] tracking-[-0.032em]">
            LogTide vs Competitors
          </h1>
          <p class="mt-6 max-w-[58ch] text-lg text-muted-foreground">
            Honest comparisons between LogTide and popular log management platforms.
            We compare features, pricing, architecture, and migration paths.
          </p>
        </div>
      </section>

      <div class="mx-auto max-w-[77.5rem] px-4 pb-24 sm:px-6 md:pb-36 lg:px-10">
        <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid sm:grid-cols-3">
          <div class="bg-background p-6">
            <Icon name="lucide:dollar-sign" class="h-6 w-6 text-primary-readable" aria-hidden="true" />
            <h3 class="mt-4 font-semibold">Zero Per-GB Fees</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">
              Self-hosted with no ingestion costs. Pay only for your infrastructure, not per gigabyte.
            </p>
          </div>
          <div class="bg-background p-6">
            <Icon name="lucide:shield-check" class="h-6 w-6 text-primary-readable" aria-hidden="true" />
            <h3 class="mt-4 font-semibold">Built-in SIEM</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">
              Sigma detection rules, MITRE ATT&CK mapping, and incident management included at no extra cost.
            </p>
          </div>
          <div class="bg-background p-6">
            <Icon name="lucide:lock" class="h-6 w-6 text-primary-readable" aria-hidden="true" />
            <h3 class="mt-4 font-semibold">Full Data Ownership</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">
              Your logs never leave your infrastructure. Complete GDPR compliance with EU data sovereignty.
            </p>
          </div>
        </div>

        <section class="pt-20 md:pt-28" aria-labelledby="comparisons-heading">
          <div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h2 id="comparisons-heading" class="text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] font-bold leading-[1.05] tracking-[-0.03em]">Comparisons</h2>
            <p class="font-mono text-xs text-muted-foreground">{allComparisons.length} {allComparisons.length === 1 ? 'comparison' : 'comparisons'}</p>
          </div>

          <div class="grid gap-px overflow-hidden rounded-2xl border border-foreground/[0.08] cell-grid md:grid-cols-2">
            {allComparisons.map((comparison) => (
              <div class="flex flex-col bg-background transition-colors hover:bg-card">
                <a href={`/vs/${comparison.id}/`} class="group flex flex-1 flex-col p-6">
                  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                    <span class="font-mono text-xs text-primary-readable">
                      LogTide vs {comparison.data.competitor}
                    </span>
                    <span class="font-mono text-xs text-muted-foreground">
                      {comparison.data.competitorPricing}
                    </span>
                  </div>
                  <h3 class="mt-4 text-lg font-semibold tracking-[-0.015em] group-hover:text-primary-readable">
                    {comparison.data.title}
                  </h3>
                  <p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">{comparison.data.description}</p>
                  {comparison.data.highlights.length > 0 && (
                    <ul class="m-0 mt-4 flex list-none flex-wrap gap-x-4 gap-y-1 p-0">
                      {comparison.data.highlights.slice(0, 3).map((highlight) => (
                        <li class="font-mono text-xs text-muted-foreground">{highlight}</li>
                      ))}
                    </ul>
                  )}
                </a>
                {comparison.data.migrationDoc && (
                  <a
                    href={comparison.data.migrationDoc}
                    class="inline-flex items-center gap-1.5 px-6 pb-6 text-sm font-medium text-primary-readable hover:underline"
                  >
                    Migration guide: {comparison.data.competitor} to LogTide →
                  </a>
                )}
              </div>
            ))}
          </div>
        </section>

        {allComparisons.length === 0 && (
          <div class="mt-20 rounded-2xl border border-foreground/15 px-6 py-16 text-center">
            <Icon name="lucide:scale" class="mx-auto mb-6 h-12 w-12 text-muted-foreground" aria-hidden="true" />
            <h2 class="text-2xl font-bold tracking-[-0.025em]">Comparison guides coming soon</h2>
            <p class="mx-auto mt-3 max-w-[58ch] text-muted-foreground">
              We're working on adding detailed comparison guides. Check back later, or help write one.
            </p>
            <a
              href="https://github.com/logtide-dev/logtide"
              target="_blank"
              rel="noopener"
              class="btn-primary mt-6 inline-flex h-12 items-center gap-2 rounded-[10px] bg-primary px-5 font-medium text-primary-foreground"
            >
              <Icon name="simple-icons:github" class="h-4 w-4" aria-hidden="true" />
              Contribute on GitHub
            </a>
          </div>
        )}

        <section class="mt-20 flex flex-wrap items-center justify-between gap-x-12 gap-y-6 rounded-2xl border border-foreground/15 bg-card p-8 md:mt-28 md:p-10">
          <div class="flex-[1_1_24rem]">
            <h2 class="text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-bold leading-[1.1] tracking-[-0.025em]">Ready to switch?</h2>
            <p class="mt-3 max-w-[58ch] text-muted-foreground">
              LogTide is free, open-source, and self-hosted. Deploy in minutes and start saving on log management costs.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://github.com/logtide-dev/logtide"
              target="_blank"
              rel="noopener"
              class="btn-primary inline-flex h-12 items-center gap-2 rounded-[10px] bg-primary px-5 font-medium text-primary-foreground"
            >
              <Icon name="simple-icons:github" class="h-4 w-4" aria-hidden="true" />
              Deploy LogTide
            </a>
            <a
              href="https://github.com/logtide-dev/logtide/discussions"
              target="_blank"
              rel="noopener"
              class="btn-ghost inline-flex h-12 items-center gap-2 rounded-[10px] border border-foreground/15 px-5 font-medium"
            >
              <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
              Ask a Question
            </a>
          </div>
        </section>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  @import '../../styles/tailwind.css';
  @import '../../styles/custom.css';



</style>
