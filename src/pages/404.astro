---
import Layout from '../layouts/Landing.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found - LogTide"
  description="The page you're looking for doesn't exist or has been moved."
>
  <Header />
  <main aria-label="Error page" class="relative">
    <div class="pointer-events-none absolute inset-x-0 top-0 hidden h-[560px] bg-[radial-gradient(45%_50%_at_25%_0%,hsl(var(--primary)/0.2),transparent_70%)] dark:block" aria-hidden="true"></div>
    <div class="dot-grid pointer-events-none absolute inset-x-0 top-0 h-[460px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[77.5rem] px-4 pb-24 pt-16 sm:px-6 md:pb-36 md:pt-28 lg:px-10">
      <p class="font-mono text-[clamp(5rem,3rem+10vw,11rem)] font-bold leading-[0.9] tracking-[-0.04em] text-primary-readable" aria-hidden="true">404</p>
      <h1 class="mt-6 text-[clamp(2.25rem,1.4rem+3vw,3.75rem)] font-bold leading-[0.95] tracking-[-0.032em]">
        Page not found
      </h1>
      <p class="mt-5 max-w-[58ch] text-lg text-muted-foreground">
        Sorry, the page you're looking for doesn't exist or has been moved.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn-primary inline-flex h-12 items-center rounded-[10px] bg-primary px-5 font-medium text-primary-foreground">
          Go to Homepage
        </a>
        <a href="/docs/" class="btn-ghost inline-flex h-12 items-center rounded-[10px] border border-foreground/15 px-5 font-medium">
          View Documentation
        </a>
      </div>

      <div class="mt-16 border-t border-foreground/[0.08] pt-8">
        <p class="font-mono text-xs text-muted-foreground">
          Looking for something specific? Try these:
        </p>
        <nav aria-label="Quick links" class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
          <a href="/docs/getting-started/" class="text-sm font-medium text-primary-readable hover:underline">
            Getting Started →
          </a>
          <a href="/integrations/" class="text-sm font-medium text-primary-readable hover:underline">
            Integrations →
          </a>
          <a href="/use-cases/" class="text-sm font-medium text-primary-readable hover:underline">
            Use Cases →
          </a>
          <a href="/docs/api/" class="text-sm font-medium text-primary-readable hover:underline">
            API Reference →
          </a>
          <a href="/blog/" class="text-sm font-medium text-primary-readable hover:underline">
            Blog →
          </a>
        </nav>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
